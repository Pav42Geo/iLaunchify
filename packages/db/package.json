{
  "name": "@ilaunchify/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "// Note": "All commands load env from .env.local at the repo root via dotenv-cli — Next.js uses the same file.",
    "generate": "pnpm exec dotenv -e ../../.env.local -- prisma generate",
    "push": "pnpm exec dotenv -e ../../.env.local -- prisma db push",
    "migrate": "pnpm exec dotenv -e ../../.env.local -- prisma migrate dev",
    "migrate:deploy": "pnpm exec dotenv -e ../../.env.local -- prisma migrate deploy",
    "migrate:status": "pnpm exec dotenv -e ../../.env.local -- prisma migrate status",
    "studio": "pnpm exec dotenv -e ../../.env.local -- prisma studio",
    "seed": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed.ts",
    "seed:flavor-delta": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-flavor-delta-fixture.ts",
    "report:flavor-delta": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/flavor-delta-report.ts",
    "backfill:facilities": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/backfill-facilities.ts",
    "backfill:dieline-svg": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/backfill-dieline-normalized-svg.ts",
    "backfill:price-curves": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/backfill-offering-price-curves.ts",
    "seed:sample-orders": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-sample-orders.ts",
    "seed:subscription-plans": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-subscription-plans.ts",
    "seed:domain-ingredients": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-domain-ingredients.ts",
    "seed:domain-settings": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-domain-settings.ts",
    "seed:template-styles": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-template-styles.ts",
    "seed:template-library": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-template-library.ts",
    "seed:dsld-mirror": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-dsld-mirror.ts",
    "seed:variety-demo": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-variety-demo.ts",
    "seed:demo-reviews": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-demo-reviews.ts",
    "seed:packing-types": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/run-packing-types.ts",
    "seed:packaging-forms": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-packaging-forms.ts",
    "seed:logistics": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-logistics.ts",
    "seed:risk": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-risk-settings.ts",
    "seed:ai-vocab-groups": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-ai-vocab-groups.ts",
    "backfill:flavor-recipes": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/backfill-flavor-recipes.ts",
    "backfill:flavor-recipes:apply": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/backfill-flavor-recipes.ts --apply",
    "format": "prisma format",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo dist",
    "seed:fc-dryrun": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-fc-dryrun.ts",
    "seed:favorites": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-favorites.ts",
    "seed:onboarding-demo": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-onboarding-demo.ts",
    "seed:activation-demo": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-activation-demo.ts",
    "seed:activation-nudge-demo": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-activation-nudge-demo.ts",
    "seed:partner-agreement": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-partner-agreement.ts",
    "seed:certificate-types": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/run-certificate-types.ts",
    "seed:cocreation-demo": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-cocreation-demo.ts",
    "seed:legal": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed-legal.ts"
  },
  "prisma": {
    "seed": "pnpm exec dotenv -e ../../.env.local -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@ilaunchify/storage": "workspace:*",
    "dotenv-cli": "^7.4.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
