// =============================================================================
// MARKETS & PLATFORM CONFIG
// =============================================================================

model Market {
  id                String       @id @default(cuid())
  code              String       @unique // 'US' (V1 only); 'EU', 'CA', 'AU', 'UK' (V2+)
  name              String // 'United States — FDA'
  jurisdictionAct   String // 'FDA', 'EFSA', etc. (regulator)
  currency          String       @default("USD")
  // V1 additions per docs/MARKETS_AND_REGIONS.md
  region            String? // display grouping: 'North America', 'EU', 'UK'
  status            MarketStatus @default(ACTIVE)
  defaultLanguageId String?
  // Policy JSON — validated by the rule pack; shape per market regulator:
  typography        Json? // { minFontSizePt, requiredFonts[], boldRules }
  allergenPolicy    Json? // { allergenList[], declarationFormat, ... }
  barcodeRules      Json? // { allowedSymbologies[], placementRules }
  // Legacy isActive kept for backward compat; new code reads `status` instead.
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Existing relations
  rulePacks       RulePack[]
  products        Product[]
  // V1 new relations
  defaultLanguage Language?           @relation("DefaultLanguage", fields: [defaultLanguageId], references: [id])
  languages       MarketLanguage[]
  regions         Region[]
  configs         MarketConfig[]
  partnersServing PartnerMarketCert[]
  brandsTargeting BrandTargetMarket[]
}

// PlatformFeeConfig — historical revisions; never edit, only insert new rows
model PlatformFeeConfig {
  id            String   @id @default(cuid())
  baseRateBp    Int // 1500 = 15%
  floorCents    Int      @default(100)
  effectiveFrom DateTime
  notes         String?
  createdAt     DateTime @default(now())
}

// =============================================================================
// USER & AUTH (Auth.js v5 compatible)
// =============================================================================

model User {
  id                           String                       @id @default(cuid())
  email                        String                       @unique
  emailVerified                DateTime?
  name                         String?
  image                        String?
  role                         UserRole
  // Admin RBAC sub-role (docs/ADMIN_RBAC.md). Null = treated as SUPER_ADMIN for
  // P0 (zero behavior change); existing admins backfilled to SUPER_ADMIN.
  adminRole                    AdminRole?
  // Stripe Connect (used for partner payouts — partners only)
  stripeAccountId              String?                      @unique
  stripeAccountStatus          StripeAccountStatus          @default(NONE)
  // Phase G6 — Stripe Customer for billing recurring production-run
  // subscriptions (creators only). Resolved on-demand by
  // createProductionSubscription() and cached here for reuse on
  // subsequent subscribe-and-save flows.
  stripeCustomerId             String?                      @unique
  // Auth.js v5 standard
  accounts                     Account[]
  sessions                     Session[]
  // Role-specific profile
  creatorProfile               CreatorProfile?
  partner                      Partner?
  // Activity
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  // Notification preferences — single quiet-hours window per user (any event
  // not delivered by email during this window is held until the window closes).
  // Stored as minutes-since-UTC-midnight so we don't fight timezones. Both
  // null = no quiet hours (deliver any time).
  quietHoursStartUtc           Int? // 0..1439, e.g. 22*60 for 10pm UTC
  quietHoursEndUtc             Int? // 0..1439, e.g. 7*60 for 7am UTC
  // Outbound relations
  initiatedRefunds             Refund[]
  transferDestinations         Transfer[]                   @relation("TransferDestinationUser")
  complianceChecks             ComplianceCheck[]
  auditLogs                    AuditLog[]                   @relation("AuditLogActor")
  verifiedSections             PartnerVerificationSection[] @relation("VerificationSectionVerifier")
  uploadedFiles                PartnerFile[]                @relation("PartnerFileUploader")
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  creatorOrders                Order[]                      @relation("CreatorOrders")
  cancellationRequestsMade     CancellationRequest[]        @relation("CancellationRequester")
  cancellationRequestsReviewed CancellationRequest[]        @relation("CancellationReviewer")
  disputesOpened               OrderDispute[]               @relation("DisputeOpener")
  disputesReviewed             OrderDispute[]               @relation("DisputeReviewer")
  channelConnections           ChannelConnection[]          @relation("CreatorChannelConnections")
  // Phase G1 — in-progress checkout wizard drafts
  creatorCheckoutDrafts        CheckoutDraft[]              @relation("CreatorCheckoutDrafts")
  // Phase G4 — addresses creators reuse across orders. Keyed off User
  // (not CreatorProfile) so partner users can have shipping addresses
  // for sample requests later without a schema change.
  creatorSavedAddresses        CreatorSavedAddress[]        @relation("CreatorSavedAddresses")
  // Phase G6 — Subscribe & save recurring production runs.
  productionSubscriptions      ProductionSubscription[]     @relation("CreatorProductionSubscriptions")
  // Support ticketing system (2026-06-01) — see docs/SUPPORT_TICKETING_PLAN.md
  requestedTickets             Ticket[]                     @relation("RequesterTickets")
  assignedTickets              Ticket[]                     @relation("AssigneeTickets")
  ticketReplies                TicketReply[]                @relation("TicketReplyAuthor")
  ticketEvents                 TicketEvent[]                @relation("TicketEventActor")
  // Admin team invites (docs/ADMIN_RBAC.md) — invite a NEW person to the admin
  // team; they sign up themselves (we never create accounts / set passwords).
  adminInvitesSent             AdminInvite[]                @relation("AdminInvitesSentBy")
  adminInvitesAccepted         AdminInvite[]                @relation("AdminInvitesAcceptedBy")
  // Billing & Accounting (docs/BILLING_AND_ACCOUNTING.md) — invoice/tax contact
  // details. Plain business data only; no card/bank/SSN ever lives here (Stripe
  // holds all payment instruments + TINs).
  billingProfile               BillingProfile?
  // Display-only mirror of the Stripe PaymentMethods on this user's Customer.
  // Holds brand + last4 + expiry only — NEVER a full card number (Stripe-hosted
  // Checkout in setup mode collects the card; the PAN never reaches us).
  paymentMethods               PaymentMethodRef[]
  // Pointers to 1099 tax forms issued via Stripe Connect Tax Forms (partners).
  // We store year/type/status + the Stripe form id only — never the TIN or the
  // form contents (Stripe holds those; the partner views them in Stripe Express).
  taxDocuments                 TaxDocument[]
}

// Auth.js v5 — Account (OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Auth.js v5 — Session (database session strategy)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth.js v5 — VerificationToken (email magic links)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// CREATOR PROFILE
// =============================================================================

model CreatorProfile {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  handle                   String           @unique // public URL slug (also Brand.handle fallback)
  displayName              String
  bio                      String?
  audienceSizeBand         String? // "10K-100K", "100K-1M", "1M+"
  // V1: 5-step onboarding stepper progress per docs/CREATOR_ONBOARDING.md.
  // Shape: { welcomeSeen, currentStep, completedSteps[], declaredTargetMarketIds[],
  //         step1CompletedAt, step2CompletedAt, ... } — mirrors the Partner pattern.
  // Cleared (or kept frozen) once all 5 steps are complete.
  onboardingProgress       Json?
  // R14.b — subscription tier drives feature gates across Studio (Export
  // PDF), Checkout (Subscribe & save), and Order detail (Get product
  // support). Defaults to MAKER so existing creators stay on the free
  // tier; flips up via Stripe Subscription webhooks once V1.1 lands.
  subscriptionTier         SubscriptionTier @default(MAKER)
  // R15.a — change tracking for the admin Tier Management module.
  // Whose hand last touched the tier + when. Null on creation so we
  // know "always been MAKER" vs "promoted on YYYY-MM-DD by admin X".
  tierChangedAt            DateTime?
  tierChangedById          String?
  // V1.5-T1 — Stripe-managed tier subscription handles. Populated when
  // a creator self-upgrades via /settings/plan and read/written from
  // the webhook (customer.subscription.created / .updated / .deleted).
  // Null for MAKER (no Stripe sub) and for admin-promoted Builder/Agency
  // creators (admin courtesy upgrades — no Stripe sub on file).
  //   stripeTierSubscriptionId — Stripe Subscription handle (sub_…),
  //                               @unique so the webhook can look up
  //                               the creator profile in O(1)
  //   tierCurrentPeriodEnd     — when the current paid period ends;
  //                               used by /settings/plan to render
  //                               "Renews / Cancels on YYYY-MM-DD"
  //   tierCancelAtPeriodEnd    — creator clicked Cancel; subscription
  //                               stays active until tierCurrentPeriodEnd,
  //                               then webhook flips them back to MAKER
  stripeTierSubscriptionId String?          @unique
  tierCurrentPeriodEnd     DateTime?
  tierCancelAtPeriodEnd    Boolean          @default(false)
  // V1 dunning (payment-failed → grace → downgrade). Set on the tier
  // subscription's invoice.payment_failed; cleared on recovery; the grace-expiry
  // cron downgrades to MAKER if still unpaid past tierGraceUntil.
  tierPaymentFailedAt      DateTime?
  tierGraceUntil           DateTime?
  // Fee overrides
  feeRateOverrideBp        Int?
  feeRateOverrideReason    String?
  // Returns window
  returnsWindowDays        Int              @default(14)
  // Relations
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brands                   Brand[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
}

// R14.b — three creator subscription tiers. Ordered low → high so we can
// derive rank in TypeScript without a lookup map. New tiers must be
// appended at the bottom to preserve rank ordering.
enum SubscriptionTier {
  MAKER
  BUILDER
  AGENCY
}

// R15.a — three partner subscription tiers per PLATFORM_SPEC §Tier 1
// "Production partner tiers". Naming locked. Ordered low → high so the
// same rank-comparison pattern (hasTier()) works for partner gates.
// Applies to every PartnerService.type (MANUFACTURING / LABEL_PRINTING /
// COPACKING / WAREHOUSE / ACCESSORY) — the ladder is uniform; the
// per-type promotion criteria differ and are encoded outside the enum.
enum PartnerTier {
  VERIFIED
  TRUSTED
  PREMIER
}

// R15.a — admin-editable subscription plan rows. Source-of-truth for
// every numeric value the platform used to hardcode (price, fee %,
// feature limits). One row per (audience, tier) combo: 3 creator plans
// + 3 partner plans in V1. Code field is the stable string identifier
// callers reference (e.g. lookupPlanFeature('creator_maker', 'max_brands')).
//
// Per Pavel 2026-05-30: tier remains the canonical column on profile
// rows; this table describes what each tier means. No FK from profile
// → plan — the (audience, tier) key is enough.
model SubscriptionPlan {
  id                String        @id @default(cuid())
  code              String        @unique // "creator_maker", "partner_verified", etc.
  audience          PlanAudience
  // Display tier name (matches the enum value but lowercased for UI).
  tierName          String
  // Rank within audience for sort order. 0 = lowest, 2 = highest.
  tierOrder         Int
  // Public-facing pricing. 0 for free tiers (Maker, Verified).
  monthlyPriceCents Int           @default(0)
  annualPriceCents  Int           @default(0)
  active            Boolean       @default(true)
  description       String?
  // Relations
  features          PlanFeature[]
  feeRules          FeeRule[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([audience, tierOrder])
}

// R15.a — flexible per-plan feature row. intValue / boolValue /
// stringValue is a tagged-union pattern — exactly one is populated
// based on the feature's nature. Callers know the right type at the
// code-constant level. Null intValue + boolValue + stringValue means
// "unlimited" / "no cap" for limit-style features.
model PlanFeature {
  id          String           @id @default(cuid())
  planId      String
  // Stable identifier referenced at the call site (e.g. 'max_brands',
  // 'subscribe_and_save', 'support_sla_hours'). Owned by the module
  // that ships the gate.
  code        String
  intValue    Int?
  stringValue String?
  boolValue   Boolean?
  // Human-readable label / description shown in the admin editor.
  label       String
  description String?
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, code])
  @@index([code])
}

// R15.a — pluggable fee-rate row. Keyed by (planId, triggerEvent) so a
// future "warehouse_referral" or "sample_order" event can hang its own
// rate off a plan without a schema change. Null planId = global default
// fallback. Either ratePercent or flatCents is set; both null = no fee
// (used to express "Premier gets zero platform fee on sample orders").
model FeeRule {
  id           String            @id @default(cuid())
  planId       String?
  triggerEvent String // "production_order_subtotal", "sample_order", "warehouse_referral"
  ratePercent  Decimal?          @db.Decimal(5, 2) // 15.00 = 15%
  flatCents    Int?
  minCents     Int? // Floor (e.g. $1 minimum platform fee per order)
  maxCents     Int? // Cap (rare, but supports "$500 max fee per order")
  active       Boolean           @default(true)
  notes        String?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([planId, triggerEvent])
  @@index([triggerEvent])
}

// R15.a — which side of the marketplace a SubscriptionPlan applies to.
// Drives the audience tab in the admin Plans editor and keeps creator
// vs partner feature codes from colliding.
enum PlanAudience {
  CREATOR
  PARTNER
}

// =============================================================================
// PARTNER & PARTNER SERVICE
// =============================================================================

model Partner {
  id                      String                        @id @default(cuid())
  userId                  String                        @unique
  companyName             String
  legalName               String
  status                  PartnerStatus                 @default(DRAFT)
  // Lead capture metadata
  leadSource              String?
  leadNotes               String?
  // Documents at the company level
  websiteUrl              String?
  contactPhone            String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String                        @default("US")
  // Onboarding wizard progress — tracks which steps a partner has completed,
  // so the wizard can resume after partial completion and "Edit section" deep-links
  // from My Application can jump to the right step. Shape:
  //   { currentStep: "documents", completedSteps: ["company", "service"], updatedAt: "..." }
  // Cleared on first ACTIVE transition.
  onboardingProgress      Json?
  // V1: geographic + market scoping per docs/MARKETS_AND_REGIONS.md
  primaryRegionId         String? // FK to Region (state-level); nullable until partner provides
  // V1: FSM transition tracking per docs/PARTNER_ONBOARDING.md §3
  statusChangedAt         DateTime?
  statusChangedById       String? // User who triggered the last status change (null for SYSTEM)
  statusChangeReason      String?
  // R15.a — Production-partner subscription tier (Verified → Trusted →
  // Premier per PLATFORM_SPEC §Tier 1). Default VERIFIED but only
  // meaningful once `status` flips to ACTIVE — every gate at the call
  // site should also check status. Promotion is admin-manual in V1
  // (audit-logged via AuditLog); cron-driven auto-promotion lands V1.1.
  tier                    PartnerTier                   @default(VERIFIED)
  tierChangedAt           DateTime?
  tierChangedById         String? // Admin who last changed the tier (null for SYSTEM auto-promote in V1.1+)
  // R15.a — Per-partner commission-rate override (basis points). Mirrors
  // CreatorProfile.feeRateOverrideBp. When non-null, the platform fee
  // pipeline uses this instead of the plan-level FeeRule for this
  // partner's orders. Reason is required at the admin UI so the audit
  // trail records why a partner got special treatment.
  feeRateOverrideBp       Int?
  feeRateOverrideReason   String?
  // Relations
  user                    User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  services                PartnerService[]
  clawbacks               PartnerClawback[]
  strikes                 PartnerStrike[]
  verificationSections    PartnerVerificationSection[]
  files                   PartnerFile[]
  // V1 new relations (markets/regions)
  primaryRegion           Region?                       @relation("PartnerPrimaryRegion", fields: [primaryRegionId], references: [id])
  marketsCert             PartnerMarketCert[]
  // V1 new relations (5-layer onboarding — 1:1 each, populated as the partner advances)
  operationalCapability   PartnerOperationalCapability?
  operationalStandards    PartnerOperationalStandards?
  commercialTerms         PartnerCommercialTerms?
  integrationCapability   PartnerIntegrationCapability?
  onboardingState         PartnerOnboardingProgress?
  // V1 new relations (ingredient sourcing)
  privateIngredients      Ingredient[]                  @relation("PartnerPrivateIngredients")
  // V1 new relations (manufacturer product builder — packaging + certificates)
  packagingSystems        PackagingSystem[]
  certificateInstances    PartnerCertificateInstance[]
  certificateTypeRequests CertificateTypeRequest[]      @relation("PartnerCertTypeRequests") // C1
  documents               PartnerDocument[]             @relation("PartnerDocuments") // C6
  facilities              PartnerFacility[]             @relation("PartnerFacilities")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
}

// Manufacturing plant / facility (turnkey builder, 2026-06-08). The facility's
// name + address become the FDA "Manufactured by … / Distributed by …" line on
// the label. When a partner has only one, it's auto-used; multi-plant partners
// pick per variant. Defaults seeded from the onboarding address.
model PartnerFacility {
  id           String   @id @default(uuid())
  partnerId    String
  name         String // "Plant A — Austin"
  addressLine1 String
  addressLine2 String?
  city         String
  region       String // state / province
  postalCode   String
  country      String   @default("US")
  isDefault    Boolean  @default(false)
  partner      Partner  @relation("PartnerFacilities", fields: [partnerId], references: [id], onDelete: Cascade)
  variants     ProductTemplateVariant[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([partnerId, isDefault])
}

// Top-level product shape, drives the Basics dynamic Product-Type/Variants card.
enum ProductType {
  SINGLE // one flavor, one pack
  MULTI_FLAVOR // one marketplace product, N flavor presets
  MULTI_PACK // variety / multipack composition
}

// Admin-curated packing taxonomy (2026-06-08). The structural keystone of the
// turnkey builder: each row's flags drive the recipe module (one recipe vs base
// + flavor presets), the label (column count), and pack composition / die-lines.
// Seeded with the 14 groups; admin manages via /admin/packing-types.
// Admin-curated packing taxonomy catalog. Reuses the existing `PackingType`
// enum (the 14-group taxonomy) for `group` and the existing `FlavorMode` enum.
// Named PackingProfile to avoid colliding with the PackingType enum.
model PackingProfile {
  id            String            @id @default(uuid())
  slug          String            @unique
  name          String
  group         PackingType
  description   String?
  example       String? // representative example shown in the picker
  flavorMode    FlavorMode        @default(SINGLE) // SINGLE recipe vs MULTI (base + presets)
  packStructure PackStructure     @default(SINGLE)
  labelColumns  Int               @default(1) // 1 / 2 / 3 → dual/triple-column Facts
  // How LABELS work for this packing type (docs/MOCKUP_STRATEGY.md / per-flavor
  // labels spec). SINGLE = one label for the pack; AGGREGATE = one combined
  // label listing all flavors (multi-column Nutrition Facts, e.g. a variety
  // box/bag); PER_FLAVOR = each flavored unit gets its OWN label/die-line (the
  // creator designs a shared base + per-flavor overrides). Admin-overridable;
  // default SINGLE. Seeded per the 15 PackingType groups.
  labelTopology LabelTopology     @default(SINGLE)
  // CONSOLIDATION (Pavel 2026-06-18, docs/PACKING_TYPE_CONSOLIDATION.md): the 15
  // PackingProfile rows are merchandising PRESETS; the engine branches on the 6
  // `structuralType` buckets (recipe / label / die-line behavior). Nullable +
  // seeded; Code migrates the builder/variant reads to structuralType.
  structuralType StructuralPackType?
  // Merchandising framing of a preset ('sampler','gift','seasonal','pairing',
  // 'bulk','retail','refill','subscription'). null = the base structure itself.
  merchandisingTag String?
  isSubscription Boolean          @default(false)
  isCustomizable Boolean          @default(false) // build-your-own pick-N
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  products      ProductTemplate[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([group, isActive, sortOrder])
}

// Label topology per packing type (additive 2026-06-18). Drives whether the
// Design Studio shows one label, one aggregate multi-column label, or a
// per-flavor label per unit. See docs/HANDOFF-TO-CODE-per-flavor-labels.md.
enum LabelTopology {
  SINGLE
  AGGREGATE
  PER_FLAVOR
}

// The 6 STRUCTURAL packing types the engine branches on (recipe / label /
// die-line). The 15 PackingType/PackingProfile rows are merchandising presets
// that map onto these. docs/PACKING_TYPE_CONSOLIDATION.md (Pavel 2026-06-18).
enum StructuralPackType {
  SINGLE_UNIT              // 1 flavor, 1 container (label: SINGLE)
  MULTI_UNIT_SAME          // 1 flavor, N identical units — multipack / bulk (SINGLE)
  MULTI_FLAVOR_MIXED       // many flavors loose in one pack — 1 aggregate label (AGGREGATE)
  MULTI_FLAVOR_COMPARTMENT // many flavors in divided sections — 1 aggregate label (AGGREGATE)
  PER_FLAVOR_IN_OUTER      // N flavored units in an outer — a label per flavor (PER_FLAVOR)
  CUSTOMIZABLE_PICK_N      // buyer/creator picks the mix (PER_FLAVOR)
}

enum PackStructure {
  SINGLE // one pack
  MULTI_SAME // N identical packs bundled
  COMBINED // multiple flavors mixed in one pack
  COMPARTMENT // multiple flavors in separated compartments
  INDIVIDUAL_IN_OUTER // each flavor its own pack, all in one outer
  CUSTOMIZABLE // consumer picks N
  OUTER_WITH_INNERS // outer pack holding distinct inner packs
}

model PartnerService {
  id                               String                            @id @default(cuid())
  partnerId                        String
  type                             ServiceType
  status                           ServiceStatus                     @default(DRAFT)
  // Capability shape varies by type; validated via Zod per-type
  capabilities                     Json
  // Disclosure preference per service (per docs/USER_ROLES.md decision 2026-05-18)
  disclosureLevel                  DisclosureLevel                   @default(ANONYMOUS)
  // Print-provider specifics: which die-cuts this service supports
  dieCutSupport                    PartnerServiceDieCut[]
  // Order routing — dispatches assigned to this service
  dispatches                       OrderDispatch[]
  // When this service is type=WAREHOUSE: production orders that ship to it
  warehouseOrders                  Order[]                           @relation("WarehouseShipToOrders")
  // Catalog — ProductTemplates this manufacturer service offers (V1.1+)
  productTemplates                 ProductTemplate[]
  // V1.5+ Phase F — print finishes this service offers (printer/label-printing
  // services only; hidden on the creator side until ≥1 ACTIVE row exists).
  partnerFinishes                  PartnerFinish[]
  // Slice C8 — packaging offerings (container × decoration × dieline tuples).
  packagingOfferings               PartnerPackagingOffering[]
  // Slice C9 Phase 1 — typed packaging dielines offered by this service.
  dielines                         PackagingDieline[]
  // Phase G3 — typed substrate + packaging-material declarations. Drives
  // the creator-side ProductionStep pickers + marketplace partner
  // matching (#153). Empty arrays mean "uses platform defaults."
  partnerServiceSubstrates         PartnerServiceSubstrate[]
  partnerServicePackagingMaterials PartnerServicePackagingMaterial[]
  // V1 — product-plan additions 2026-06-01. Co-packer assignment back-relation:
  // per-product-template, per-packaging-size pointer set by manufacturer/admin
  // when fill/assembly is sourced through a different partner service.
  coPackerAssignments              ProductTemplatePackaging[]        @relation("CoPackerAssignment")
  // Slice C9 — prepress output preferences (source of truth for export bundles).
  printOutputSpec                  PartnerPrintOutputSpec?
  partner                          Partner                           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt

  @@unique([partnerId, type]) // one service per type per partner
}

model PartnerClawback {
  id          String         @id @default(cuid())
  partnerId   String
  refundId    String?
  disputeId   String?
  amountCents Int
  reason      String
  status      ClawbackStatus @default(PENDING_APPROVAL)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  partner     Partner        @relation(fields: [partnerId], references: [id])
  refund      Refund?        @relation(fields: [refundId], references: [id])
  dispute     Dispute?       @relation(fields: [disputeId], references: [id])
}

// A demerit recorded against a partner for an approved cancellation (the partner
// requested to cancel a dispatch they couldn't fulfill). Behaviour-light in V1 —
// a counted, waivable record; trust/promotion consequences are admin-judged.
// Gated by OrderSettings.partnerStrikeOnCancel.
model PartnerStrike {
  id                    String              @id @default(cuid())
  partnerId             String
  // Provenance — what produced the strike.
  cancellationRequestId String?
  orderId               String?
  dispatchId            String?
  reason                String
  // Lifecycle — admin can waive; an expiry sweep can age strikes out later.
  status                PartnerStrikeStatus @default(ACTIVE)
  notes                 String?
  createdAt             DateTime            @default(now())
  waivedAt              DateTime?
  waivedById            String?
  partner               Partner             @relation(fields: [partnerId], references: [id])

  @@index([partnerId, status])
}

enum PartnerStrikeStatus {
  ACTIVE
  WAIVED
  EXPIRED
}

// =============================================================================
// BRAND
// =============================================================================

model Brand {
  id                      String                     @id @default(cuid())
  creatorProfileId        String
  name                    String
  handle                  String                     @unique // public URL slug (storefront route)
  positioning             String? // short positioning statement
  // === Brand Assets (V1 corrected scope per docs/DESIGN_STUDIO_REBUILD.md §4) ===
  // The brand identity in iLaunchify is a packaging-design ASSET LIBRARY that
  // feeds the Fabric.js canvas — NOT a web design-system editor. Per memory note
  // ilaunchify-brand-assets-not-design-system.md (2026-05-25 scope correction).
  //
  // What the canvas consumes:
  //   - Colors  → color pickers (text / background / ink) get brand swatches pinned at the top
  //   - Fonts   → Text drawer font dropdown gets brand fonts pinned at the top
  //   - Logos   → Images drawer "My Brand" section gets logo variants for drag-onto-canvas
  //
  // Colors: 3 named slots (primary/secondary/accent) for the canonical brand triad,
  // plus an optional brandSwatches[] for additional swatches (cap ~5 total in UI).
  colorPrimary            String? // #16a34a etc; surfaces in canvas color pickers
  colorSecondary          String?
  colorAccent             String?
  brandSwatches           String[] // optional 4th/5th swatches beyond the primary 3
  // Fonts: list of 1-3 TypographyFont IDs (typically heading + body + optional accent).
  // No PairId / ScaleRatio — those were web-design-system concepts (typographic scales,
  // pair lockups) that don't apply to packaging design where the canvas tools choose
  // per-element size.
  brandFontIds            String[] // FK-ish to TypographyFont.id (validated in app code)
  // Logos: PRIMARY is the master mark. ICON + HORIZONTAL are the most commonly-used
  // variants. VERTICAL / MONOGRAM / INVERSE / FAVICON dropped — creators get confused
  // by the distinctions (per Pavel feedback 2026-05-26) and label designers rarely
  // need more than 3 logo variants in V1.
  logoAssetId             String? // PRIMARY logo mark
  logoIconAssetId         String? // icon-only variant
  logoHorizontalAssetId   String? // horizontal lockup
  heroAssetId             String? // brand hero image (used in marketing surfaces if any)
  // Tagline — single string. secondaryTaglines[] dropped (over-build).
  tagline                 String?
  aboutText               String?
  isActive                Boolean                    @default(true)
  // V1 — geographic + market scoping per docs/MARKETS_AND_REGIONS.md
  operatingRegionId       String? // brand's home region (US state V1)
  // Onboarding completion flag (creator launch checklist Step 4)
  onboardingCompletedAt   DateTime? // null until creator has filled in brand basics
  // Relations
  creatorProfile          CreatorProfile             @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  socialAccounts          SocialAccount[]
  // Brand Kit templates — reusable packaging/label starting points (docs/BRAND_KIT_PROPOSAL.md).
  brandTemplates          BrandTemplate[]
  // Brand Kit V2 Slice 2 — creator-uploaded custom fonts (docs/BRAND_KIT_V2_PROPOSAL.md §3b).
  brandFonts              BrandFont[]
  // Brand Kit V2 Slice 2c/4 — named text-style → font assignments (Heading/Subheading/Body).
  brandTextStyles         BrandTextStyle[]
  // Brand Kit V2 Slice 3 — creator-pinned visual assets (photos/graphics/backgrounds).
  brandAssets             BrandAsset[]
  // Brand Kit V2 Slice 5 — named color palettes (multi-palette + gradients + CMYK/Pantone).
  brandPalettes           BrandPalette[]
  products                Product[]
  templates               Template[]
  designs                 Design[]
  orders                  Order[]
  // Phase G6 — Subscribe & save recurring production runs.
  productionSubscriptions ProductionSubscription[]
  operatingRegion         Region?                    @relation("BrandOperatingRegion", fields: [operatingRegionId], references: [id])
  targetMarkets           BrandTargetMarket[]
  onboardingState         CreatorOnboardingProgress?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

// =============================================================================
// SOCIAL ACCOUNTS (V1.5+ UI; V1 table only)
// =============================================================================

model SocialAccount {
  id              String         @id @default(cuid())
  brandId         String
  platform        SocialPlatform
  externalUserId  String
  handle          String
  // Token references — actual tokens in a separate KMS/secret store
  accessTokenRef  String
  refreshTokenRef String?
  scope           String
  connectedAt     DateTime       @default(now())
  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, platform])
}

// =============================================================================
// INGREDIENTS & RECIPES
// =============================================================================

model Ingredient {
  id                       String                          @id @default(cuid())
  // Legacy fields (preserved for back-compat with rows created before 2026-05-24):
  usdaFdcId                String?                         @unique // populated for USDA-sourced rows
  name                     String // legacy display name; new code reads internalName
  nutritionPer100g         Json // { calories, totalFat, saturatedFat, ... } — also the canonical V1 nutrient profile
  // Domain-specific ingredient payload keyed by product domain (Phase 0,
  // docs/PRODUCT_DOMAINS_ARCHITECTURE.md): { dietaryIngredient?, inci?,
  // guaranteedAnalysis? }. Food/baby keep using nutritionPer100g; supplement/
  // cosmetic/pet read their typed shape from here. Additive, optional.
  domainData               Json? // typed-per-domain; null for plain food rows
  category                 String? // legacy free-text category
  isOrganic                Boolean                         @default(false)
  allergens                String[] // legacy ["milk","wheat","sesame"]; new code reads allergenFlags
  // V1 — three-tier sourcing per docs/MANUFACTURER_PRODUCT_BUILDER.md §4a
  source                   IngredientSource? // nullable until backfilled; new rows must set
  sourceRefId              String? // FDC fdc_id (mirrors usdaFdcId for USDA), library slug, or partner UUID
  internalName             String? // 'Symrise Natural Vanilla 67-B' — used in recipe editor / cost / COA matching
  labelDeclarationName     String? // 'Natural Flavor' — printed on FDA label; defaults to internalName if unset
  densityGPerML            Float? // for volume↔mass conversion
  allergenFlags            String[] // canonical Big-9 set ["milk","eggs","fish","shellfish","tree_nuts","peanuts","wheat","soybeans","sesame"] + iLaunchify-extended
  complianceNotes          String? // e.g. 'FDA class I nutrient', '21 CFR exemption'
  // V1 — verification governance per docs/MANUFACTURER_PRODUCT_BUILDER.md §4a.5
  verificationStatus       VerificationStatus              @default(LIBRARY_PROMOTED) // USDA/seed = LIBRARY_PROMOTED; partner-private = SELF_ATTESTED by default
  coaFileId                String? // optional uploaded COA PDF (PartnerFile)
  createdById              String? // User who created (null for USDA-imported)
  verifiedById             String? // admin User who verified (null until ADMIN_VERIFIED)
  ownerPartnerId           String? // NULL for USDA + LIBRARY; partner id for PARTNER_PRIVATE
  promotedFromIngredientId String? // breadcrumb if this LIBRARY row was promoted from a PRIVATE one
  // Mode 3 (Slice 4) — synthetic "Whole Product" row holding a declared panel.
  // Hidden from the normal IngredientPicker so it never pollutes Mode 1 search.
  isDeclaredPanelSynthetic Boolean                         @default(false)
  // V1 — bioengineered disclosure per USDA BE Standard 2022 (Recipal parity, FOD admin delta §1.5e)
  bioengineeredStatus      BioengineeredStatus             @default(NOT_APPLICABLE)
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  // Relations
  recipeIngredients        RecipeIngredient[]
  // Catalog roles — same ingredient can serve as a base, replacement, or optional across templates
  templateSlotsAsBase      TemplateIngredientSlot[]        @relation("SlotBaseIngredient")
  templateReplacements     TemplateIngredientReplacement[] @relation("ReplacementIngredient")
  templateOptionals        TemplateOptionalIngredient[]    @relation("OptionalIngredient")
  // V1 new relations
  ownerPartner             Partner?                        @relation("PartnerPrivateIngredients", fields: [ownerPartnerId], references: [id])
  promotedFrom             Ingredient?                     @relation("IngredientPromotionLineage", fields: [promotedFromIngredientId], references: [id])
  promotedTo               Ingredient[]                    @relation("IngredientPromotionLineage")
  usageStats               IngredientUsage[]

  @@index([name])
  @@index([usdaFdcId])
  @@index([source, sourceRefId])
  @@index([ownerPartnerId])
  @@index([verificationStatus])
}

model Recipe {
  id                   String             @id @default(cuid())
  productId            String             @unique
  status               RecipeStatus       @default(DRAFT)
  servingsPerContainer Decimal
  servingSizeG         Decimal // grams per serving
  servingSizeDesc      String? // "1 scoop (30g)"
  // Calculated nutrition (after calc engine runs) — cached
  nutritionProfile     Json?
  // Relations
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients          RecipeIngredient[]
  complianceChecks     ComplianceCheck[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model RecipeIngredient {
  id           String                   @id @default(cuid())
  recipeId     String
  ingredientId String
  weightG      Decimal // grams per total recipe
  position     Int // for descending-order display
  // Track where this ingredient came from when the recipe was resolved.
  // V1: every catalog-driven Product fills this in. Legacy rows = null.
  source       ProductIngredientSource?
  // For TEMPLATE_BASE / TEMPLATE_REPLACEMENT: links back to the slot it filled.
  // Lets us reconstruct the creator's customization choices.
  filledSlotId String?
  recipe       Recipe                   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient               @relation(fields: [ingredientId], references: [id])
  filledSlot   TemplateIngredientSlot?  @relation(fields: [filledSlotId], references: [id])

  @@unique([recipeId, ingredientId])
}

enum ProductIngredientSource {
  TEMPLATE_BASE // creator kept the manufacturer's default
  TEMPLATE_REPLACEMENT // creator swapped to one of the offered alternatives
  TEMPLATE_OPTIONAL // creator toggled an optional ingredient on
}

// =============================================================================
// PRODUCTS
// =============================================================================

model Product {
  id                      String           @id @default(cuid())
  brandId                 String
  marketId                String // V1: always US
  slug                    String // storefront URL: /shop/{handle}/{slug}
  name                    String
  description             String?
  category                ProductCategory
  status                  ProductStatus    @default(DRAFT)
  priceCents              Int              @default(0)
  // Featured + ordering
  featured                Boolean          @default(false)
  displayOrder            Int              @default(0)
  // Inventory (V1: manufacturer-defined limit, no real-time per-order reserve)
  inventoryAvailable      Int?
  // Disclosure level override (defaults to PartnerService's, but creator can override)
  disclosureLevelOverride DisclosureLevel?
  // Visual
  primaryImageAssetId     String?
  // Catalog binding — every V1 creator product starts from a ProductTemplate
  // chosen from the admin-curated catalog (nullable to keep schema migration
  // additive; new flows require it).
  productTemplateId       String?
  variantId               String?
  // Inventory-vs-storefront publishing — creators can do either or both
  publishedToStorefront   Boolean          @default(false)
  inventoryOrderQty       Int? // if creator pre-bought their own stock

  // ---- Retail identity (GTIN / UPC) ----
  // Optional GTIN — UPC-A (12), EAN-13 (13), EAN-8 (8), or ITF-14 (14).
  // Required only when the creator intends to sell on Amazon / Walmart /
  // Target etc. Empty for DTC-only launches. See [[ilaunchify-gtin-model]].
  gtin                    String?                  @unique
  gtinSource              GtinSource               @default(USER_PROVIDED)
  // Free-form internal SKU — printed as Code 128 when barcodeMode = INTERNAL_SKU,
  // so creators can ship pre-launch samples / beta batches before their GS1
  // registration completes. Distinct from gtin: SKUs are not retail-safe.
  internalSku             String?
  barcodeMode             BarcodeMode              @default(NONE)
  // Relations
  brand                   Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market                  Market                   @relation(fields: [marketId], references: [id])
  recipe                  Recipe?
  template                Template?                @relation(fields: [templateId], references: [id])
  templateId              String?
  productTemplate         ProductTemplate?         @relation(fields: [productTemplateId], references: [id])
  variant                 ProductTemplateVariant?  @relation(fields: [variantId], references: [id])
  designs                 Design[]
  orderItems              OrderItem[]
  channelLinks            ChannelProductLink[]
  // Phase G1 — in-progress checkout drafts
  checkoutDrafts          CheckoutDraft[]
  // Phase G6 — Subscribe & save recurring production runs.
  productionSubscriptions ProductionSubscription[]
  // Slice C7.a — multi-component packaging
  packagingComponents     PackagingComponent[]
  // Slice C7.b — partner-bundled accessories
  accessories             ProductAccessory[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([brandId, slug])
  @@index([brandId, status])
  @@index([productTemplateId])
}

// =============================================================================
// RULE PACKS & COMPLIANCE
// =============================================================================

model RulePack {
  id              String            @id @default(cuid())
  externalId      String            @unique // matches the JSON file id, e.g. "us-fda-food-2026.01"
  marketId        String
  productCategory ProductCategory // FOOD | SUPPLEMENT
  name            String
  description     String?
  isActive        Boolean           @default(true)
  market          Market            @relation(fields: [marketId], references: [id])
  versions        RulePackVersion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([marketId, productCategory])
}

model RulePackVersion {
  id               String            @id @default(cuid())
  rulePackId       String
  version          String // semver; matches JSON
  effectiveFrom    DateTime
  fileRef          String // path to JSON file in services/compliance/app/rule_packs/
  status           RulePackStatus    @default(PUBLISHED)
  changesSummary   String?
  rulePack         RulePack          @relation(fields: [rulePackId], references: [id], onDelete: Cascade)
  complianceChecks ComplianceCheck[]
  createdAt        DateTime          @default(now())

  @@unique([rulePackId, version])
}

model ComplianceCheck {
  id                String                 @id @default(cuid())
  recipeId          String
  rulePackVersionId String
  // Inputs hash — same hash means same inputs, deterministic outputs
  inputsHash        String
  // Result
  outcome           ComplianceCheckOutcome
  violations        Json // Violation[]
  warnings          Json // Warning[]
  disclosures       Json // required disclosures (Contains:, DSHEA, iron warning, etc.)
  panelData         Json // rounded values + format metadata
  // Audit
  triggeredByUserId String?
  // Relations
  recipe            Recipe                 @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rulePackVersion   RulePackVersion        @relation(fields: [rulePackVersionId], references: [id])
  triggeredByUser   User?                  @relation(fields: [triggeredByUserId], references: [id])
  createdAt         DateTime               @default(now())

  @@index([recipeId])
  @@index([rulePackVersionId])
  @@index([inputsHash])
}

// =============================================================================
// TEMPLATES & DESIGNS
// =============================================================================

model Template {
  id                String             @id @default(cuid())
  brandId           String // brand-owned (vs. DesignLibraryItem which is platform-owned)
  name              String
  status            TemplateStatus     @default(DRAFT)
  dieCutTemplateId  String // every template targets a specific physical shape
  // Design library origin (if cloned from one)
  origLibraryItemId String?
  // Relations
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  dieCutTemplate    DieCutTemplate     @relation(fields: [dieCutTemplateId], references: [id])
  origLibraryItem   DesignLibraryItem? @relation(fields: [origLibraryItemId], references: [id])
  versions          TemplateVersion[]
  products          Product[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model TemplateVersion {
  id                    String      @id @default(cuid())
  templateId            String
  version               Int // monotonic increment
  designJson            Json // Fabric.js serialized state
  // Generation lineage (for AI in V1.5+)
  source                AssetSource @default(USER_UPLOAD)
  generationMeta        Json?
  // Compliance state at this version
  lastComplianceCheckId String?
  template              Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  designs               Design[]
  createdAt             DateTime    @default(now())

  @@unique([templateId, version])
}

// Design — a creator's in-progress or finalized design for a specific Product.
// Distinct from Template (which is the reusable starting point).
/// How the label artwork was produced — drives the compliance gate path.
/// STUDIO_BUILT = structured objects (full auto-gate). IMPORTED_HYBRID = designer
/// background + platform Facts/allergen objects (auto-gate on those). IMPORTED_FLAT
/// = fully flattened artwork → human compliance review. docs/DIELINE_FRAME_EDITOR_SPEC.md §7b.
enum LabelSource {
  STUDIO_BUILT
  IMPORTED_HYBRID
  IMPORTED_FLAT
}

model Design {
  id                  String           @id @default(cuid())
  productId           String
  brandId             String
  templateVersionId   String? // which template version this started from
  status              DesignStatus     @default(DRAFT)
  // Phase D — label-source mode (additive substrate; routing built later).
  labelSource         LabelSource      @default(STUDIO_BUILT)
  // Cert badges (DESIGN_STUDIO.md §Certificate badges V1). A product has one
  // Design per surface/die-cut; exactly one is the "certifications surface"
  // that hosts the managed cert-badge zone. Auto-defaults to the product's
  // first Design; creator can move it (app logic enforces at-most-one true).
  showsCertifications Boolean          @default(false)
  // Per-flavor labels (PackingProfile.labelTopology = PER_FLAVOR; see
  // docs/HANDOFF-TO-CODE-per-flavor-labels.md). null = the shared BASE design;
  // a FlavorPreset id = that flavor's label (shared base + per-flavor overrides).
  // Soft FK (FlavorPreset is template-scoped). Resolve per (productId, flavorPresetId).
  flavorPresetId      String?
  // Relations
  product             Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand               Brand            @relation(fields: [brandId], references: [id])
  templateVersion     TemplateVersion? @relation(fields: [templateVersionId], references: [id])
  versions            DesignVersion[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([productId, flavorPresetId])
}

model DesignVersion {
  id                 String                    @id @default(cuid())
  designId           String
  version            Int
  designJson         Json // Fabric.js serialized state
  // Generation lineage
  source             AssetSource               @default(USER_UPLOAD)
  generationMeta     Json?
  // Export references
  exportedPdfAssetId String?
  exportedAt         DateTime?
  // Relations
  design             Design                    @relation(fields: [designId], references: [id], onDelete: Cascade)
  // V1.5+ Phase F — print finishes the creator applied to this design version.
  finishApplications DesignFinishApplication[]
  // Phase G8 — OrderItems that locked in this version. Lets us refuse
  // delete on a version with a paid order against it.
  orderItems         OrderItem[]
  createdAt          DateTime                  @default(now())

  @@unique([designId, version])
}

// =============================================================================
// EDIT SNAPSHOTS — user-facing version history for the two editor surfaces
// (partner product-builder draft + creator Design Studio canvas). Distinct from
// DesignVersion (which holds the live WORKING row + order-locked export
// lineage): this is a rolling, throttled history the user can browse + restore.
// Retention = ring buffer (keep last N non-pinned) + pinned milestones, pruned
// on write. Polymorphic by (entityType, entityId) so ONE model + engine + UI
// serve both surfaces — no FK (history side-table; ownership enforced in the
// per-app actions; orphans on hard-delete are harmless + TTL-prunable).
// docs/VERSION_HISTORY.md.
// =============================================================================

enum SnapshotEntity {
  PRODUCT_TEMPLATE_DRAFT // entityId = ProductTemplate.id (partner builder)
  DESIGN // entityId = Design.id (creator Design Studio)
}

enum SnapshotKind {
  AUTO // throttled background snapshot
  MILESTONE // step-advance / confirm / submit / export — pinned, kept forever
  MANUAL // user explicitly saved a named version — pinned
}

model EditSnapshot {
  id          String         @id @default(uuid())
  entityType  SnapshotEntity
  entityId    String
  kind        SnapshotKind   @default(AUTO)
  label       String? // milestone/manual label, e.g. "Submitted for review"
  snapshot    Json // compact editor state (builder fields OR fabric layout w/ ASSET REFS, never embedded data-URLs)
  thumbnail   String? // small PNG data URL captured from the live canvas (design studio); null for builder/old rows
  pinned      Boolean        @default(false) // milestones + manual are pinned → exempt from ring-buffer prune
  createdById String? // User.id that triggered it (nullable for system snaps)
  createdAt   DateTime       @default(now())

  @@index([entityType, entityId, createdAt])
}

// =============================================================================
// PRINT FINISHES — admin-curated FinishType catalog, partner-offered
// PartnerFinish rows, per-design DesignFinishApplication. Per
// docs/PRINT_FINISHES_PLAN.md Phase F1.
// =============================================================================

model FinishType {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  category           FinishCategory
  description        String
  // Default application modes this finish CAN support — partners can restrict
  // to a subset when they add their offering.
  applicationModes   ApplicationMode[]
  // Reference / "what it looks like" sample (admin-uploaded)
  exampleAssetId     String?
  // Printer-facing default spec text — used as a starting template when
  // partner doesn't override.
  defaultPrinterSpec String?
  status             BrandLibraryStatus @default(ACTIVE) // DRAFT | ACTIVE | DEPRECATED
  // Slice C8 — maps an accent finish to a decoration method (foil/emboss/etc.).
  // Null for general (non-accent) finishes. See _V1_DECORATION_METHODS.md
  decorationMethod   DecorationMethod?
  // Relations
  partnerFinishes    PartnerFinish[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model PartnerFinish {
  id                   String                    @id @default(cuid())
  partnerServiceId     String // Scoped to a specific service
  finishTypeId         String
  // Partner-friendly overrides
  name                 String? // "Premium Spot UV" instead of "Spot UV Gloss"
  description          String? // Sales copy + technical notes for the creator
  // Pricing model — see PRINT_FINISHES_PLAN.md §3
  pricingMode          FinishPricingMode
  basePriceCents       Int                       @default(0) // Setup fee per order
  perUnitPriceCents    Int                       @default(0) // Per printed unit
  pricePerSqInCents    Int? // For PER_AREA mode
  pricePerObjectCents  Int? // For PER_OBJECT mode
  pricePerColorCents   Int? // For PER_COLOR mode
  pricingTiers         Json? // For TIERED — [{ minQty, perUnitCents }]
  // Lead-time + MOQ impact
  leadTimeDays         Int                       @default(0) // Added to base lead time
  moqMin               Int                       @default(0) // Min order qty for this finish
  // Application
  availableModes       ApplicationMode[] // Subset of FinishType.applicationModes
  // Substrate compatibility — slugs of substrates this finish works on. Per
  // Pavel's correction substrate selection lives in the post-canvas checkout
  // stepper (Phase G); this list is read by the Finishes drawer to hide
  // incompatible finishes once the creator has picked a substrate.
  compatibleSubstrates String[]
  maxCoveragePct       Float? // % of total area; e.g. some finishes max at 30% area
  // Sample assets — what this looks like on a real product
  sampleAssetIds       String[]
  // Status
  status               FinishStatus              @default(DRAFT)
  // Relations
  partnerService       PartnerService            @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  finishType           FinishType                @relation(fields: [finishTypeId], references: [id])
  applications         DesignFinishApplication[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([partnerServiceId, status])
  @@index([finishTypeId])
}

model DesignFinishApplication {
  id                    String          @id @default(cuid())
  designVersionId       String
  partnerFinishId       String
  // Application detail
  applicationMode       ApplicationMode
  // For OBJECT_SELECTION — fabric customId stamps the creator picked.
  objectRefs            String[]
  // For COLOR_BASED — hex colors the creator picked.
  colorFilters          String[]
  // For REGION_MASK — polygon points in mm, relative to trim box origin.
  regionPolygons        Json? // [[{x,y}, ...], ...]
  // For UPLOADED_MASK — asset id of the mask layer (PDF / PNG with alpha).
  maskAssetId           String?
  // Creator note to the printer (free text)
  creatorNotes          String?
  // Cached cost at last save — re-computed on every change so the Studio
  // shows a live cost without re-pricing on every render.
  estimatedPerUnitCents Int             @default(0)
  estimatedSetupCents   Int             @default(0)
  coverageSqIn          Float?
  objectCount           Int?
  spotColorCount        Int?
  // Relations
  designVersion         DesignVersion   @relation(fields: [designVersionId], references: [id], onDelete: Cascade)
  partnerFinish         PartnerFinish   @relation(fields: [partnerFinishId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([designVersionId])
}

enum FinishCategory {
  SURFACE
  FOIL_METALLIC
  EMBOSS_TEXTURE
  CUT
  INK
  SPECIAL
  // SUBSTRATE intentionally absent — material selection lives in the
  // post-canvas checkout stepper (Phase G), not the Design Studio.
}

enum ApplicationMode {
  WHOLE_DESIGN // Whole label/whole panel
  TEXT_ONLY // All text objects
  IMAGE_ONLY // All image objects
  TEXT_AND_IMAGES // All non-NFR objects
  OBJECT_SELECTION // Creator picks specific objects (most powerful)
  REGION_MASK // Creator draws a polygon mask
  COLOR_BASED // Apply wherever specific colors appear
  UPLOADED_MASK // Creator uploads a separate mask layer PDF/PNG
}

enum FinishPricingMode {
  FLAT_PER_ORDER // One-time setup fee, no per-unit
  PER_UNIT // Same cost per printed unit
  PER_AREA // Per square inch (or square mm) of coverage
  PER_OBJECT // Per object selected
  PER_COLOR // Per spot color used
  TIERED // Volume tiers
}

enum FinishStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

// =============================================================================
// DIE-CUT TEMPLATES (physical printing specs)
// =============================================================================

model DieCutTemplate {
  id               String                   @id @default(cuid())
  name             String
  slug             String                   @unique
  category         DieCutCategory
  widthMm          Float
  heightMm         Float
  outlineSvg       String // SVG path of the cut outline
  bleedMm          Float                    @default(3.0)
  safeAreaMm       Float                    @default(3.0)
  isStandard       Boolean                  @default(true)
  isActive         Boolean                  @default(true)
  // 3D preview hint (V1.5+ uses this; V1 stores the value but doesn't render)
  model3dKey       String?
  // Relations
  templates        Template[]
  partnerServices  PartnerServiceDieCut[]
  libraryItems     DesignLibraryItem[]
  templateVariants ProductTemplateVariant[]
  // Partner die-lines normalized against this canonical shape (P2 mapping).
  mappedDielines   PackagingDieline[]       @relation("DielineCanonicalShape")
  createdAt        DateTime                 @default(now())
}

// Junction: which die-cuts a LABEL_PRINTING service supports + per-partner overrides
model PartnerServiceDieCut {
  partnerServiceId String
  dieCutTemplateId String
  // Per-relationship overrides
  surchargeCents   Int?
  leadTimeDays     Int?
  notes            String?
  partnerService   PartnerService @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  dieCutTemplate   DieCutTemplate @relation(fields: [dieCutTemplateId], references: [id])

  @@id([partnerServiceId, dieCutTemplateId])
}

// =============================================================================
// DESIGN LIBRARY (curated platform-owned designs)
// =============================================================================

model DesignLibraryItem {
  // Conceptual name in spec docs: "LabelDesignTemplate" (docs/DESIGN_STUDIO.md §3).
  // The Studio's template gallery filters this table by the compatibility fields
  // below + the creator's brand.brandVoiceTags overlap with styleTags.
  id                         String                 @id @default(cuid())
  name                       String
  description                String?
  category                   DieCutCategory
  dieCutTemplateId           String
  previewAssetId             String
  templateSpec               Json // serialized design (layers, slots)
  // Legacy fields (preserved for back-compat):
  tags                       String[] // ["minimal", "organic", ...] — superseded by styleTags
  source                     DesignLibrarySource    @default(CURATED) // superseded by createdBy
  isActive                   Boolean                @default(true) // superseded by lifecycleStatus
  generationMeta             Json? // for AI_AUTHORED
  // V1 compatibility fields driving Design Studio auto-filtering
  // (per docs/DESIGN_STUDIO.md §3 + task #148)
  compatiblePackagingTypeIds String[] // FK-ish to PackagingType.id; empty = compatible with any
  compatibleSurfaces         LabelTemplateSurface[] // FRONT | BACK | LID | FULL_WRAP | SLEEVE | NECK
  productCategoryFit         String[] // e.g., ['SUPPLEMENT', 'BEVERAGE', 'SAUCE']
  styleTags                  String[] // matches Brand.brandVoiceTags vocab (minimalist|vintage|bold|organic|scientific|luxury|playful|wellness|athletic|clinical)
  // V1 tier model — billing flow lands V1.5
  tier                       LabelTemplateTier      @default(REGULAR)
  priceCents                 Int? // PREMIUM only
  exclusiveSeats             Int? // EXCLUSIVE only (default 5 per spec; nullable for REGULAR/PREMIUM)
  exclusiveLicenseHolders    String[] // partnerIds (or brandIds) that have claimed seats
  // V1 provenance — supports V2 AI Template Agent pipeline
  createdBy                  LabelTemplateCreator   @default(ADMIN)
  aiSubAgent                 String? // when createdBy=AI_AGENT (e.g., 'Generator-v1', 'Generator-v2-personalized')
  trendReportId              String? // V2 — links to DesignTrendReport when AI-generated
  humanCuratorId             String? // admin User who approved ACTIVE
  // V1 lifecycle (distinct from legacy isActive boolean)
  lifecycleStatus            LabelTemplateStatus    @default(DRAFT)
  // Relations
  dieCutTemplate             DieCutTemplate         @relation(fields: [dieCutTemplateId], references: [id])
  clonedTemplates            Template[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([lifecycleStatus, tier])
}

// =============================================================================
// ASSETS
// =============================================================================

model Asset {
  id               String      @id @default(cuid())
  ownerType        String // 'BRAND' | 'TEMPLATE' | 'DESIGN' | 'PARTNER' | 'PRODUCT' | 'LIBRARY' | 'PLATFORM'
  ownerId          String? // FK to the relevant model
  type             AssetType
  source           AssetSource @default(USER_UPLOAD)
  generationMeta   Json? // null for non-AI; populated for AI_GENERATED
  // Storage
  storageKey       String      @unique // R2 key
  publicUrl        String? // CDN URL (for public assets)
  mimeType         String
  sizeBytes        Int
  widthPx          Int?
  heightPx         Int?
  // Tracking
  isPublic         Boolean     @default(false)
  uploadedByUserId String?
  createdAt        DateTime    @default(now())

  @@index([ownerType, ownerId])
  @@index([type])
}

// =============================================================================
// ORDERS
// =============================================================================

// Order = a creator's production order. Per the 2026-05-19 model correction,
// iLaunchify is B2B production: the creator pays iLaunchify for a batch, and
// the goods ship to either the creator's own address or a connected
// WAREHOUSE partner. End-consumer purchases happen on the creator's external
// channels (Shopify, Amazon, etc.) and never touch iLaunchify.
// =============================================================================
// PRODUCTION OPTIONS — typed catalog for the Phase G3 checkout wizard.
//
// Per the G3 standardisation commitment (memory:
// [[ilaunchify-g3-standardize-capabilities]]), substrate and packaging
// material are first-class admin-curated tables, NOT freeform JSON inside
// PartnerService.capabilities. This drives:
//
//   * the creator-side ProductionStep pickers in the checkout wizard,
//   * partner-matching for marketplace routing (#153),
//   * cost estimation in OrderSummary,
//   * the manifest emitted alongside the production-order export bundle.
//
// Per-partner pricing + lead-time overrides land on the junction tables.
// =============================================================================

model Substrate {
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  name                     String
  category                 SubstrateCategory
  description              String
  // Base per-unit cost surcharge (cents) when no partner override applies.
  // Compared against the cheapest option in the same category — keeps the
  // wizard's "this choice +$0.04" microcopy honest.
  baseUnitCostCents        Int                       @default(0)
  // Sustainability indicator — surfaces a leaf icon in the picker.
  sustainabilityTier       SustainabilityTier        @default(STANDARD)
  // Hints which finish categories work on this substrate. Compared
  // against PartnerFinish.compatibleSubstrates[] when the Finishes drawer
  // grays out incompatible picks. Empty = no known incompatibilities.
  finishCompatibility      String[]
  // Admin lifecycle state — DRAFT hidden from pickers, ACTIVE shown,
  // DEPRECATED grayed out with replacement hint in V1.5+.
  status                   BrandLibraryStatus        @default(ACTIVE)
  // Relations
  partnerServiceSubstrates PartnerServiceSubstrate[]
  // Slice C9 — services that default to this substrate in their print output spec.
  printOutputSpecs         PartnerPrintOutputSpec[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model PackagingMaterial {
  id                               String                            @id @default(cuid())
  slug                             String                            @unique
  name                             String
  topology                         PackagingTopology // BOTTLE → glass/plastic, JAR → glass/PP, etc.
  description                      String
  baseUnitCostCents                Int                               @default(0)
  // FDA / FSANZ / EFSA food-contact-safe flag. Required true for any
  // product where category=FOOD or BEVERAGE_FUNCTIONAL.
  foodSafe                         Boolean                           @default(true)
  sustainabilityTier               SustainabilityTier                @default(STANDARD)
  status                           BrandLibraryStatus                @default(ACTIVE)
  // Relations
  partnerServicePackagingMaterials PartnerServicePackagingMaterial[]
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt

  @@index([topology, status])
}

enum SubstrateCategory {
  PAPER_COATED // matte / gloss coated paper labels
  PAPER_UNCOATED // natural / textured uncoated paper
  KRAFT_RECYCLED // recycled brown kraft (eco-friendly)
  FILM_BOPP // synthetic film (durable, water-resistant)
  FILM_CLEAR // transparent film (no-label look)
  FILM_METALLIC // foil-finish substrate
  SPECIALTY // textured / fabric / wood-grain / etc.
}

enum SustainabilityTier {
  STANDARD // baseline
  RECYCLED // post-consumer recycled content
  COMPOSTABLE // certified compostable
  BIODEGRADABLE // biodegradable but not compostable
}

// =============================================================================
// SLICE C9 — PARTNER PRINT OUTPUT SPEC (dieline normalization)
// Prepress output preferences, one row per PartnerService. Documented source
// of truth for export bundle generation. See docs/builds/_V1_DIELINE_NORMALIZATION.md
// =============================================================================

enum FileFormat {
  PDF_X1A
  PDF_X4
  TIFF
  EPS_AI
}

enum ColorSpace {
  CMYK
  RGB
  CMYK_OGV
  GRAYSCALE
}

enum FontPolicy {
  EMBED
  OUTLINE_TO_PATHS
  EITHER
}

enum DielineDelivery {
  SEPARATE_FILE
  LAYERED_IN_PDF
  BOTH
}

enum ManifestFormat {
  JSON_STANDARD
  CUSTOM_XML
  NONE
}

enum PmsBook {
  COATED
  UNCOATED
  MATTE
  NEON
  METALLIC
  PASTEL
}

model PartnerPrintOutputSpec {
  id                    String          @id @default(uuid())
  partnerServiceId      String          @unique
  preferredFileFormat   FileFormat      @default(PDF_X4)
  colorSpace            ColorSpace      @default(CMYK)
  iccProfile            String?
  tacLimitPct           Int             @default(300)
  spotColorsAccepted    Boolean         @default(true)
  spotColorLibrary      PmsBook         @default(COATED)
  specialChannelNaming  Json            @default("{}") // {white, varnish, foil}
  minDpi                Int             @default(300)
  bleedMm               Decimal         @default(3.0) @db.Decimal(5, 2)
  fontPolicy            FontPolicy      @default(EMBED)
  dielineDeliveryFormat DielineDelivery @default(SEPARATE_FILE)
  dielineLayerName      String?
  defaultSubstrateId    String?
  manifestFormat        ManifestFormat  @default(JSON_STANDARD)
  exportInstructions    String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  partnerService   PartnerService @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  defaultSubstrate Substrate?     @relation(fields: [defaultSubstrateId], references: [id])
}

// Junction — which substrates a LABEL_PRINTING partner service supports,
// with optional per-partner price + lead-time overrides.
model PartnerServiceSubstrate {
  id                String         @id @default(cuid())
  partnerServiceId  String
  substrateId       String
  // Override the substrate's baseUnitCostCents for this partner. NULL
  // means use the substrate default. Surfaces in the wizard as the
  // partner's actual quoted price.
  perUnitCostCents  Int?
  // Additional lead-time days when this substrate is chosen (some
  // substrates take longer to print on).
  extraLeadTimeDays Int            @default(0)
  // MOQ specific to this substrate (e.g., foil-finish substrates need a
  // larger run to amortise setup). NULL = use service default.
  moqMin            Int?
  // Status — DRAFT means partner is testing internally, ACTIVE shows
  // it in the picker, DISCONTINUED hides without breaking historical
  // OrderItem references.
  status            FinishStatus   @default(ACTIVE)
  partnerService    PartnerService @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  substrate         Substrate      @relation(fields: [substrateId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([partnerServiceId, substrateId])
  @@index([partnerServiceId, status])
}

// Junction — which packaging materials a MANUFACTURING partner service
// supports. Same shape as PartnerServiceSubstrate.
model PartnerServicePackagingMaterial {
  id                  String            @id @default(cuid())
  partnerServiceId    String
  packagingMaterialId String
  perUnitCostCents    Int?
  extraLeadTimeDays   Int               @default(0)
  moqMin              Int?
  status              FinishStatus      @default(ACTIVE)
  partnerService      PartnerService    @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  packagingMaterial   PackagingMaterial @relation(fields: [packagingMaterialId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([partnerServiceId, packagingMaterialId])
  @@index([partnerServiceId, status])
}

// Phase G4 — addresses creators save for reuse across production orders.
// Surfaced in the wizard's Fulfillment step as the SAVED_ADDRESS picker.
// Soft-delete pattern is overkill at V1 scale; a hard delete cascades from
// the User row.
model CreatorSavedAddress {
  id            String   @id @default(cuid())
  creatorUserId String
  label         String // "Home", "Studio", "Lower-East 3PL", etc.
  contactName   String
  contactPhone  String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String?
  postalCode    String
  country       String   @default("US")
  // The first address the creator saves becomes the default automatically.
  // Switching the default toggles the prior one's flag in the same txn.
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  creator       User     @relation("CreatorSavedAddresses", fields: [creatorUserId], references: [id], onDelete: Cascade)

  @@index([creatorUserId, isDefault])
}

// Phase G1 — pre-Order wizard state. The 7-step checkout wizard at
// /products/[id]/checkout persists into this table between steps so the
// creator can leave and resume. On final "Pay" the draft converts into a
// real Order row + Stripe Checkout session (G5).
//
// One in-progress draft per (creator, product) — picking up where you left
// off is the default UX; starting fresh just overwrites the row.
model CheckoutDraft {
  id             String   @id @default(cuid())
  creatorUserId  String
  productId      String
  // The wizard's working state — schema lives in apps/creator's wizard
  // types. Shape is roughly:
  //   { step, quantity, substrateSlug, packagingMaterialSlug,
  //     finishApplications[], shipTo: { type, savedAddressId?, address? },
  //     accessoryItemIds[], viralAssetRequests[], promoCode,
  //     designVersionId, updatedAt }
  state          Json
  // Which step the creator was on last (1-7). Drives the stepper's
  // resume-from highlight.
  currentStep    Int      @default(1)
  // Highest step completed so far. Lets the stepper render check-marks
  // for the steps behind the current cursor.
  completedSteps Int[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Relations
  creator        User     @relation("CreatorCheckoutDrafts", fields: [creatorUserId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([creatorUserId, productId])
  @@index([creatorUserId, updatedAt(sort: Desc)])
}

// =============================================================================
// Phase G6 — Production Subscriptions
// =============================================================================
//
// When a creator accepts the Subscribe & save offer at checkout Step 3, we
// create a ProductionSubscription that owns the recurring cadence: every
// MONTHLY or QUARTERLY cycle, Stripe fires `invoice.payment_succeeded` and
// our webhook spawns a new Order using the locked manifestSnapshot below.
//
// The first Order on signup still flows through the normal one-time
// placeOrderFromCheckoutDraft path — the subscription only governs the
// SECOND order onwards. That keeps day-1 UX identical and avoids a
// double-charge if the recurring schedule fires too early.
//
// manifestSnapshot is the frozen production picks (quantity / substrate /
// packagingMaterial / finishes / shipTo) — when the cycle generates an
// Order, we read this snapshot, NOT the latest CheckoutDraft. If the
// creator wants to change the recurring spec they cancel + re-subscribe.
// That gives partners the guarantee that the manifest they accepted
// originally is what they'll see every cycle.
//
// stripeSubscriptionId is the canonical Stripe ID — used for cancel,
// update, and webhook routing. stripePriceId is the snapshot of the
// Stripe Price the subscription bills against (the discount is baked
// into that Price at creation time).

model ProductionSubscription {
  id                      String                       @id @default(cuid())
  creatorUserId           String
  brandId                 String
  productId               String
  // Locked at subscription creation. Spawned Orders reference this — if
  // the design changes later we keep producing the version the
  // partners accepted.
  designVersionId         String?
  cadence                 SubscriptionCadence
  // null = open-ended (cancels on explicit cancel). Otherwise the
  // schedule stops after runsCompleted hits totalRuns.
  totalRuns               Int?
  runsCompleted           Int                          @default(0)
  // When the next Stripe invoice will fire — kept in our DB for the
  // /account/subscriptions surface so we don't round-trip Stripe.
  nextRunAt               DateTime?
  // Basis points off the per-run subtotal. 1000 = 10%.
  discountBp              Int                          @default(0)
  // Stripe handles
  stripeSubscriptionId    String                       @unique
  stripePriceId           String
  // FSM
  status                  ProductionSubscriptionStatus @default(ACTIVE)
  cancelledAt             DateTime?
  cancelledReason         String?
  // The frozen production picks (typed in apps/creator wizard).
  // Shape: { quantity, substrateSlug, packagingMaterialSlug,
  //          finishPartnerFinishIds[], shipTo: {...} }
  manifestSnapshot        Json
  // Reference subtotal at sign-up — useful for "you locked in $X / run".
  subtotalCentsAtCreation Int
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  // Relations
  creator                 User                         @relation("CreatorProductionSubscriptions", fields: [creatorUserId], references: [id])
  brand                   Brand                        @relation(fields: [brandId], references: [id])
  product                 Product                      @relation(fields: [productId], references: [id])
  // Orders the subscription has spawned. Each cycle creates one.
  orders                  Order[]                      @relation("OrdersFromSubscription")

  @@index([creatorUserId, status])
  @@index([nextRunAt])
}

enum SubscriptionCadence {
  MONTHLY
  QUARTERLY
}

enum ProductionSubscriptionStatus {
  ACTIVE // recurring; next cycle will fire
  PAUSED // creator paused; no charges until resumed (V1.5)
  CANCELLED // creator cancelled or Stripe ended billing
  COMPLETED // hit totalRuns without cancel
}

model Order {
  id                       String                  @id @default(cuid())
  brandId                  String // which brand this batch is produced under
  creatorUserId            String // the creator paying iLaunchify
  status                   OrderStatus             @default(PENDING_PAYMENT)
  // Order discriminator (Pavel 2026-06-10). PRODUCTION = a normal batch (subject
  // to MOQ + the full routing/dispatch graph). SAMPLE = a pre-production sample
  // that BYPASSES the production MOQ (uses the partner's sampleMoq) and may
  // credit toward the creator's first production order. sampleKind set only when
  // orderType = SAMPLE.
  orderType                OrderType               @default(PRODUCTION)
  sampleKind               SampleKind?
  // Money (in cents) — what the CREATOR pays iLaunchify for this production batch
  subtotalCents            Int // production cost basis (manufacturer cost + label cost)
  shippingCents            Int                     @default(0)
  taxCents                 Int                     @default(0)
  totalCents               Int // subtotal + tax + shipping + platform fee
  // Routing references — chosen partner services
  manufacturerServiceId    String?
  printProviderServiceId   String?
  // Ship-to: where the finished goods land after production
  shipToType               OrderShipToType         @default(CREATOR_ADDRESS)
  shipToPartnerServiceId   String? // when shipToType=WAREHOUSE_PARTNER, FK to a WAREHOUSE service
  shipToContactName        String // recipient name on shipping label
  shipToContactPhone       String?
  shipToAddressLine1       String
  shipToAddressLine2       String?
  shipToCity               String
  shipToState              String?
  shipToPostalCode         String
  shipToCountry            String                  @default("US")
  // Timestamps
  paidAt                   DateTime?
  deliveredAt              DateTime?
  // Phase H — aggregate approval gate across all OrderDispatch rows.
  // Computed by the FSM on every dispatch transition. Drives the
  // creator's "what's happening" banner + holds Order.status at ROUTING
  // until FULLY_ACCEPTED.
  aggregateApprovalStatus  AggregateApprovalStatus @default(AWAITING_PARTNERS)
  // Phase G6 — when this Order was spawned by a recurring subscription
  // cycle, link back to the parent. Null for ordinary one-time orders.
  // The cycle index (which run #N this is) is computed at spawn time
  // and stored separately so the customer-facing surfaces can show
  // "Run 3 of 12" without re-counting siblings.
  productionSubscriptionId String?
  subscriptionCycleNumber  Int?
  // Notes
  internalNotes            String?
  // Relations
  brand                    Brand                   @relation(fields: [brandId], references: [id])
  creator                  User                    @relation("CreatorOrders", fields: [creatorUserId], references: [id])
  shipToPartnerService     PartnerService?         @relation("WarehouseShipToOrders", fields: [shipToPartnerServiceId], references: [id])
  productionSubscription   ProductionSubscription? @relation("OrdersFromSubscription", fields: [productionSubscriptionId], references: [id])
  items                    OrderItem[]
  dispatches               OrderDispatch[]
  charge                   Charge?
  refunds                  Refund[]
  cancellationRequests     CancellationRequest[]
  disputes                 OrderDispute[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([brandId, status])
  @@index([creatorUserId, status])
}

/// Lifecycle of a sample-order credit toward a production order (Pavel 2026-06-10).
enum SampleCreditStatus {
  AVAILABLE // earned, unspent
  APPLIED // consumed against a production order
  EXPIRED // passed expiresAt before use
  VOID // sample refunded / cancelled
}

/// Ledger of credit a SAMPLE order grants toward the creator's first PRODUCTION
/// order, when the partner enabled `creditTowardFirstOrder` on the sample option
/// (capped by creditCapCents). One row per sample order. FKs are kept as plain
/// scalars (no relation objects) to keep this additive and isolated — queried by
/// (creatorUserId, brandId, productTemplateId, status). The checkout slice
/// formalises consumption + writes the AuditLog.
model SampleCredit {
  id                String             @id @default(cuid())
  creatorUserId     String
  brandId           String
  productTemplateId String
  sourceOrderId     String             @unique // the SAMPLE order that minted this credit
  amountCents       Int // credit granted (sample subtotal, capped by creditCapCents)
  remainingCents    Int // unspent balance
  status            SampleCreditStatus @default(AVAILABLE)
  appliedOrderId    String? // the PRODUCTION order it was applied to
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([creatorUserId, brandId, productTemplateId, status])
  @@index([appliedOrderId])
}

/// Platform-wide sample-order policy knobs (Pavel 2026-06-11). Admin-tunable so
/// the sample economics change without a deploy — the createSampleOrder action,
/// production-checkout credit consumption, marketplace gating, and webhook mint
/// all read from this. Singleton: exactly one row, keyed id = "default".
model SampleSettings {
  id String @id @default("default")

  // ---- Credit-back ----
  creditBackEnabled Boolean @default(true) // master switch; off = creator just pays for samples
  creditExpiryDays  Int     @default(90) // days a minted credit stays usable
  creditMaxCapCents Int? // platform ceiling on a single sample's credit (null = none)

  // ---- Sample economics ----
  sampleFlatShippingCents Int @default(995) // flat sample shipping
  samplePlatformFeeBps    Int @default(0) // platform fee on the sample order itself (basis points)

  // ---- Guardrails ----
  abuseWindowDays        Int     @default(30) // window for the per-creator sample cap
  brandedRequiresDieline Boolean @default(false) // gate branded samples on an approved die-line

  updatedAt   DateTime @updatedAt
  updatedById String? // admin User who last changed it
}

/// Platform-wide order policy knobs (Pavel 2026-06-11) — the admin-tunable
/// constants that currently live hard-coded across the order system. Singleton:
/// one row, id = "default". Surfaced under Admin → Settings → Order Settings as
/// Fees & Commissions / Partner Routing / Shipping & Fulfillment.
model OrderSettings {
  id String @id @default("default")

  // ---- Fees & commissions ----
  productionFeeBps        Int @default(500) // platform fee on production orders (bps; was PLATFORM_FEE_BPS)
  warehouseReferralFeeBps Int @default(0) // fee on warehouse-referral revenue

  // ---- Partner routing & dispatch ----
  acceptWindowHours    Int @default(24) // partner accept window per dispatch (was DEFAULT_ACCEPT_WINDOW_HOURS)
  maxReroutes          Int @default(3) // max auto-reroutes before the order holds (was MAX_REROUTES)
  // Partner-match scoring weights (raw magnitudes; the scorer renormalizes by the
  // applicable dimensions). Defaults mirror the previous hard-coded 0.40/0.35/0.25.
  capabilityWeightPct  Int @default(40) // capacity headroom above order qty
  proximityWeightPct   Int @default(35) // region/country closeness to destination
  certWeightPct        Int @default(25) // holds an active cert for the target market
  autoCancelAfterHours Int @default(72) // unpaid order auto-cancel window (runStaleOrderAutoCancel)
  // Lead-time model (D5): a variety/multipack made in N flavors needs a line
  // changeover between flavor runs, so quoted lead = max(flavorLeads) + (N-1) *
  // changeoverDays. Conservative default; admin-tunable. N<=1 adds nothing.
  changeoverDays       Int @default(1) // extra production days per additional flavor

  // ---- Shipping & fulfillment ----
  flatShippingBaseCents      Int  @default(0) // flat base added to every order
  flatShippingPerUnitCents   Int  @default(0) // per-unit shipping add
  freeShippingThresholdCents Int? // free shipping at/above this subtotal; null = never
  defaultMoq                 Int  @default(100) // default minimum order quantity (was DEFAULT_MOQ)

  // ---- Cancellations & refunds (policy; consumers land as the flows ship) ----
  creatorCancelWindowHours             Int     @default(24) // creator self-cancel window after placing
  cancellationFeeBps                   Int     @default(0) // fee retained on a cancel past the free window
  refundProcessingFeeBps               Int     @default(0) // non-refundable processing fee on refunds
  partnerStrikeOnCancel                Boolean @default(true) // partner takes a strike when their cancel is approved
  autoApproveCreatorCancelBeforeRouting Boolean @default(true) // auto-approve creator cancel before the order routes
  disputeWindowDays                    Int     @default(14) // days after delivery a creator can open a dispute

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Scope dimension for an order-settings override (Pavel 2026-06-11).
enum OrderSettingsScope {
  CREATOR_TIER // scopeKey = "maker" | "builder" | "agency"
  MARKET // scopeKey = Market.code (e.g. "US")
  REGION // scopeKey = Region.id
}

/// Scoped override of the platform OrderSettings economics (Pavel 2026-06-11).
/// Layered over the singleton default by `resolveOrderSettings(ctx)` — null
/// fields inherit the default; resolution order is region < market < creator-tier
/// (tier wins). Only economic fields are overridable; routing/dispatch stay global.
model OrderSettingsOverride {
  id       String             @id @default(cuid())
  scope    OrderSettingsScope
  scopeKey String // tier slug / market code / region id
  enabled  Boolean            @default(true)

  // Overridable economics (null = inherit the global default)
  productionFeeBps           Int?
  warehouseReferralFeeBps    Int?
  flatShippingBaseCents      Int?
  flatShippingPerUnitCents   Int?
  freeShippingThresholdCents Int?

  note        String? // admin label, e.g. "Agency launch promo"
  updatedAt   DateTime @updatedAt
  updatedById String?
  createdAt   DateTime @default(now())

  @@unique([scope, scopeKey])
  @@index([scope, enabled])
}

enum OrderShipToType {
  CREATOR_ADDRESS // goods ship to the creator's own warehouse / address
  WAREHOUSE_PARTNER // goods ship to a connected WAREHOUSE partner service
}

// Order cancellation — partner-requested path (PLATFORM_SPEC §B.4, locked
// 2026-05-19). Creator pre-accept + admin force-cancel flip Order.status
// directly; this model backs the partner-request → admin-review loop.
model CancellationRequest {
  id            String                    @id @default(cuid())
  orderId       String
  dispatchId    String? // null = whole-order cancel
  requestedById String // partner user
  reason        String
  status        CancellationRequestStatus @default(PENDING_REVIEW)
  reviewedById  String? // admin user
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime                  @default(now())
  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy   User                      @relation("CancellationRequester", fields: [requestedById], references: [id])
  reviewedBy    User?                     @relation("CancellationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
}

enum CancellationRequestStatus {
  PENDING_REVIEW
  APPROVED
  DENIED
}

// Creator-opened dispute on a delivered order (distinct from the Stripe-chargeback
// `Dispute` model). Gated by OrderSettings.disputeWindowDays — a creator can open
// one within N days of delivery. Admin resolves; V1 is record + close (refund
// execution rides the payments capability).
model OrderDispute {
  id           String              @id @default(cuid())
  orderId      String
  openedById   String // creator user
  category     OrderDisputeCategory
  description  String
  status       OrderDisputeStatus  @default(OPEN)
  resolution   String? // admin's closing note
  reviewedById String? // admin user
  reviewedAt   DateTime?
  // Partner's side of the story (B.1 partner-response step). A partner on the
  // order may respond once while the dispute is OPEN / UNDER_REVIEW; the admin
  // sees it before resolving. `partnerRespondedById` is a plain user id (no FK
  // relation needed — resolved on read).
  partnerResponse      String?
  partnerRespondedById String?
  partnerRespondedAt   DateTime?
  createdAt    DateTime            @default(now())
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy     User                @relation("DisputeOpener", fields: [openedById], references: [id])
  reviewedBy   User?               @relation("DisputeReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
}

enum OrderDisputeCategory {
  DAMAGED
  NOT_AS_DESCRIBED
  NOT_DELIVERED
  QUALITY
  OTHER
}

enum OrderDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  unitPriceCents  Int // snapshot at order time
  totalCents      Int
  // Phase G8 — locks the exact DesignVersion sold so the production
  // bundle can be regenerated deterministically even after the creator
  // makes further canvas edits. Nullable for legacy orders placed
  // before G8 shipped.
  designVersionId String?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  designVersion   DesignVersion? @relation(fields: [designVersionId], references: [id])
  // Multi-SKU dispatches (Phase 3) — the dispatches fulfilling this specific item.
  dispatches      OrderDispatch[]
  // Variety-pack builder — the distinct flavors + per-flavor quantities the creator
  // composed into this item's pack. Empty for single-flavor items.
  flavors         OrderItemFlavor[]
}

// OrderItemFlavor — one row per distinct flavor in a variety/multipack item (the
// creator pack-builder). Captures the per-flavor quantity plus a snapshot of the
// flavor's name + Statement of Identity at order time, since the FlavorPreset can
// change later but the produced labels must reflect exactly what was sold. The
// production manifest reads these to tell the manufacturer the per-flavor splits.
model OrderItemFlavor {
  id             String       @id @default(cuid())
  orderItemId    String
  flavorPresetId String
  qty            Int // units of THIS flavor in the pack
  flavorName     String // snapshot of FlavorPreset.name at order time
  soiSnapshot    String? // snapshot of the flavor's Statement of Identity at order time
  // Per-flavor labels Phase 4 — the flavor's working DesignVersion at order time,
  // snapshotted so production carries the right per-flavor artwork. Soft FK
  // (null = no per-flavor design → falls back to the shared/base design).
  designVersionId String?
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  flavorPreset   FlavorPreset @relation(fields: [flavorPresetId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([orderItemId])
  @@index([flavorPresetId])
}

// OrderDispatch — one of N dispatches per Order. Per the dual-dispatch model:
// every Order has at least one PRODUCT dispatch (manufacturer) and one LABEL
// dispatch (print provider). They advance independently.
model OrderDispatch {
  id                       String                 @id @default(cuid())
  orderId                  String
  // Multi-SKU orders (Phase 3, docs/MULTI_COMPONENT_DISPATCH.md). Which OrderItem
  // this dispatch fulfills. Nullable: pre-Phase-3 / single-item orders leave it
  // null and the manifest falls back to order.items[0] (back-compat). When set,
  // generateOrderManifest scopes the manifest to THIS item's product + components.
  orderItemId              String?
  type                     DispatchType
  partnerServiceId         String
  status                   DispatchStatus         @default(PENDING_ACCEPT)
  // Decline / timeout per docs/USER_ROLES.md decision 2026-05-18
  acceptDeadlineAt         DateTime // ASSIGNED + 24h default
  acceptReminderSentAt     DateTime? // set when the "deadline approaching" reminder fired (dedupe)
  declinedAt               DateTime?
  declineReason            DispatchDeclineReason?
  declineNotes             String?
  // Delay-accept (docs/ROUTING_BINDING_MODEL.md §7, 2026-06-14). A partner who CAN
  // make the order but not by the quoted date proposes a later delivery date; the
  // creator approves (order proceeds on the revised date) or rejects (→ cancel +
  // refund). While a proposal is pending, status stays PENDING_ACCEPT but the row is
  // EXCLUDED from auto-cancel (it's awaiting the creator, not the partner).
  proposedDeadlineAt       DateTime? // revised delivery date the partner proposes
  delayReason              String? // partner's note on why the delay
  delayProposedAt          DateTime? // when the partner proposed it (non-null = pending)
  rerouteCount             Int                    @default(0)
  // Per-state timestamps for the partner workflow (B6).
  // Useful for SLA tracking + audit + partner self-service analytics.
  acceptedAt               DateTime?
  productionStartedAt      DateTime?
  qualityCheckStartedAt    DateTime?
  qualityCheckFailedAt     DateTime?
  qualityCheckFailureNotes String?
  readyAt                  DateTime?
  // Fulfillment
  shippedAt                DateTime?
  inTransitAt              DateTime?
  trackingCarrier          String?
  trackingNumber           String?
  deliveredAt              DateTime?
  // Costs (for transfer reference)
  costCents                Int
  // Phase G8 — production bundle. Manifest is generated synchronously at
  // order placement (substrate / packaging / finishes / die-cut / ship-to
  // — no canvas needed). The actual print-ready PDF + die-line SVG land
  // in V1.5 (a headless-browser worker reads designVersionId on the
  // OrderItem and renders the Fabric JSON). bundleStatus tracks that
  // future workflow.
  bundleStatus             BundleStatus           @default(PENDING_GENERATION)
  finishManifestJson       Json?
  bundleAssetId            String?
  bundleGeneratedAt        DateTime?
  // Phase H — manifest version this dispatch is bound to. Starts at 1.
  // Increments when a CHANGES_REQUESTED adjustment ships a new snapshot.
  // The partner's ACCEPTED row records the version they accepted; if it
  // doesn't match the current row, the partner sees a 're-review' banner.
  manifestVersion          Int                    @default(1)
  acceptedManifestVersion  Int?
  // Phase H — when status is CHANGES_REQUESTED, carries the structured
  // payload partners filed. Shape:
  //   { flaggedFields: string[], partnerNote: string,
  //     suggestedAlternatives: Record<string, string|null>,
  //     requestedAt: ISO }
  changeRequest            Json?
  // Phase H — Partner withdrew after acceptance — reason + ISO. Distinct
  // from declineReason because the lifecycle stage is different.
  withdrawnAt              DateTime?
  withdrawReason           String?
  // Relations
  order                    Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem                OrderItem?             @relation(fields: [orderItemId], references: [id])
  partnerService           PartnerService         @relation(fields: [partnerServiceId], references: [id])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([orderId])
  @@index([orderItemId])
  @@index([partnerServiceId, status])
}

// =============================================================================
// PAYMENTS (Stripe Connect)
// =============================================================================

model Charge {
  id                    String       @id @default(cuid())
  orderId               String       @unique
  stripeChargeId        String       @unique
  stripePaymentIntentId String
  amountCents           Int
  currency              String       @default("usd")
  applicationFeeCents   Int // platform's cut (withheld at charge time)
  status                ChargeStatus
  statementDescriptor   String?
  // Relations
  order                 Order        @relation(fields: [orderId], references: [id])
  transfers             Transfer[]
  refunds               Refund[]
  dispute               Dispute?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Transfer {
  id                  String              @id @default(cuid())
  chargeId            String
  destinationStripeId String
  destinationUserId   String
  destinationType     TransferDestination
  amountCents         Int
  reason              TransferReason
  stripeTransferId    String?             @unique
  status              TransferStatus      @default(PENDING)
  scheduledFor        DateTime?
  executedAt          DateTime?
  failureReason       String?
  reversedByRefundId  String?
  // Relations
  charge              Charge              @relation(fields: [chargeId], references: [id])
  destinationUser     User                @relation("TransferDestinationUser", fields: [destinationUserId], references: [id])
  reversedByRefund    Refund?             @relation(fields: [reversedByRefundId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, scheduledFor])
  @@index([chargeId])
}

model Refund {
  id                String            @id @default(cuid())
  chargeId          String
  orderId           String
  stripeRefundId    String            @unique
  amountCents       Int
  reason            RefundReason
  status            RefundStatus      @default(PENDING)
  initiatedByUserId String
  // Relations
  charge            Charge            @relation(fields: [chargeId], references: [id])
  order             Order             @relation(fields: [orderId], references: [id])
  initiatedByUser   User              @relation(fields: [initiatedByUserId], references: [id])
  clawbacks         PartnerClawback[]
  reversedTransfers Transfer[]
  createdAt         DateTime          @default(now())
}

model Dispute {
  id                  String            @id @default(cuid())
  chargeId            String            @unique
  stripeDisputeId     String            @unique
  amountCents         Int
  reason              String
  status              DisputeStatus     @default(NEEDS_RESPONSE)
  evidenceDueBy       DateTime
  evidenceSubmittedAt DateTime?
  resolvedAt          DateTime?
  outcome             String?
  // Relations
  charge              Charge            @relation(fields: [chargeId], references: [id])
  clawbacks           PartnerClawback[]
  createdAt           DateTime          @default(now())
}

// Brand Kit template (docs/BRAND_KIT_PROPOSAL.md, locked Pavel 2026-06-22).
// A reusable packaging/label DESIGN tied to a brand — a starting point a creator
// can spin a new product's label from. Distinct from EditSnapshot (version history):
// a template is an intentional, named, reusable layout. Per-tier COUNT is gated by
// brandLimits(tier) in @ilaunchify/auth (Maker 3 / Builder 15 / Agency unlimited).

model BrandTemplate {
  id              String   @id @default(uuid())
  brandId         String
  name            String
  thumbnailUrl    String? // preview (reuses the Studio snapshot thumbnail capture)
  canvasJson      String // Fabric.js layout JSON — bare String (CockroachDB: no @db.Text)
  packagingTypeId String? // which container this layout targets (optional)
  // === Brand template theming (Phase 3 — docs/BRAND_TEMPLATE_THEMING.md) ===
  // Premium = admin-curated library template (owned by the system templates brand),
  // browsable + recolorable by Agency creators. `tier` is an optional minimum tier
  // to use it. `colorRoles` maps each source hex → a palette role (primary/secondary/
  // accent/neutral) for one-click exact recolor; null = dominant-remap only.
  isPremium       Boolean  @default(false)
  tier            String? // optional minimum tier to use it (e.g. 'agency')
  colorRoles      Json? // { "#A44200": "primary", "#3C1518": "neutral", ... }
  // === Design Template Library (docs/DESIGN_TEMPLATE_LIBRARY.md) ===
  // domain scopes the template to one product regime (a cosmetic product never sees
  // pet styles). Die-line targeting is by GEOMETRY: matchMode EXACT pins to
  // packagingTypeId; SHAPE_FAMILY matches by targetContainerCategory + aspectBucket so
  // one "can wrap" reuses across many cans. targetSurface names the die-line face.
  domain                  LabelingType?
  matchMode               TemplateMatchMode  @default(SHAPE_FAMILY)
  targetContainerCategory ContainerCategory?
  targetTopology          PackagingTopology?
  aspectBucket            AspectBucket?
  targetSurface           String? // die-line surface name (front panel, wrap, …)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  styleAssignments TemplateStyleAssignment[]

  @@index([brandId])
  @@index([isPremium])
  @@index([domain, isPremium])
}

/// Design Template Library (docs/DESIGN_TEMPLATE_LIBRARY.md §5) — the per-domain style
/// taxonomy. ~26–30 styles per domain, clustered into four facet groups. A template
/// carries one primary style (drives grid grouping) + any number of secondary tags via
/// TemplateStyleAssignment. OTC rows seed active=false until the OTC domain is enabled.
model TemplateStyle {
  id        String             @id @default(uuid())
  domain    LabelingType
  facet     TemplateStyleFacet
  slug      String // unique per domain, e.g. 'luxury-premium'
  label     String
  sortOrder Int                @default(0)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  assignments TemplateStyleAssignment[]

  @@unique([domain, slug])
  @@index([domain, active])
}

/// Junction: a template's styles. Exactly one row per template has isPrimary=true (the
/// grouping style); the rest are secondary tags used for filtering/search.
model TemplateStyleAssignment {
  templateId String
  styleId    String
  isPrimary  Boolean @default(false)

  template BrandTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  style    TemplateStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([templateId, styleId])
  @@index([styleId])
  @@index([templateId, isPrimary])
}

/// Creator-uploaded custom brand font (Brand Kit V2 Slice 2, docs/BRAND_KIT_V2_PROPOSAL.md §3b).
/// Referenced from Brand.brandFontIds as `custom:<id>` (catalog families are stored as the
/// bare family string). `family` is both the display name and the CSS fontFamily applied on
/// the canvas; the web asset is loaded via @font-face (loadCustomFont). A print file (OTF/TTF)
/// is recommended for production PDF but optional at design time. Tier-gated (Builder+).
model BrandFont {
  id              String   @id @default(uuid())
  brandId         String
  family          String // display name + CSS fontFamily, e.g. 'Acme Display'
  webAssetId      String // WOFF2/TTF/OTF for browser rendering (→ Asset)
  printAssetId    String? // OTF/TTF for print PDF (recommended, enforced at order time later)
  licenseAttested Boolean  @default(false) // creator attests embedding rights
  createdAt       DateTime @default(now())
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// Brand Kit V2 Slice 3 — a creator-pinned visual asset (a product photo, graphic,
/// or background image) scoped to one brand kit. Surfaces in the Design Studio
/// "Elements → Photos & uploads" rail so the creator can drop their saved brand
/// imagery straight onto the canvas. `kind` groups where it appears; `assetId`
/// points at the uploaded Asset. Distinct from logos (Brand.logo*AssetId) which
/// stay first-class named slots.
model BrandAsset {
  id        String   @id @default(uuid())
  brandId   String
  kind      String // 'IMAGE' | 'GRAPHIC' | 'BACKGROUND' (string for additive flexibility)
  assetId   String // → Asset (the uploaded file)
  label     String?
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// Brand Kit V2 Slice 5 — color V2. A named palette (e.g. "Core", "Seasonal") holding
/// ordered swatches. The legacy flat triad (Brand.colorPrimary/Secondary/Accent +
/// brandSwatches) stays as the canonical brand colors; palettes ADD organized extras.
model BrandPalette {
  id        String        @id @default(uuid())
  brandId   String
  name      String
  sortIndex Int           @default(0)
  createdAt DateTime      @default(now())
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  swatches  BrandSwatch[]

  @@index([brandId])
}

/// A single swatch in a BrandPalette — a solid color or a gradient. hex is the
/// canvas-usable RGB value (and the gradient's preview/fallback). CMYK + Pantone are
/// PRINT-REFERENCE METADATA only (the canvas renders RGB); Pantone is a free-text
/// reference code, never a licensed color library. gradient JSON = { angle, stops:
/// [{ color, pos }] } when kind = GRADIENT.
model BrandSwatch {
  id        String       @id @default(uuid())
  paletteId String
  kind      String       @default("SOLID") // 'SOLID' | 'GRADIENT'
  hex       String? // #RRGGBB
  name      String?
  cmykC     Int? // 0–100
  cmykM     Int?
  cmykY     Int?
  cmykK     Int?
  pantone   String? // reference code, e.g. "PANTONE 200 C"
  gradient  Json? // { angle: number, stops: [{ color: string, pos: number }] }
  sortIndex Int          @default(0)
  createdAt DateTime     @default(now())
  palette   BrandPalette @relation(fields: [paletteId], references: [id], onDelete: Cascade)

  @@index([paletteId])
}

/// Brand text style → font assignment (Brand Kit V2 Slice 2c / 4 foundation). Each
/// brand maps named roles (HEADING / SUBHEADING / BODY …) to a fontKey — a FONT_CATALOG
/// family or a `custom:<id>` ref. Slice 4 adds weight/size/case/color columns; for now
/// it's role→font so "Add to Brand → Heading" assigns exactly which text style a font
/// drives. One row per (brand, role).
model BrandTextStyle {
  id        String   @id @default(uuid())
  brandId   String
  role      String // 'HEADING' | 'SUBHEADING' | 'BODY' (string for additive flexibility)
  fontKey   String // FONT_CATALOG family or `custom:<BrandFont.id>`
  // Slice 4 — the full Canva-style type spec for this role. All optional + additive;
  // null falls back to the canvas default. colorRef is either a hex (#RRGGBB) or a
  // palette token ('primary' | 'secondary' | 'accent') resolved against the brand.
  fontSize      Int? // px
  fontWeight    String? // 'Regular' | 'Medium' | 'SemiBold' | 'Bold' (or numeric '700')
  letterSpacing Float? // em (reserved — applied when the canvas supports it)
  lineHeight    Float? // multiplier (reserved)
  textCase      String? // 'none' | 'uppercase' | 'lowercase' | 'capitalize'
  colorRef      String? // '#RRGGBB' or 'primary' | 'secondary' | 'accent'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, role])
  @@index([brandId])
}

// =============================================================================
// BILLING PROFILE (docs/BILLING_AND_ACCOUNTING.md slice 1)
// =============================================================================
// Invoice/tax contact details shown on the Canva-style "Billing details" surface
// for creators AND partners. This is plain business data the user types — it is
// NOT a payment instrument. Card numbers, bank accounts, CVCs, and tax
// identification numbers (SSN/EIN) are NEVER stored here or anywhere in our DB;
// Stripe holds all of those. `taxId` is a display-only string (e.g. a VAT/GST
// number the user wants printed on invoices), not a government SSN.

model BillingProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  // Appears below the user's name on invoices (business / legal entity name).
  billingContactName String?
  // Free-form structured address used for tax calculation. JSON so we don't fight
  // country-specific address shapes: { line1, line2, city, state, postalCode, country }.
  billingAddress     Json?
  // Display-only tax id string (VAT/GST/business reg). NOT an SSN — never persist a
  // government TIN; Stripe collects those during Connect onboarding.
  taxId              String?
  // Extra emails that should receive billing/invoice copies (array of strings).
  additionalContacts Json?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Display-only mirror of a Stripe PaymentMethod attached to the user's Customer
// (docs/BILLING_AND_ACCOUNTING.md slice 2). The actual card is collected on
// Stripe-hosted Checkout (setup mode) and lives in Stripe — we only persist the
// non-secret display crumbs (brand + last4 + expiry) plus the opaque pm_ id.
// NEVER store a full card number, CVC, or any sensitive authentication data here.

model PaymentMethodRef {
  id                    String   @id @default(uuid())
  userId                String
  stripePaymentMethodId String   @unique
  brand                 String? // e.g. "visa", "mastercard"
  last4                 String? // last 4 digits — safe to display, not a PAN
  expMonth              Int?
  expYear               Int?
  isDefault             Boolean  @default(false)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

// Pointer to a 1099 tax form issued through Stripe Connect Tax Forms
// (docs/BILLING_AND_ACCOUNTING.md slice — partner tax documents). Stripe is the
// filer of record and holds the form + the partner's TIN; the partner views/
// downloads the actual form in their Stripe Express dashboard. We persist ONLY a
// non-sensitive pointer (year, type, Stripe form id, status) so the platform can
// show a "tax documents" list and track filing status. NEVER store the TIN or
// any form content here.

enum TaxDocumentType {
  FORM_1099K // marketplace/third-party network payments (the Etsy-style default)
  FORM_1099NEC // non-employee compensation
}

enum TaxDocumentStatus {
  PENDING // not yet filed/available
  AVAILABLE // generated, ready for the recipient
  DELIVERED // delivered to the recipient (e-delivery or mail)
  CORRECTED // a correction was filed
  VOID // voided
}

model TaxDocument {
  id           String            @id @default(uuid())
  userId       String
  taxYear      Int
  type         TaxDocumentType
  stripeFormId String?           @unique
  status       TaxDocumentStatus @default(PENDING)
  deliveredAt  DateTime?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, taxYear])
}

// =============================================================================
// CART & CONSUMER — REMOVED 2026-05-19
// =============================================================================
// The Cart, CartItem, and ConsumerUser models were removed when the V1 model
// was corrected. iLaunchify is a B2B production marketplace; consumers do not
// buy on iLaunchify — they buy on the creator's external channel (Shopify,
// Amazon, etc.). See docs/STOREFRONT.md.
// =============================================================================

// =============================================================================
// CATALOG: Category → Subcategory → ProductTemplate → Variant + Ingredient Slots
// =============================================================================
// The catalog is the front of the creator funnel. Admin curates ProductTemplates
// per (Sub)category. Each template has BASE ingredient slots — each slot is the
// manufacturer's default ingredient, plus an optional list of allowed
// replacements. Independently, the template offers a pool of OPTIONAL
// ingredients the creator can toggle on. Variants (flavor + packaging combos)
// are orthogonal to ingredients — same recipe, different flavor + bottle size.
// =============================================================================

// ProductTemplate lifecycle per docs/MANUFACTURER_PRODUCT_BUILDER.md §8.1.
// Legacy 4-value enum extended with 5 V1 canonical states. Legacy values are
// preserved for back-compat with rows created before 2026-05-24.
//
// Canonical FSM:
//   DRAFT → PENDING_REVIEW ─Approve─→ PUBLISHED
//                          ─Request changes─→ NEEDS_CHANGES ─Resubmit─→ PENDING_REVIEW
//                          ─Reject─→ REJECTED
//   PUBLISHED ─edit approval-marked field─→ PENDING_EDIT_REVIEW ─Approve─→ PUBLISHED
//   PUBLISHED / PENDING_EDIT_REVIEW ⇄ PAUSED (admin or partner)
//
// Legacy mapping (for back-compat when reading older rows):
//   UNDER_REVIEW → PENDING_REVIEW
//   ARCHIVED     → REJECTED (semantically closest; admin can re-classify)
enum ProductTemplateStatus {
  // V1 canonical (from 2026-05-24 forward)
  DRAFT // manufacturer authoring (same as legacy)
  PENDING_REVIEW // admin queue (first submission of a never-published template)
  NEEDS_CHANGES // admin requested changes via ProductReviewItem checklist
  PUBLISHED // visible in /catalog (same as legacy)
  PENDING_EDIT_REVIEW // changes to a live published template held for admin approval; live version keeps serving
  PAUSED // hidden from marketplace (admin or partner initiated); reversible
  REJECTED // admin rejected; partner can resubmit as new submission
  // Legacy (deprecated; preserved for back-compat)
  UNDER_REVIEW // alias for PENDING_REVIEW
  ARCHIVED // alias for REJECTED
}

// Per-template labeling regime (V1 product-plan additions 2026-06-01).
// Drives which compliance rule pack runs (21 CFR 101.9 food vs 21 CFR 101.36
// supplements vs AAFCO pet vs OTC drug-facts vs cosmetic) AND which "Facts"
// panel renders on the label. Category.mainCategory STAYS — labelingType is
// per-product because a "Beverage" category row covers both Food (RTD juice)
// and Dietary Supplement (RTD nootropic shot).
enum LabelingType {
  FOOD // 21 CFR 101.9 Nutrition Facts panel
  DIETARY_SUPPLEMENT // 21 CFR 101.36 Supplement Facts panel
  PET_PRODUCT // AAFCO Guaranteed Analysis panel
  OTC // 21 CFR 201.66 Drug Facts panel (over-the-counter)
  COSMETIC // 21 CFR 701 cosmetic labeling (no "Facts" panel)
}

// Admin on/off switch for each product domain in the builder (2026-06-14). The
// admin enables/disables which domains a partner can pick in the new-product
// flow. `domain` holds a LabelingType key string. A missing row falls back to the
// code default (DOMAIN_ENABLED_DEFAULTS in @ilaunchify/db). OTC ships disabled —
// the Drug Facts renderer exists but the OTC flow isn't live yet.
model DomainSetting {
  domain    String   @id // FOOD | DIETARY_SUPPLEMENT | PET_PRODUCT | OTC | COSMETIC
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @default(now())
}

// Nutrition Facts audience (21 CFR 101.9(j)(5)) — selects the Daily Value table +
// which %DV columns appear on a FOOD-domain panel. Infant formula (21 CFR 107) is
// NOT here; it is a separate regulated class, deferred.
enum NutritionAudience {
  GENERAL // adults & children ≥ 4 years — standard 2016 panel
  CHILD_1_3 // children 1 through 3 years — 1,000-cal DRV basis
  INFANT_0_12 // infants through 12 months — infant RDIs, no sat fat/chol/sodium DV
}

// =============================================================================
// PACKING TOPOLOGY
// =============================================================================
// One axis is *what's inside* the product (ingredient slots + variants for
// flavor). A second, orthogonal axis is *how it's packaged*: a single can, a
// 6-pack, a sampler box, a customer-picked variety set, a subscription delivery.
//
// Per Pavel's spec, 14 packing types are needed at V1 to describe every product
// SKU type the platform serves. Each ProductTemplateVariant declares one
// PackingType plus structured fields that describe the topology (how many inner
// packs, mixed vs. separated flavor arrangement, customer-pick parameters,
// subscription cadence). The remainder lives in `packingConfig` JSON.
// =============================================================================

enum PackingType {
  SINGLE_FLAVOR_SINGLE_PACK // 1 can of cola, 1 jar of apple puree
  SINGLE_FLAVOR_MULTIPACK // 6-pack same flavor, 12-pack same flavor
  MULTI_FLAVOR_MIXED_PACK // fruit-salad gummies (all flavors in one bag)
  MULTI_FLAVOR_COMPARTMENT_PACK // chocolate bar with milk/white/dark sections
  MULTI_FLAVOR_INDIVIDUAL_IN_OUTER // variety ramen 4-pack (each flavor in own bag, in one box)
  CUSTOMIZABLE_PICK_N // pick 6 of 24 beer flavors; pick 10 protein bars from 5 flavors
  SAMPLER_MINI // mini hot-sauce sampler (5 small bottles, different flavors)
  SUBSCRIPTION_ROTATING // monthly coffee, rotating flavors
  GIFT_PREMIUM // luxury chocolate box, gourmet gift tin
  VALUE_BULK_SINGLE // 50-pack same flavor, 10kg bag dog food
  VALUE_BULK_VARIETY // 10 variety packs each with 3 flavors (bulk)
  SEASONAL_LIMITED // pumpkin spice set, Christmas dog treats
  PAIRING_FUNCTIONAL // coffee + creamer set, pre + post-workout
  RETAIL_COUNTER_DISPLAY // counter tray, clip strip — one SKU for retailer
  REFILL_ECO // reusable container + replaceable concentrates
}

enum FlavorArrangement {
  SINGLE // one flavor (or unflavored)
  MIXED // flavors blended/scattered in the same vessel
  SEPARATED // flavors physically separated (compartments, individual inner packs)
}

model Category {
  id                     String        @id @default(cuid())
  externalId             String        @unique // imported from FOD: 1c513f19-…
  name                   String // "Snacks & Confectionery"
  slug                   String        @unique
  description            String?
  mainCategory           String // "Food" | "Beverages" | "Supplements" | "Other"
  // Product domain this category belongs to — drives the New Product flow:
  // a product can only be filed under categories whose labelingType matches the
  // product's chosen domain (FOOD / DIETARY_SUPPLEMENT / COSMETIC / PET_PRODUCT).
  // Subcategories inherit this via their parent category.
  labelingType           LabelingType  @default(FOOD)
  icon                   String? // emoji or short string
  color                  String? // hex
  displayOrder           Int           @default(0)
  isActive               Boolean       @default(true)
  // Regulatory hooks — which rule pack applies + required label elements
  regulatoryRequirements Json?
  designRestrictions     Json?
  subcategories          Subcategory[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model Subcategory {
  id               String             @id @default(cuid())
  externalId       String             @unique
  categoryId       String
  name             String
  slug             String             @unique
  description      String?
  displayOrder     Int                @default(0)
  isActive         Boolean            @default(true)
  // Packaging defaults (sizes, materials, container types) — informs variants
  packagingOptions Json?
  category         Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productTemplates ProductTemplate[]
  // 2026-06-02 V1.1 marketplace taxonomy — Layer 2 ↔ Layer 1 junction
  niches           NicheSubcategory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([categoryId])
}

enum RecipeEntryMode {
  SEARCH_BUILD // Mode 1 — pick ingredients one at a time
  AI_PARSER // Mode 2 — paste a recipe, AI matches each line
  DECLARED_PANEL // Mode 3 — type the Nutrition/Supplement Facts directly
}

// Mode 3 (Slice 4) — where a product's nutrition panel comes from. COMPUTED =
// platform-derived from the recipe slots. DECLARED = manufacturer-entered (the
// "Declared by manufacturer" disclosure is the FDA_REGULATORY_POSTURE §5 bridge).
enum NutrientSource {
  COMPUTED
  DECLARED
}

model ProductTemplate {
  id                         String                        @id @default(cuid())
  subcategoryId              String
  manufacturerServiceId      String? // null until manufacturer self-builder ships (V1.1)
  status                     ProductTemplateStatus         @default(DRAFT)
  // Primary recipe entry method (analytics). Nullable: legacy templates have no
  // recorded method. The FIRST method that adds a slot owns this — never
  // overwritten (Slice 2, docs/builds/ingredients-mode-chooser-slice-2.md).
  recipeEntryMode            RecipeEntryMode?
  // Mode 3 (Slice 4). COMPUTED = platform-summed from slots (default).
  // DECLARED = manufacturer-entered panel; declaredPanel holds the typed
  // PanelData + ingredient statement + net quantity + allergens.
  nutrientSource             NutrientSource                @default(COMPUTED)
  declaredPanel              Json?
  name                       String // "Whey Protein Powder"
  description                String?
  slug                       String                        @unique
  // Price floor — lowest the creator can list at (covers manuf cost + print + fee + margin floor)
  priceFloorCents            Int                           @default(0)
  // Estimated unit cost to platform (manuf's price for one base unit) — used by routing
  unitCostCents              Int                           @default(0)
  imageAssetId               String? // hero image (Asset id)
  // Media gallery (2026-06-08): up to 6 additional images + 1 video. Asset ids;
  // resolved to URLs for display. Hero (imageAssetId) + these = 8 total.
  galleryAssetIds            String[]
  videoAssetId               String?
  // Optional: snapshot of base nutrition (BASE ingredients only) for fast catalog display
  baseNutritionSnapshot      Json?
  // V1 — per docs/MANUFACTURER_PRODUCT_BUILDER.md
  pendingEditPayload         Json? // proposed edits while in PENDING_EDIT_REVIEW; live row keeps serving
  finishedProductWeightG     Int? // derived from slots; cached for shipping calc
  customMeta                 Json? // partner-supplied key/value pairs ([{key,value}] max 10)
  allergenCrossContamination String? // partner-input cross-contamination statement
  allergenManualOverrides    Json? // [{ allergen, reason }] for manual additions
  // V1 — Recipal-parity additions per docs/MANUFACTURER_PRODUCT_BUILDER.md §4a.5c + §4a.5d
  nutrientOverrides          Json? // [{ nutrient, value, reason }] — applied after sum, before rounding
  ingredientGroups           Json? // [{ groupName, ingredientIds[], displayMode, sortAs }] for FDA-allowed grouping ('Spices', 'Natural Flavors')
  // V1 — product-plan additions 2026-06-01.
  // labelingType: per-template label regime (Food / Supplement / Pet / OTC / Cosmetic).
  // Drives rule pack selection + which "Facts" panel renders. Default FOOD because
  // the catalog skews food/beverage; partners flip to SUPPLEMENT or PET in the editor.
  labelingType               LabelingType                  @default(FOOD)
  // labelingType lock (2026-06-07). The panel regime is DERIVED from the
  // template's ProductCategory (FOOD→Nutrition Facts, DIETARY_SUPPLEMENT→
  // Supplement Facts, OTC→Drug Facts, COSMETIC→INCI, PET_PRODUCT→Guaranteed
  // Analysis) and locked in the editor so partners can't pick a mismatched
  // panel. true = control disabled, value follows category. An admin override
  // sets this false and may hand-set labelingType.
  labelingTypeLocked         Boolean                       @default(true)
  // Target audience for FOOD-domain Nutrition Facts. Drives the panel VARIANT per
  // 21 CFR 101.9(j)(5): GENERAL (≥4 yrs, standard panel), CHILD_1_3 (children 1–3,
  // own DV table), INFANT_0_12 (infants 0–12 mo, infant RDIs + suppressed fat/chol
  // %DV). Same recipe → engine recomputes %DV against the age-group DV table.
  intendedAgeGroup           NutritionAudience             @default(GENERAL)
  // D5 (ROUTING_BINDING_MODEL.md §6/§9) — multi-flavor lead time. Manufacturer
  // declares whether the line runs flavors sequentially. Default false = parallel
  // (variety-pack lead time = single-flavor band time, the common case).
  flavorsRunSequentially     Boolean                       @default(false)
  // Non-food formulation payload (Phase 1, docs/PRODUCT_DOMAINS_ARCHITECTURE.md).
  // Supplements/cosmetics/pet don't fit the food TemplateIngredientSlot model, so
  // their formulation is stored here keyed by domain, e.g.
  // { supplement: { dietaryIngredients[], blends[], servingForm, servingsPerContainer } }.
  // Additive + optional; null for food templates (which use recipe slots).
  formulationData            Json?
  // ---- Retail identity (template level) ----
  // Default FDA Statement of Identity (the food's common/usual name, 21 CFR
  // 101.3) for templates with no flavors. Per-flavor SoI overrides live on
  // FlavorPreset. Intentionally distinct from `name` (the marketplace title).
  statementOfIdentity        String?
  // Optional manufacturer product-family / style code grouping sibling
  // templates+variants (e.g. "PRO-WHEY"). Not a retail identifier — purely
  // the manufacturer's internal grouping. Nullable, non-unique. Also the base
  // SKU that seeds per-variant SKUs in the guided builder.
  familyCode                 String?
  // Turnkey builder (2026-06-08): coarse derived group (deprecated in favor of
  // packingType below, the admin-curated source of truth).
  productType                ProductType                   @default(SINGLE)
  // Admin-curated packing taxonomy — the structural keystone. Drives the recipe
  // shape (flavorMode), label columns, and pack structure. Chosen at the first
  // gate of the builder, then locked once the recipe is authored.
  packingProfileId           String?
  packingProfile             PackingProfile?               @relation(fields: [packingProfileId], references: [id])
  // Multi-flavor variety cap (2026-06-08). For multi-flavor packing types the
  // manufacturer lists the full flavor pool (FlavorPreset rows) but caps how
  // many DISTINCT flavors a Creator may combine into one pack. Null = no cap
  // (Creator can use the whole pool). The marketplace pack-builder enforces it.
  maxFlavorsPerPack          Int?
  // ---- Configurator constraints (docs/PRODUCT_CONFIGURATOR_CONSTRAINTS.md, 2026-06-08) ----
  // #3 first-run vs repeat economics. Repeat = standard re-order lead time;
  // firstRun = new-SKU lead time (incl. stability testing). Seed per-variant
  // leadTimeDays. One-time / per-unit fees live on ProductTemplateFee.
  leadTimeRepeatDays         Int?
  leadTimeFirstRunDays       Int?
  // #4 storage / temperature class — drives WAREHOUSE routing + shipping.
  storageClass               StorageClass                  @default(AMBIENT)
  storageTempMinF            Int?
  storageTempMaxF            Int?
  // Detail-page long description (Basics short = `description`).
  longDescription            String?
  // Marketplace detail-page marketing copy (format, productionMethod, netWeight,
  // performanceBullets, properties, sizeChart, packingSpecs, …). A partial
  // TemplateDetail JSON, merged OVER the per-slug fixture by the marketing detail
  // loader so real templates carry their own copy. Null = use the fixture/generic.
  // V1: populated by seed; V1.1 gets an admin editor.
  marketingDetail            Json?
  // ---- Marketplace filter dimensions (docs/MARKETPLACE_DESIGN.md §7, 2026-06-18) ----
  // Format (Layer 3) — single physical production form. Null = unspecified.
  manufacturingFormat        ManufacturingFormat?
  // Manufacturing process tags (More-filters): 'cold-pressed','freeze-dried',
  // 'fermented','encapsulated',… Free-form slugs, admin/seed-curated, hasSome filter.
  manufacturingProcesses     String[]
  // Explicit allergen-free CLAIMS (More-filters): 'dairy-free','gluten-free',
  // 'nut-free','soy-free','egg-free',… Admin-set claim, NOT inferred from the
  // recipe (absence of data ≠ free-from). hasSome filter.
  allergenFreeClaims         String[]
  // Markets the template is available in (filter "Market"). Codes mirror
  // Market.code ('US','CA','EU'). Default US for V1 (US-only ACTIVE). hasSome filter.
  marketCodes                String[]                      @default(["US"])
  // Marketplace rating (2026-06-18). ratingAvg is 0–5 (null = no rating yet →
  // card/detail show "New" rather than a fabricated score); ratingCount is the
  // number of ratings. V1: admin/seed-curated; a future Review model writes
  // these aggregates from real buyer reviews.
  ratingAvg                  Float?
  ratingCount                Int                           @default(0)
  // C4 — grace-window marker: a cert attached to this product expired; product
  // needs a refreshed cert. Null = healthy.
  certRefreshNeededAt        DateTime?
  // Phrase engine (2026-06-05) — free-form manufacturer-answered product-fact
  // flags, e.g. {makesStructureFunctionClaims:true}. Consumed by PhraseRule
  // conditions of kind PRODUCT_FACT.
  phraseFacts                Json?
  // Relations
  subcategory                Subcategory                   @relation(fields: [subcategoryId], references: [id])
  manufacturerService        PartnerService?               @relation(fields: [manufacturerServiceId], references: [id])
  ingredientSlots            TemplateIngredientSlot[]
  optionalIngredients        TemplateOptionalIngredient[]
  variants                   ProductTemplateVariant[]
  products                   Product[]
  // V1 new relations (manufacturer product builder)
  packagingSystems           ProductTemplatePackaging[]
  certificates               ProductCertificate[]
  reviewItems                ProductReviewItem[]
  notes                      ProductNote[]
  flavorPresets              FlavorPreset[]
  // Configurator constraints (docs/PRODUCT_CONFIGURATOR_CONSTRAINTS.md, 2026-06-08)
  optionAxes                 ProductOptionAxis[]
  optionRules                ProductOptionRule[]
  fees                       ProductTemplateFee[]
  sampleOptions              ProductSampleOption[]
  specSheets                 ProductSpecSheet[]
  changeApprovalRules        ProductChangeApprovalRule[]
  // V1 — product-plan additions 2026-06-01.
  pricingTiers               ProductTemplatePricingTier[]
  niches                     ProductTemplateNiche[]
  // 2026-06-02 V1.1 marketplace taxonomy — Layer 4 lifestyle tags
  lifestyleTags              ProductTemplateLifestyleTag[]
  nicheAssignmentAudits      NicheAssignmentAudit[]
  // Phrase engine (2026-06-05)
  phrases                    ProductTemplatePhrase[]
  phraseAssignmentAudits     PhraseAssignmentAudit[]
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@index([subcategoryId, status])
  @@index([familyCode])
}

// Physical production form of a template (marketplace "Format" filter, Layer 3
// Manufacturing Formats). Single-select per template; a flat cross-domain set
// (food / supplement / beverage / cosmetic) the UI groups for display. Additive
// 2026-06-18.
enum ManufacturingFormat {
  POWDER
  CAPSULE
  TABLET
  SOFTGEL
  GUMMY
  SOFT_CHEW
  LIQUID
  READY_TO_DRINK
  CONCENTRATE
  EFFERVESCENT
  BAR
  CREAM
  LOTION
  SERUM
  OIL
  BALM
  SPRAY
  OTHER
}

// One slot per BASE ingredient. The base is the default; replacements[] are
// alternatives the creator can swap in.
model TemplateIngredientSlot {
  id                        String                          @id @default(cuid())
  productTemplateId         String
  baseIngredientId          String // default ingredient
  weightG                   Decimal // grams in the base recipe (per batch)
  costPerKgCents            Int? // manufacturer's ingredient cost (¢ per kg) — drives the recipe cost summary
  displayOrder              Int                             @default(0)
  // Manufacturer can lock specific slots from replacement (e.g. structural fillers)
  allowReplacement          Boolean                         @default(true)
  // Display hints
  label                     String? // optional override of the ingredient name in UI
  description               String?
  // Relations
  productTemplate           ProductTemplate                 @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  baseIngredient            Ingredient                      @relation("SlotBaseIngredient", fields: [baseIngredientId], references: [id])
  replacements              TemplateIngredientReplacement[]
  filledByRecipeIngredients RecipeIngredient[] // back-relation for source tracking

  @@index([productTemplateId])
}

model TemplateIngredientReplacement {
  id              String                 @id @default(cuid())
  slotId          String
  ingredientId    String // the swap option
  // Optional weight override (e.g., monk fruit at 1g replaces sugar at 30g for equivalent sweetness)
  weightGOverride Decimal?
  displayOrder    Int                    @default(0)
  // Display hints
  calloutText     String? // "Lower glycemic alternative"
  // Relations
  slot            TemplateIngredientSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  ingredient      Ingredient             @relation("ReplacementIngredient", fields: [ingredientId], references: [id])

  @@unique([slotId, ingredientId])
  @@index([slotId])
}

// Independent pool of ingredients the creator can OPTIONALLY add.
// Toggled on/off as a whole — no per-creator weight tweaking in V1.
model TemplateOptionalIngredient {
  id                String          @id @default(cuid())
  productTemplateId String
  ingredientId      String
  weightG           Decimal // grams added when toggled on
  displayOrder      Int             @default(0)
  calloutText       String? // "Adds 200mg L-Theanine for calm focus"
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  ingredient        Ingredient      @relation("OptionalIngredient", fields: [ingredientId], references: [id])

  @@unique([productTemplateId, ingredientId])
  @@index([productTemplateId])
}

// One row per sellable SKU configuration: a particular combination of flavor
// content + container + packing topology. The same ProductTemplate can offer
// (Tropical Citrus 12oz single can), (6-pack of Tropical), (mixed 6-pack
// 3×Tropical+3×Berry), (pick-12-from-24 customizable case), etc. — each a
// distinct variant.
model ProductTemplateVariant {
  id                String @id @default(cuid())
  productTemplateId String

  // ---- Flavor + container (the consumed product) ----
  flavor               String? // "Vanilla" / "Chocolate" — null for unflavored or multi-flavor
  containerFormat      String // "12oz can" / "60-count capsule bottle" / "250g pouch"
  containerSizeG       Decimal? // total contents weight inside one container
  servingsPerContainer Int
  servingSizeG         Decimal // grams per serving
  servingSizeDesc      String? // "1 scoop (30g)"

  // ---- Packing topology (orthogonal to flavor/container) ----
  packingType          PackingType       @default(SINGLE_FLAVOR_SINGLE_PACK)
  flavorArrangement    FlavorArrangement @default(SINGLE)
  // Number of INDIVIDUAL packs inside one sellable outer pack (a 6-pack = 6).
  // 1 = single pack (no outer). For VARIETY_BULK use innerPacksPerOuter for the
  // inner-pack count and outerPacksPerCase for the case count.
  innerPacksPerOuter   Int               @default(1)
  outerPacksPerCase    Int               @default(1)
  // CUSTOMIZABLE_PICK_N: consumer picks `customerPicksCount` flavors from a pool
  // (the pool is the set of sibling variants of the same template).
  customerPicksCount   Int?
  // SUBSCRIPTION_ROTATING: "monthly", "weekly", "quarterly"
  subscriptionInterval String?
  // For MULTI_FLAVOR_MIXED / SEPARATED / SAMPLER / VARIETY_BULK / SEASONAL etc:
  // structured list of contained flavors with per-flavor quantities.
  // Example: [{"flavor":"Vanilla","qty":2},{"flavor":"Chocolate","qty":4}]
  assortmentFlavors    Json?
  // Free-form extras (retail-display dimensions, refill-pod ml, etc.)
  packingConfig        Json?

  // ---- Retail identity (per sellable SKU configuration) ----
  // The SKU/GTIN belong here, not on FlavorPreset: a single can vs a 6-pack of
  // the SAME flavor are different sellable units. SoI (the food's common name)
  // is per-recipe and lives on FlavorPreset / ProductTemplate.
  sku        String? // manufacturer stock-keeping unit for this exact config
  gtin       String?    @unique // UPC-A(12)/EAN-13(13)/EAN-8(8)/ITF-14(14)
  gtinSource GtinSource @default(USER_PROVIDED)

  // ---- Commercial ----
  moqMin                Int  @default(500)
  moqMax                Int  @default(5000)
  leadTimeDays          Int  @default(28)
  // Per-variant cost override (a 6-pack costs more than a single can to produce)
  unitCostCentsOverride Int?

  // ---- Production & availability (turnkey builder, 2026-06-08) ----
  // GTIN is intentionally NOT here for the manufacturer flow — retail barcodes
  // are the Creator's (brand of record). SKU above is the manufacturer's
  // internal stock-keeping id (production / inventory / lot / fulfillment line).
  fulfillmentMode  FulfillmentMode?
  monthlyCapacity  Int? // monthly production capacity cap (units)
  shelfLifeDays    Int?
  orderIncrement   Int              @default(1) // order step above MOQ
  lotTracking      Boolean          @default(true)
  facilityId       String? // which PartnerFacility produces this variant
  facility         PartnerFacility? @relation(fields: [facilityId], references: [id])

  // ---- Visual ----
  dieCutTemplateId String?
  isActive         Boolean @default(true)

  // ---- C8 — canonical container link (drives marketplace decoration offerings) ----
  // Optional FK to the PackagingType catalog. When set, the marketplace surfaces
  // the PartnerPackagingOfferings for this container type (decoration choices).
  packagingTypeId String?

  // Relations
  productTemplate ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  dieCutTemplate  DieCutTemplate? @relation(fields: [dieCutTemplateId], references: [id])
  packagingType   PackagingType?  @relation(fields: [packagingTypeId], references: [id])
  products        Product[]
  createdAt       DateTime        @default(now())

  @@unique([productTemplateId, sku])
  @@index([productTemplateId, isActive])
  @@index([packingType])
}

// ============================================================================
// Phase A — Verification + Files + Audit Log
// See docs/FOD_RECOVERY_PLAN.md §6 for context.
// ============================================================================

// 4-section verification model (per Pavel decision 2026-05-19, keeping FOD's
// taxonomy). Each section is independently reviewed by an admin with notes;
// overall Partner.status is computed from the section statuses:
//   - any REJECTED      → Partner.status = SUSPENDED (admin manual)
//   - any NEEDS_CHANGES → Partner.status = IN_PROGRESS (partner must fix)
//   - all VERIFIED      → Partner.status = ACTIVE (admin manual approve)
//   - else              → Partner.status = UNDER_REVIEW (initial submit)
enum VerificationSectionType {
  BUSINESS // Legal name, registration, EIN/VAT, addresses, KYB
  FACILITY // Production capabilities, certifications, MOQ, lead time
  DOCUMENTS // Uploaded compliance docs (license, insurance, cert PDFs)
  PUBLIC_PROFILE // Public-facing brand info (logo, description, badges)
  OPERATIONAL_STANDARDS // 5-section model addition per docs/PARTNER_ONBOARDING.md §5 + #159
}

enum VerificationSectionStatus {
  PENDING // Not yet reviewed
  VERIFIED // Approved by admin
  NEEDS_CHANGES // Admin requested edits; partner can resubmit this section
  REJECTED // Permanently rejected (rare; usually leads to suspension)
}

model PartnerVerificationSection {
  id           String                    @id @default(cuid())
  partnerId    String
  type         VerificationSectionType
  status       VerificationSectionStatus @default(PENDING)
  adminNotes   String? // Internal note shown to partner verbatim
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  partner    Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  verifiedBy User?         @relation("VerificationSectionVerifier", fields: [verifiedById], references: [id])
  files      PartnerFile[] // files attached to this section

  @@unique([partnerId, type]) // exactly one row per (partner, section)
  @@index([status])
}

// Partner-uploaded files, stored on R2 (per Pavel decision 2026-05-19).
// The r2Key is the canonical storage path; we generate signed URLs on read.
// Files are grouped by sectionType so the admin verification queue can show
// "all DOCUMENTS-section files for this partner" in one place.
enum PartnerFileKind {
  CERTIFICATE // ISO, BRC, SQF, organic, kosher, etc.
  BUSINESS_LICENSE
  INSURANCE
  FACILITY_PHOTO
  LOGO
  KYB_ID // Beneficial owner ID (driver's license, passport)
  CERT_OF_INCORPORATION
  PRODUCT_SAMPLE // For verification (photos of finished goods)
  DIELINE // Uploaded die-line file (PDF/AI) for the frame editor backdrop
  OTHER
}

model PartnerFile {
  id               String                  @id @default(cuid())
  partnerId        String
  sectionType      VerificationSectionType // which verification section this file belongs to
  sectionId        String? // optional FK to the specific PartnerVerificationSection row
  kind             PartnerFileKind
  r2Key            String                  @unique // bucket-relative path
  originalFilename String
  contentType      String // MIME type
  sizeBytes        Int
  uploadedById     String // who uploaded (partner user)
  uploadedAt       DateTime                @default(now())

  partner    Partner                     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  section    PartnerVerificationSection? @relation(fields: [sectionId], references: [id])
  uploadedBy User                        @relation("PartnerFileUploader", fields: [uploadedById], references: [id])
  // Slice C9 Phase 1 — dielines whose original uploaded file links here.
  dielines   PackagingDieline[]

  @@index([partnerId, sectionType])
  @@index([partnerId, kind])
}

// AuditLog — every state transition on User, Partner, PartnerService, Order,
// OrderDispatch, etc. Per Pavel decision 2026-05-19, system-driven transitions
// (Stripe webhooks, scheduled cron) log with actorRole=SYSTEM so we have a
// complete forensic trail.
//
// Writers should use logAudit() from @ilaunchify/audit rather than touching this
// model directly — that helper handles actor resolution + payload serialization.
enum AuditActorRole {
  ADMIN
  CREATOR
  PARTNER
  SYSTEM // Webhook handlers, cron jobs, migrations
}

model AuditLog {
  id         String         @id @default(cuid())
  actorId    String? // null when actorRole=SYSTEM
  actorRole  AuditActorRole
  // Admin RBAC sub-role of the actor when known (docs/ADMIN_RBAC.md P4.1) —
  // answers "which kind of admin did this". Null for non-admin / unknown.
  actorAdminRole AdminRole?
  // Entity identification
  entityType String // "Partner" / "OrderDispatch" / "PartnerVerificationSection" etc.
  entityId   String // the affected row's id
  // What happened
  action     String // "ACTIVATE" / "SUSPEND" / "VERIFY_SECTION" / "MARK_SHIPPED" etc.
  fromValue  String? // previous state when applicable (status enum value, etc.)
  toValue    String? // new state when applicable
  // Free-form context — sources can stash anything (decline reason, admin notes, etc.)
  payload    Json?
  at         DateTime       @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, at]) // history for a single entity
  @@index([actorId, at]) // what did this user do
  @@index([at]) // time-range queries
}

// ============================================================================
// Phase B — Notifications
// See docs/FOD_RECOVERY_PLAN.md §4 (B1).
// ============================================================================

// Channels users can receive notifications on. EMAIL goes through Resend;
// IN_APP is the bell/notification center inside the app.
enum NotificationChannel {
  EMAIL
  IN_APP
}

// V1 event taxonomy — keep small and meaningful. Each maps to a templated
// title + body in packages/notifications/src/templates.ts.
enum NotificationEvent {
  // Partner-facing
  SECTION_VERIFIED // admin approved one of their verification sections
  SECTION_NEEDS_CHANGES // admin requested partner edit a section
  PARTNER_ACTIVATED // welcome / fully approved
  PACKAGING_APPROVED // admin published a submitted packaging into the Library catalog
  PACKAGING_REJECTED // admin declined a submitted packaging (see notes)
  DISPATCH_RECEIVED // new order dispatch needs partner action
  DISPATCH_ACCEPT_REMINDER // accept window is closing soon (defer to V1.1)
  PARTNER_ORDER_DISPUTED // a creator opened a quality dispute on the partner's order
  // Phase H4 — creator-facing workflow events
  CREATOR_DISPATCH_ACCEPTED // a partner accepted one of the creator's dispatches
  CREATOR_DISPATCH_CHANGES_REQUESTED // partner filed structured change request
  CREATOR_DISPATCH_DECLINED // partner declined (auto-reroute in progress for non-manufacturer)
  CREATOR_DISPATCH_WITHDRAWN // partner withdrew after acceptance
  CREATOR_ORDER_FULLY_ACCEPTED // all partners signed off → production starting
  CREATOR_ORDER_CANCELLED_BY_MANUFACTURER // manufacturer reject = order killed
  CREATOR_PAYMENT_FAILED // tier subscription payment failed → grace period started
  CREATOR_SUBSCRIPTION_DOWNGRADED // grace expired unpaid → downgraded to Maker
  // Admin-facing
  PARTNER_APPLIED // new lead arrived
  PARTNER_SUBMITTED // partner finished onboarding, ready for review
  ORDER_NEEDS_ATTENTION // order moved to ON_HOLD / DISPUTED (defer to V1.1)
  // Phase H4 — admin needs visibility on manufacturer-cancel + withdrawal
  ADMIN_ORDER_CANCELLED_BY_MANUFACTURER
  ADMIN_DISPATCH_WITHDRAWN
  // Cancellation / dispute review outcomes (docs/NOTIFICATIONS-order-lifecycle.md)
  CREATOR_ORDER_CANCELLED // a creator's order was cancelled (admin approved a request)
  CREATOR_ORDER_DISPUTE_RESOLVED // admin resolved/rejected the creator's dispute
  PARTNER_CANCELLATION_REVIEWED // the requesting partner's cancellation was approved/denied
  // C4 — certificate expiry tracking
  CERT_EXPIRING_SOON
  CERT_EXPIRED
  ADMIN_CERT_EXPIRED_ON_PUBLISHED
  // W2-SUP — internal support ticketing (SUPPORT_TICKETING_PLAN.md §4.3)
  SUPPORT_TICKET_CREATED // → category assignee, else all admins
  SUPPORT_TICKET_REPLIED // → the other side of the thread
  SUPPORT_TICKET_RESOLVED // → requester
  SUPPORT_TICKET_REOPENED // → assignee (or category default)
  SUPPORT_SLA_BREACHED // → assignee (or category default)
  SUPPORT_REFUND_REQUESTED // → admins with refunds:approve (RBAC P3)
}

// One row per delivered (or queued) notification, per channel. EMAIL and IN_APP
// each get their own row so we can independently track read state vs. send state.
model Notification {
  id          String              @id @default(cuid())
  userId      String
  event       NotificationEvent
  channel     NotificationChannel
  // Display
  title       String // e.g. "Acme Foods approved"
  body        String? // longer description
  link        String? // app-relative URL (e.g. "/my-application")
  // Channel-specific state
  emailSentAt DateTime? // when Resend confirmed send
  emailError  String? // truncated error if send failed
  readAt      DateTime? // in-app read state
  // Free-form context (entity ids the receiver may want to navigate to)
  payload     Json?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt]) // unread feed query
  @@index([userId, createdAt]) // chronological feed
  @@index([event])
}

// Per-user per-event per-channel opt-out. Default: enabled. Rows are upserted
// only when the user explicitly toggles a preference; absent rows are treated
// as enabled by the dispatcher.
model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  event     NotificationEvent
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event, channel])
}

// ============================================================================
// CHANNELS — V1 shell, V1.1+ adds real OAuth + listing push
// ============================================================================
// Per the 2026-05-19 model correction, iLaunchify is a B2B production
// platform. After production is delivered, creators push finished SKUs to
// their external sales channels (Shopify, Amazon, Etsy, etc.) for consumer
// purchases. V1 ships these models + an admin toggle UI so the registry
// exists; the real OAuth flow + Push-to-Channel actions land in V1.1+.

// Admin-managed registry. One row per channel iLaunchify supports.
// Admin sets `enabled` to expose a channel in creator UI; toggling off
// hides it for new connections (existing ChannelConnections remain).
model Channel {
  id              String               @id @default(cuid())
  code            String               @unique // "shopify", "amazon", "woocommerce", "etsy", "walmart", "tiktok"
  displayName     String // human-facing label
  logoUrl         String?
  enabled         Boolean              @default(false)
  // True once the platform-level OAuth app credentials are set in env
  // (Shopify Client ID/Secret, Amazon SP-API creds, etc.). Until true,
  // the channel can be enabled but creators can't actually connect.
  oauthConfigured Boolean              @default(false)
  // Free-form notes admin can leave for ops
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  // Relations
  connections     ChannelConnection[]
  productLinks    ChannelProductLink[]
}

// Per-creator OAuth connection to one channel. V1: row exists only as
// a placeholder; access/refresh tokens are not yet populated. V1.1 adds
// the OAuth flow that fills these.
model ChannelConnection {
  id                String                  @id @default(cuid())
  channelId         String
  creatorUserId     String
  // External account identifier (shop domain for Shopify, seller_id for Amazon, etc.)
  externalAccountId String?
  // OAuth tokens (V1.1+) — referenced by handle, not stored raw here
  accessTokenRef    String? // pointer to secret store
  refreshTokenRef   String?
  scopes            String[]                @default([])
  status            ChannelConnectionStatus @default(NOT_CONNECTED)
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  // Relations
  channel           Channel                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator           User                    @relation("CreatorChannelConnections", fields: [creatorUserId], references: [id], onDelete: Cascade)
  productLinks      ChannelProductLink[]

  @@unique([channelId, creatorUserId]) // one connection per (channel, creator)
}

enum ChannelConnectionStatus {
  NOT_CONNECTED // placeholder row before OAuth
  CONNECTED // active, tokens valid
  TOKEN_EXPIRED // needs reconnect
  DISCONNECTED // creator revoked
  ERROR // last sync failed
}

// Per-product → external listing mapping. Created when a creator clicks
// "Push to channel" for a delivered product. The external listing id is
// what the channel returned after creating the listing.
model ChannelProductLink {
  id                  String                   @id @default(cuid())
  channelId           String
  channelConnectionId String
  productId           String
  externalListingId   String // Shopify product_id, Amazon ASIN, etc.
  externalUrl         String? // direct link to the listing
  status              ChannelProductLinkStatus @default(ACTIVE)
  lastPushedAt        DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  // Relations
  channel             Channel                  @relation(fields: [channelId], references: [id])
  channelConnection   ChannelConnection        @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  product             Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([channelId, productId]) // one link per (channel, product)
  @@index([channelConnectionId])
}

enum ChannelProductLinkStatus {
  ACTIVE // listing live on the channel
  ARCHIVED // unpublished from the channel
  ERROR // last push failed
}

// =============================================================================
// MARKETS & REGIONS — V1 (US-only ACTIVE; CA seeded COMING_SOON; EU V2)
// Spec: docs/MARKETS_AND_REGIONS.md
// =============================================================================
//
// Two distinct concepts:
//   Market = regulatory + commercial jurisdiction (drives label rules, allergen
//            policy, language requirements, currency, rule pack selection)
//   Region = physical location (drives shipping, lead time, partner-proximity
//            matching, freight zones)
//
// V1 seed:
//   - 1 ACTIVE Market: "US" (FDA)
//   - 1 COMING_SOON Market: "CA" (CFIA, hidden from selection)
//   - 1 Language: "en-US"
//   - Region tree: 1 country (US) + 5 sub-regions (NE/SE/MW/SW/NW per Census)
//     + 50 STATE_PROVINCE rows linked to parent sub-regions

enum MarketStatus {
  ACTIVE // selectable by partners/brands; products can target it
  COMING_SOON // seeded but hidden from selection (admin can preview)
  DEPRECATED // no new selections; existing relations preserved
}

enum RegionKind {
  COUNTRY // 'US', 'CA'
  SUBNATIONAL_GROUP // 'US-NE', 'US-SE' (Census Bureau divisions)
  STATE_PROVINCE // 'US-CA', 'US-NY' (or CA provinces)
  METRO // V1.1+ — major metro areas for finer proximity
}

enum PartnerMarketStatus {
  ACTIVE // certification verified, in date
  LAPSED // expired; partner notified, soft-suspended for this market
  REVOKED // admin revoked; permanent
}

// -----------------------------------------------------------------------------
// Language + MarketLanguage — supports bilingual jurisdictions (CFIA EN+FR)
// -----------------------------------------------------------------------------

model Language {
  id          String           @id // 'en-US', 'fr-CA', 'es-MX'
  code        String // 'en', 'fr', 'es'
  name        String // 'English (US)'
  region      String? // 'US', 'CA'
  isActive    Boolean          @default(true)
  marketLinks MarketLanguage[]
  defaultIn   Market[]         @relation("DefaultLanguage")
}

model MarketLanguage {
  id           String   @id @default(cuid())
  marketId     String
  languageId   String
  isDefault    Boolean  @default(false)
  isRequired   Boolean  @default(false) // CFIA Canada requires EN+FR
  displayOrder Int      @default(0)
  market       Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  language     Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([marketId, languageId])
}

// -----------------------------------------------------------------------------
// MarketConfig — key/value extensions per market (number_format, date_format,
//                weight_unit_default, etc.)
// -----------------------------------------------------------------------------

model MarketConfig {
  id       String @id @default(cuid())
  marketId String
  key      String // 'number_format', 'date_format'
  value    Json
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, key])
}

// -----------------------------------------------------------------------------
// Region — geographic tree (country → subnational group → state/province →
//          metro V1.1+). Each region belongs to one Market.
// -----------------------------------------------------------------------------

model Region {
  id               String     @id @default(cuid())
  code             String     @unique // 'US', 'US-NE', 'US-CA', 'US-NYC'
  name             String // 'California', 'Northeast US'
  marketId         String
  parentRegionId   String? // 'US-NE' is parent of 'US-NY'
  kind             RegionKind
  centroidLatLng   Json? // { lat, lng } for distance math
  shippingZone     String? // freight-zone identifier
  isActive         Boolean    @default(true)
  market           Market     @relation(fields: [marketId], references: [id])
  parent           Region?    @relation("RegionTree", fields: [parentRegionId], references: [id])
  children         Region[]   @relation("RegionTree")
  partnersAtRegion Partner[]  @relation("PartnerPrimaryRegion")
  brandsOperating  Brand[]    @relation("BrandOperatingRegion")

  @@index([marketId, kind])
}

// -----------------------------------------------------------------------------
// PartnerMarketCert — which markets a partner is certified to produce for,
//                     with cert ref + expiry. Admin verifies in Vendor
//                     Verification queue (#94 extension #159).
// -----------------------------------------------------------------------------

model PartnerMarketCert {
  partnerId        String
  marketId         String
  certifiedAt      DateTime
  expiresAt        DateTime?
  certificationRef String? // FDA registration #, Health Canada licence #
  status           PartnerMarketStatus @default(ACTIVE)
  partner          Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  market           Market              @relation(fields: [marketId], references: [id])

  @@id([partnerId, marketId])
  @@index([marketId, status])
}

// -----------------------------------------------------------------------------
// BrandTargetMarket — which markets a brand sells into. First-written is
//                     marked isPrimary for default labelling.
// -----------------------------------------------------------------------------

model BrandTargetMarket {
  brandId   String
  marketId  String
  isPrimary Boolean @default(false)
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market    Market  @relation(fields: [marketId], references: [id])

  @@id([brandId, marketId])
  @@index([marketId])
}

// =============================================================================
// PARTNER 5-LAYER ONBOARDING — V1
// Spec: docs/PARTNER_ONBOARDING.md
// =============================================================================
//
// The 5 layers (each independent, non-sequential after Identity):
//   L1 Identity & Verification    — Phase A model (PartnerVerificationSection 4 sections + 5th OPERATIONAL_STANDARDS)
//   L2 Operational Capability     — structured productTypes / packagingFormats / specs / MOQ / lead time / specialties
//   L3 Operational Standards      — partner-wide: response SLA, comm channel, escalation, revisions
//   L4 Financial & Commercial     — fixed STANDARD_V1.0 contract for V1; per-partner override via contractOverrideId V1.5+
//   L5 System Integration         — dashboard-only baseline; CSV/webhook/API hooks reserved
//
// Activation FSM (PartnerStatus enum above): LEAD → IDENTITY_PENDING_REVIEW
//   → IDENTITY_VERIFIED → OPS_PENDING_REVIEW → OPERATIONALLY_CONFIGURED → ACTIVE
//   → (INTEGRATION_ENHANCED) + side states PAUSED / SUSPENDED / TERMINATED.

// -----------------------------------------------------------------------------
// LAYER 2 — Operational Capability
// -----------------------------------------------------------------------------

model PartnerOperationalCapability {
  id                   String   @id @default(cuid())
  partnerId            String   @unique
  // Controlled vocabularies (admin-managed; values validated in app layer for V1)
  productTypes         String[] // e.g., ['carbonated_beverage', 'supplement_powder', 'hot_sauce']
  packagingFormats     String[] // e.g., ['12oz_slim_can', '16oz_pet_bottle']
  productionSpecs      String[] // e.g., ['hot_fill', 'cold_fill', 'HPP', 'pasteurization']
  // Quantitative
  moqUnitsMin          Int // typical minimum order qty floor
  moqUnitsTypical      Int // most common MOQ partners quote
  leadTimeDaysMin      Int // typical lead time window low end
  leadTimeDaysMax      Int // typical lead time window high end
  monthlyCapacityUnits Int? // optional production ceiling per month
  // Specialty boost — subset of productTypes the partner is best at;
  // drives marketplace ranking (per docs/MARKETS_AND_REGIONS.md matching).
  specialties          String[]
  notes                String? // partner-supplied free-text caveats
  updatedAt            DateTime @updatedAt
  partner              Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// LAYER 3 — Operational Standards (partner-wide V1; per-product override V1.5+)
// -----------------------------------------------------------------------------

enum CommChannel {
  EMAIL
  IN_APP
  PHONE
}

enum RevisionPolicy {
  PLATFORM_DEFAULT // V1 default — uses PlatformMandatedStandards rules
  CUSTOM_NEGOTIATED // V1.5+ admin-mediated per-partner negotiated terms
}

enum ProductionConfirmationMode {
  SLOW_CONFIRM // 24h email loop (default for non-integrated partners)
  FAST_CONFIRM // in-app, immediate (requires partner to be active in dashboard)
}

model PartnerOperationalStandards {
  id                         String                     @id @default(cuid())
  partnerId                  String                     @unique
  responseTimeHours          Int                        @default(24) // partner commits to respond to new orders within X hours
  preferredCommChannel       CommChannel                @default(IN_APP)
  escalationContact          Json // { name, email, phone, role }
  revisionPolicy             RevisionPolicy             @default(PLATFORM_DEFAULT)
  customRevisionTerms        String? // only set when revisionPolicy=CUSTOM_NEGOTIATED
  productionConfirmationMode ProductionConfirmationMode @default(SLOW_CONFIRM)
  acceptedDefaults           Boolean                    @default(true) // convenience flag — "partner accepted all V1 defaults"
  updatedAt                  DateTime                   @updatedAt
  partner                    Partner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// Singleton — platform-wide standards applied to ALL partners.
// Admin-edited via /admin/platform-settings/operational-standards.
// Versioned for audit (append-only; never edit existing rows).
model PlatformMandatedStandards {
  id                          String    @id @default(cuid())
  version                     String    @unique // 'v1.0', 'v1.1'
  acceptedArtworkFormats      String[]  @default(["AI", "PDF", "SVG", "PSD"])
  versioningRule              String    @default("every_change_new_version")
  disputeResolutionWindowDays Int       @default(14)
  escalationPath              Json // tier sequence: tier1 admin → tier2 admin → legal
  effectiveFrom               DateTime
  effectiveTo                 DateTime?
  createdAt                   DateTime  @default(now())
}

// -----------------------------------------------------------------------------
// LAYER 4 — Financial & Commercial
// Fixed standard contract V1; per-partner override hook reserved for V1.5+.
// -----------------------------------------------------------------------------

enum ContractStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum PaymentMethod {
  ACH
  WIRE
  STRIPE_CONNECT // V1 default — already wired via #54
}

enum PricingModel {
  FIXED
  QUOTE_BASED
  VOLUME_TIERED
}

enum InvoiceCycle {
  PER_ORDER
  WEEKLY
  MONTHLY
}

// Admin-managed library of contract versions. Partners reference, never edit.
// V1 seed: one row, 'STANDARD_V1.0'.
// V1.5+: additional rows can be created for per-partner side agreements;
//        admin sets PartnerCommercialTerms.contractOverrideId to point at them.
model ContractTerms {
  id                    String                   @id @default(cuid())
  version               String                   @unique // 'STANDARD_V1.0', 'ACME_CUSTOM_V1' (V1.5+)
  name                  String
  description           String
  status                ContractStatus
  failureResponsibility Json // matrix per docs/PARTNER_ONBOARDING.md §2.5
  paymentTerms          Json // standard payment timing + supported methods
  pricingModelOptions   PricingModel[] // which models partners under this contract can offer
  invoiceCycleOptions   InvoiceCycle[]
  disputePolicy         Json
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  pdfFileId             String? // R2 reference to human-signable PDF
  createdAt             DateTime                 @default(now())
  partnersReferencing   PartnerCommercialTerms[] @relation("StandardContract")
  partnersOverriding    PartnerCommercialTerms[] @relation("OverrideContract")
}

model PartnerCommercialTerms {
  id                     String         @id @default(cuid())
  partnerId              String         @unique
  contractTermsId        String // FK — defaults to current STANDARD_V1.0 ACTIVE row
  // V1.5+ extensibility hook (nullable; never set in V1 — every partner uses standard contract)
  contractOverrideId     String?
  paymentMethod          PaymentMethod  @default(STRIPE_CONNECT)
  payoutTimingDays       Int            @default(7)
  pricingModel           PricingModel   @default(FIXED)
  invoiceCycle           InvoiceCycle   @default(PER_ORDER)
  signedAt               DateTime
  signedById             String // User who clicked "I accept the contract"
  stripeConnectAccountId String? // mirrors User.stripeAccountId for partner-level scoping
  updatedAt              DateTime       @updatedAt
  partner                Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  contractTerms          ContractTerms  @relation("StandardContract", fields: [contractTermsId], references: [id])
  contractOverride       ContractTerms? @relation("OverrideContract", fields: [contractOverrideId], references: [id])
}

// -----------------------------------------------------------------------------
// LAYER 5 — System Integration (V1 = dashboard-only baseline for everyone)
// -----------------------------------------------------------------------------

enum InventorySyncMode {
  NONE // V1 default — no automatic inventory sync
  MANUAL // V1.5+ — partner enters inventory adjustments by hand
  CSV_BATCH // V1.5+ — periodic CSV import/export
  WEBHOOK // V2 — push notifications to partner endpoint
  API // V2 — full programmatic sync
}

model PartnerIntegrationCapability {
  id                   String            @id @default(cuid())
  partnerId            String            @unique
  hasDashboardOnly     Boolean           @default(true) // everyone has this in V1
  canUseCSVImport      Boolean           @default(false) // V1.5+ feature flag
  canUseCSVExport      Boolean           @default(false)
  hasWebhookEndpoint   Boolean           @default(false) // V2+ feature flag
  webhookUrl           String?
  webhookSigningSecret String? // rotated by admin
  hasAPIIntegration    Boolean           @default(false) // V2+ feature flag
  apiKeyId             String? // future FK to APIKey rotation system (V2)
  inventorySyncMode    InventorySyncMode @default(NONE)
  updatedAt            DateTime          @updatedAt
  partner              Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// OnboardingProgress — per-layer completion tracking for the wizard at
// /partner/onboarding. Distinct from the legacy Partner.onboardingProgress
// Json field (Phase A) which is preserved for back-compat.
// -----------------------------------------------------------------------------

enum LayerStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED // partner has submitted; awaiting admin review
  APPROVED // admin approved this layer
  CHANGES_REQUESTED // admin requested changes via changeRequests Json
}

model PartnerOnboardingProgress {
  id                   String      @id @default(cuid())
  partnerId            String      @unique
  layer1Identity       LayerStatus @default(NOT_STARTED)
  layer2Capability     LayerStatus @default(NOT_STARTED)
  layer3Standards      LayerStatus @default(NOT_STARTED)
  layer4Commercial     LayerStatus @default(NOT_STARTED)
  layer5Integration    LayerStatus @default(NOT_STARTED)
  // Structured admin feedback per layer — array of { category, description, createdAt, resolvedAt? }
  // Partner sees these as a checklist on /partner/my-application with deep-links to fix.
  layer1ChangeRequests Json?
  layer2ChangeRequests Json?
  layer3ChangeRequests Json?
  layer4ChangeRequests Json?
  layer5ChangeRequests Json?
  lastActivityAt       DateTime?
  partner              Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// =============================================================================
// CREATOR ONBOARDING + BRAND ASSETS — V1
// Specs: docs/CREATOR_ONBOARDING.md + docs/DESIGN_STUDIO_REBUILD.md §4
// =============================================================================
//
// Creator onboarding = 5-step guided stepper. Brand Assets = simple 3-section
// page (Logos / Colors / Fonts) that feeds the Fabric.js Design Studio canvas.
//
// V1 has ONE curated library that survives: TypographyFont (~24 Google Fonts
// rows). Creators pick 1-3 of these per brand. BrandStylePreset / ColorPalette
// / TypographyPair were dropped 2026-05-26 as scope creep (web design-system
// concepts that don't apply to packaging design). PhotographyStyle and
// IllustrationStyle enums also dropped.

enum FontSource {
  GOOGLE_FONTS // V1 default — all curated fonts come from Google Fonts
  ADOBE // V1.1+
  PRIVATE_LICENSED // V1.5+ — partner uploads with license attestation
}

enum BrandLibraryStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum OnboardingStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED // distinguishes deliberate skip from "not yet started"
}

// -----------------------------------------------------------------------------
// CURATED LIBRARIES — admin-managed, referenced by Brand
// -----------------------------------------------------------------------------

// BrandStylePreset / ColorPalette / TypographyPair models were dropped 2026-05-26
// per docs/DESIGN_STUDIO_REBUILD.md §4 — they were web design-system concepts
// (style presets, 11-role color tokens, typographic pair lockups) that do not
// apply to packaging-design where the canvas tools choose per-element sizing
// and the creator picks individual swatches + fonts directly.
//
// TypographyFont is the ONLY brand library model that survives — creators pick
// 1-3 fonts from this catalog and they're stored as Brand.brandFontIds[].

// Individual font rows (Google Fonts at V1 launch). Creators pick 1-3 of these
// per brand; references stored as Brand.brandFontIds[].
model TypographyFont {
  id               String             @id @default(cuid())
  family           String // 'Inter', 'Playfair Display'
  weight           String // 'Regular', 'Bold', 'Black'
  style            String // 'Normal', 'Italic'
  source           FontSource         @default(GOOGLE_FONTS)
  webfontUrl       String? // for browser rendering
  printFileAssetId String? // OTF/TTF asset for label PDF rendering (R2)
  unicodeRanges    String[] // subset support (latin, latin-ext, ...)
  licenseTerms     String // brief license summary for creator
  status           BrandLibraryStatus
  createdAt        DateTime           @default(now())

  @@unique([family, weight, style])
}

// -----------------------------------------------------------------------------
// CreatorOnboardingProgress — 5-step stepper tracking (per Brand)
// Distinct from PartnerOnboardingProgress (different ceremony, different shape).
// -----------------------------------------------------------------------------

model CreatorOnboardingProgress {
  id                  String               @id @default(cuid())
  brandId             String               @unique
  step1TellUsAboutYou OnboardingStepStatus @default(NOT_STARTED) // markets + region + brand name
  step2PaymentSetup   OnboardingStepStatus @default(NOT_STARTED) // Stripe Checkout for funding production orders
  step3ConnectChannel OnboardingStepStatus @default(NOT_STARTED) // Shopify/WC/BigC/Amazon/Direct (optional)
  step4BrandIdentity  OnboardingStepStatus @default(NOT_STARTED) // Brand Quickstart (logo, palette, typography, voice tags, tagline)
  step5FirstProduct   OnboardingStepStatus @default(NOT_STARTED) // marketplace browse + pick first product
  lastActivityAt      DateTime?
  brand               Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// =============================================================================
// MANUFACTURER PRODUCT BUILDER — Packaging + Certificates + Notes + FlavorPresets
// Spec: docs/MANUFACTURER_PRODUCT_BUILDER.md
// =============================================================================
//
// V1 schema additions covering:
//   §5  FlavorPreset (overlay on base recipe — one product, many curated flavor variations)
//   §6  Two-tier Packaging (admin canonical PackagingType + partner-owned PackagingSystem
//       with admin override layer; PackagingSurface with die-line files per surface)
//   §7  Certificate library (admin CertificateType catalog + partner
//       PartnerCertificateInstance with private PDFs + ProductCertificate link
//       with per-size scope via appliesToPackagingSystemIds[])
//   §8  ProductReviewItem (structured admin feedback checklist)
//   §8a ProductNote (per-product partner ↔ admin thread)
//   §15 ProductTemplatePackaging (the per-size bridge with pricing tiers, MOQ,
//       lead time, surface-die-line overrides)

// Design Template Library (docs/DESIGN_TEMPLATE_LIBRARY.md). Style facet groups, die-line
// match mode, and the aspect-ratio bucket used for shape-family template matching.
enum TemplateStyleFacet {
  AESTHETIC // core look/mood (Minimal, Luxury, Retro…)
  POSITIONING // claim/segment (Clinical, K-Beauty, Sports…)
  AUDIENCE // who it's for (Kids, Men, Senior…)
  TREND // cross-cutting trend/seasonal (Y2K, Holiday, Eco…)
}

enum TemplateMatchMode {
  SHAPE_FAMILY // match by ContainerCategory + aspectBucket (reusable across similar containers)
  EXACT // match only the exact packagingTypeId
}

enum AspectBucket {
  WRAP // ≥2.5:1 — can/bottle wraps
  PANEL_WIDE // 1.3–2.5:1
  PANEL_SQUARE // 0.8–1.3:1
  PANEL_TALL // ≤0.8:1
  LONG_STRIP // stick packs / sachets
}

enum PackagingTopology {
  SINGLE_CONTAINER // one jar / bottle / pouch / can / box
  MULTI_CONTAINER_BOX // outer carton holding N inner containers (variety pack, sampler)
  STICK_PACK // single-serve sticks (powder, supplement)
  SACHET // single-serve flexible sachets
  CASE // shipper/case (24-pack, etc.) — wholesale unit
  CAPSULE_JAR // bottle of capsules/tablets (supplement form factor)
  POUCH_STAND_UP // stand-up pouch with resealable zipper
  POUCH_FLAT // flat sealed pouch
  TUBE // squeeze tube (sauces, gels)
  OTHER // catch-all (V1.5+ admin can add canonical types via PackagingType)
}

// Slice C7.c — explicit container category for a PackagingType, used to derive the
// implied multi-component slots (CONTAINER / CLOSURE / SEAL).
enum ContainerCategory {
  BOTTLE
  JAR
  CAN
  TUBE
  POUCH
  SACHET
  STICK_PACK
  BOX
  CARTON
  CASE
  OTHER
}

enum FlavorMode {
  SINGLE // one flavor per packaging unit (1 jar = 1 flavor)
  MULTI // multiple flavors per packaging unit (variety pack)
}

enum FlavorPolicy {
  CREATOR_PICK // creator selects flavor(s) per unit
  PARTNER_FIXED // partner has fixed assortment; creator can't customize
}

enum PackagingStatus {
  DRAFT
  ACTIVE
  RETIRED
}

// Partner-uploaded packaging review lifecycle (Packaging Studio "My" tab → admin
// catalog). A partner submits a custom packaging; admin approves it into an ACTIVE
// PackagingType (then preps 3D/2D mockups via the existing mockup tool), and it
// surfaces in the Library catalog. docs/PACKAGING_REVIEW.md.
enum PackagingReviewStatus {
  NONE // not submitted
  SUBMITTED // awaiting admin review
  APPROVED // admin promoted it to the catalog
  REJECTED // admin declined (see reviewNotes)
}

enum PackagingTypeStatus {
  ACTIVE
  DEPRECATED
}

enum CertificateTypeStatus {
  ACTIVE
  DEPRECATED
}

enum PartnerCertInstanceStatus {
  PENDING_REVIEW
  VERIFIED
  EXPIRED // auto-transitioned when expiresAt passes
  REJECTED
}

enum NoteAuthor {
  PARTNER
  ADMIN
}

enum FlavorPresetStatus {
  ACTIVE
  DRAFT
  RETIRED
}

// -----------------------------------------------------------------------------
// PACKAGING — two-tier admin canonical + partner-owned with override layer
// -----------------------------------------------------------------------------

// Admin-curated canonical packaging taxonomy. Starts EMPTY at V1 launch and grows
// as admin clusters partner-contributed PackagingSystems via the promotion
// queue (task #135).
/// Provenance of a packaging type's 3D model — tracked for licensing (Pacdora
/// imports) + to know what can be regenerated. docs/PACKAGING_COMPOSITION_MODEL.md.
enum Model3DSource {
  PACDORA_IMPORT // downloaded from Pacdora (Business license) — track for licensing
  UPLOAD // partner/admin-uploaded glTF/glb
  PARAMETRIC // generated from topology + dimensions (future)
}

model PackagingType {
  id                 String                     @id @default(cuid())
  slug               String                     @unique // 'hdpe-jar-16oz-wide-mouth'
  displayName        String // canonical name shown publicly
  imageFileId        String? // admin-curated reference photo (Asset/PartnerFile soft FK)
  // 3D Packaging Studio asset (docs/PACKAGING_COMPOSITION_MODEL.md §4). The glTF
  // drives the three.js scene; defaultSurfaces (enriched to SurfaceDescriptor[])
  // maps each clickable region → the component role it decorates + UV region.
  model3dKey         String? // imported glTF/glb (R2 storage key)
  model3dSource      Model3DSource?
  model3dThumbKey    String? // preview thumbnail
  defaultTopology    PackagingTopology
  // Slice C7.c — explicit container category (defaultTopology is too coarse to derive
  // which component slots CONTAINER/CLOSURE/SEAL a product implies). Nullable: admins
  // set it during curation; no existing PackagingType rows to backfill.
  containerCategory  ContainerCategory?
  defaultDimensions  Json? // { lengthMm, widthMm, heightMm }
  defaultSurfaces    Json? // [{ name, defaultBleedMm }]
  status             PackagingTypeStatus        @default(ACTIVE)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  systems            PackagingSystem[]
  // Slice C7.a — multi-component packaging
  components         PackagingComponent[]
  // Slice C8 — partner offerings on this container type
  packagingOfferings PartnerPackagingOffering[]
  // Slice C8 Phase 2 — template variants that use this container type
  templateVariants   ProductTemplateVariant[]
  // Slice C9 Phase 1 — typed packaging dielines for this container type
  dielines           PackagingDieline[]
  // Mockup templates (docs/MOCKUP_STRATEGY.md) — admin-curated 2D photo-mockups
  // a creator's artwork is composited onto. Owned by the packaging type so every
  // product on this container inherits them.
  mockupTemplates    MockupTemplate[]
}

// A 2D photo-mockup (docs/MOCKUP_STRATEGY.md, locked 2026-06-18): a base white-
// label product photo + a print-area quad the creator's artwork is perspective-
// warped into. Owned by a PackagingType so every product on that container reuses
// it. (V2 3D via Pacdora reuses PackagingType.model3dKey — see PACDORA_EVALUATION.)
enum MockupTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model MockupTemplate {
  id               String               @id @default(cuid())
  packagingTypeId  String
  packagingType    PackagingType        @relation(fields: [packagingTypeId], references: [id], onDelete: Cascade)
  label            String // "16oz HDPE jar — front"
  // Base white-label photo (Asset id, type MOCKUP_TEMPLATE). Resolved to a URL.
  baseImageAssetId String
  // Print area as 4 corner points in image-relative coords (0..1), order
  // TL,TR,BR,BL: [{x,y},…]. The creator's flat artwork is warped into this quad.
  printAreaQuad    Json
  // Optional surface this maps to ('front' | 'back' | 'wrap' | 'lid'); matches a
  // PackagingType.defaultSurfaces key when present.
  surfaceKey       String?
  status           MockupTemplateStatus @default(DRAFT)
  displayOrder     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([packagingTypeId, status])
}

// Partner-owned packaging system — links optionally to a canonical PackagingType.
// Display-name + image resolution priority:
//   1. overrideDisplayName / overrideImageFileId  (admin override)
//   2. linked PackagingType.displayName / imageFileId
//   3. partnerName / partnerImageFileId  (fallback)
model PackagingSystem {
  id                  String                     @id @default(cuid())
  partnerId           String
  packagingTypeId     String? // optional FK to canonical type
  // Partner-supplied (fallback when no type link and no admin override):
  partnerName         String
  partnerImageFileId  String? // soft FK to Asset/PartnerFile
  // Admin override layer (wins over partner if set):
  overrideDisplayName String?
  overrideImageFileId String?
  // Physical implementation:
  topology            PackagingTopology
  unitCount           Int                        @default(1)
  flavorMode          FlavorMode                 @default(SINGLE)
  flavorPolicy        FlavorPolicy               @default(CREATOR_PICK)
  moq                 Int
  dimensions          Json? // { lengthMm, widthMm, heightMm }
  maxWeightG          Int?
  material            String? // free-text substrate/material, e.g. "PET", "SBS folding carton"
  dielineFileId       String? // soft FK to PartnerFile — partner-supplied die-line/artwork reference
  customDielineLayout Json? // inline mandatory-frame layout for a type-less custom packaging: { layout, trim, safe }
  status              PackagingStatus            @default(DRAFT)
  // Admin-catalog review (docs/PACKAGING_REVIEW.md). When a partner submits a
  // custom upload, admin approves it into an ACTIVE PackagingType + assigns a
  // category; approvedPackagingTypeId points at the created catalog row.
  reviewStatus            PackagingReviewStatus  @default(NONE)
  submittedForReviewAt    DateTime?
  reviewNotes             String?
  suggestedCategory       ContainerCategory?
  approvedPackagingTypeId String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  // Relations
  partner             Partner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  packagingType       PackagingType?             @relation(fields: [packagingTypeId], references: [id])
  surfaces            PackagingSurface[]
  templates           ProductTemplatePackaging[]
  files               PackagingSystemFile[]

  @@index([partnerId, status])
  @@index([packagingTypeId])
}

// Multiple partner-supplied artwork files per custom packaging (in-studio upload).
// A single packaging (e.g. supplement bottle + outer folding box) can carry many
// MOCKUP photos/3D files and many DIELINE files, each die-line tagged with a panel
// (FRONT / BACK / TOP / …). soft FK to PartnerFile (r2Key lives there).
model PackagingSystemFile {
  id                String          @id @default(uuid())
  packagingSystemId String
  partnerFileId     String // soft FK → PartnerFile
  role              String // 'MOCKUP' | 'DIELINE'
  panel             String? // die-line panel: FRONT/BACK/TOP/BOTTOM/LEFT/RIGHT/OTHER
  label             String? // free label, e.g. "Bottle", "Outer box"
  displayOrder      Int             @default(0)
  createdAt         DateTime        @default(now())
  packagingSystem   PackagingSystem @relation(fields: [packagingSystemId], references: [id], onDelete: Cascade)

  @@index([packagingSystemId, role])
}

// Per-surface die-line + print spec on a PackagingSystem.
// E.g., a 16oz jar has surfaces { Front, Back, Lid } — each its own die-line file.
model PackagingSurface {
  id                String          @id @default(cuid())
  packagingSystemId String
  name              String // 'Front', 'Lid', 'Inner Tray'
  dieLineFileId     String? // soft FK to PartnerFile (R2)
  printableAreaSqIn Float?
  bleedMm           Float           @default(3)
  // Print spec (from FOD admin delta §1.1; V1 schema, V1.1 visual zone editor)
  printDpi          Int?
  colorMode         String? // 'CMYK', 'RGB', 'BW'
  mandatoryZones    Json? // [{ type, x, y, w, h, required }] — V1.1 zone editor
  registrationMarks Json?
  packagingSystem   PackagingSystem @relation(fields: [packagingSystemId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// MULTI-COMPONENT PACKAGING (Slice C7.a) — every product has multiple physical
// PackagingComponents (primary container, closures, seals, secondary cartons,
// tertiary shipping). Each component has its own dieline + decoration + design
// version + pricing. Spec: docs/builds/_V1_PACKAGING_COMPONENTS.md
// -----------------------------------------------------------------------------

enum PackagingTier {
  PRIMARY // the container holding the product
  SECONDARY // retail-facing carton/box around primary
  TERTIARY // shipping/distribution outer packaging
}

enum ComponentRole {
  CONTAINER // primary container itself (can, bottle, jar, pouch)
  CARTON // secondary box/carton
  CLOSURE // cap, lid
  SEAL // tamper-evident seal (foil, shrink band, sticker)
  INSERT // recipe card, brand-story card, instruction sheet
  LABEL // separate-applied label when decoration is PRESSURE_SENSITIVE_LABEL
  SHIPPER // tertiary shipping packaging (branded mailer, polybag, master case)
}

// Decoration method — how a component is decorated, independent of the container.
// Spec: docs/builds/_V1_DECORATION_METHODS.md
enum DecorationMethod {
  // Primary decoration methods (one per component, required)
  DIRECT_PRINT // offset/digital/litho printed on substrate itself
  PRESSURE_SENSITIVE_LABEL // sticker label applied post-fill
  SHRINK_SLEEVE // full-body shrink-wrap, gravure or digital
  IN_MOLD_LABEL // for plastic containers, label fused at moulding
  HEAT_TRANSFER // heat-applied label, mid-volume
  // Accent decoration methods (can be combined with primary)
  FOIL_STAMP // hot foil application (metallic finish)
  EMBOSS // raised impression
  DEBOSS // sunken impression
  SPOT_UV // selective glossy varnish
  // No decoration
  NONE // stock cap, blank seal, plain insert
}

// Lifecycle status for marketplace offerings (component variants, accessories).
enum OfferingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  ARCHIVED
}

// -----------------------------------------------------------------------------
// DECORATION OFFERINGS (Slice C8) — supply-side. A partner declares which
// (container type × decoration × dieline) tuples they offer, at what MOQ /
// price / lead-time, and via which fulfillment mode. Accent decorations layer
// on top of a component's primary decoration. Admin curates which decoration
// methods are valid per container category.
// Spec: docs/builds/_V1_DECORATION_METHODS.md
// -----------------------------------------------------------------------------

enum FulfillmentMode {
  BULK_PRODUCTION
  ON_DEMAND
  BOTH
}

// A 3-tuple a partner offers: container type × decoration × dieline, at
// MOQ/price/lead-time. dielineId is a soft FK until typed PackagingDieline
// ships in C9/C10.
model PartnerPackagingOffering {
  id               String           @id @default(uuid())
  partnerServiceId String
  packagingTypeId  String
  decorationMethod DecorationMethod
  dielineId        String? // C9 Phase 1 — typed FK to PackagingDieline; nullable
  moq              Int              @default(1)
  leadTimeDays     Int              @default(14)
  pricingTiers     Json             @default("[]") // [{minQty:Int, pricePerUnitCents:Int}] — single Json (Cockroach-safe)
  fulfillmentMode  FulfillmentMode  @default(BOTH)
  status           OfferingStatus   @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  partnerService PartnerService       @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  packagingType  PackagingType        @relation(fields: [packagingTypeId], references: [id])
  components     PackagingComponent[] // back-relation — components that selected this offering
  // C9 Phase 1 — typed dieline relation (was a soft FK). SetNull: offering
  // survives if the dieline is removed.
  dieline        PackagingDieline?    @relation(fields: [dielineId], references: [id], onDelete: SetNull)

  @@unique([partnerServiceId, packagingTypeId, decorationMethod])
  @@index([packagingTypeId, status])
}

// -----------------------------------------------------------------------------
// PACKAGING DIELINE (Slice C9 Phase 1) — typed, structured prepress dieline a
// partner offers per (service × container × decoration). Replaces the prior
// dielineId soft FK on PartnerPackagingOffering. Phase 1 = schema + original
// file link + partner-entered structured spec. SpotColor / PmsBook /
// PartnerPrintOutputSpec / colorProfile are deferred to later phases.
// Spec: docs/builds/_V1_DIELINE_NORMALIZATION.md
// -----------------------------------------------------------------------------

enum DielineFileFormat {
  AI
  PDF
  SVG
  DXF
}

enum DielineStatus {
  UPLOADED // partner uploaded the original file; structured spec not yet confirmed
  PARSED // (future) auto-parse done, awaiting confirmation
  PARTNER_CONFIRMED // structured spec confirmed by the partner
  ADMIN_VERIFIED // (future) admin spot-checked
  ACTIVE // available for offering selection
  ARCHIVED // superseded
}

model PackagingDieline {
  id               String           @id @default(uuid())
  partnerServiceId String
  packagingTypeId  String
  decorationMethod DecorationMethod

  // Original uploaded file (R2 via PartnerFile)
  partnerFileId      String?
  originalFileFormat DielineFileFormat?

  // Structured prepress spec (partner-entered; nullable until confirmed)
  widthMm     Decimal? @db.Decimal(10, 3)
  heightMm    Decimal? @db.Decimal(10, 3)
  depthMm     Decimal? @db.Decimal(10, 3)
  bleedMm     Decimal  @default(3.0) @db.Decimal(10, 3)
  trimBox     Json? // {x,y,w,h}
  safeAreaBox Json? // {x,y,w,h}
  foldLines   Json? // [{x1,y1,x2,y2,type}]
  surfaces    Json? // [{name, trimBox}]
  // Mandatory-element + packaging-mark zones placed by the partner on the
  // die-line. Content-agnostic typed SLOTS (FrameLayout) — the actual content
  // resolves at composition from the right scope (recipe / material / certs /
  // phrases / market). See docs/DIELINE_FRAME_EDITOR_SPEC.md + @ilaunchify/ui
  // canvas/frames. Normalized 0..1 to the surface trim box.
  frames          Json? // FrameLayout
  framesUpdatedAt DateTime?

  // Forward-compat nullable fields (populated in later phases — cheap to add now)
  normalizedSvgKey   String?
  thumbnailKey       String?
  parseAccuracyScore Decimal?  @db.Decimal(3, 2)
  adminVerifiedAt    DateTime?
  adminVerifiedById  String?

  // Canonical shape mapping (docs/DIELINE_MANAGEMENT_UX.md P2). Links a partner
  // submission to a house-standard DieCutTemplate so the admin normalizes a shape
  // once + propagates conventions. clusterKey = aspect/size bucket for grouping;
  // matchConfidence = 0..1 auto-match score (admin can override).
  canonicalShapeId String?
  matchConfidence  Decimal? @db.Decimal(3, 2)
  clusterKey       String?

  status             DielineStatus @default(UPLOADED)
  uploadedAt         DateTime      @default(now())
  partnerConfirmedAt DateTime?
  updatedAt          DateTime      @updatedAt

  partnerService PartnerService             @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  packagingType  PackagingType              @relation(fields: [packagingTypeId], references: [id])
  partnerFile    PartnerFile?               @relation(fields: [partnerFileId], references: [id])
  offerings      PartnerPackagingOffering[]
  canonicalShape DieCutTemplate?            @relation("DielineCanonicalShape", fields: [canonicalShapeId], references: [id])

  @@index([partnerServiceId, packagingTypeId, decorationMethod])
  @@index([status])
  @@index([canonicalShapeId])
}

// Accent decoration layered on a component (foil / emboss / deboss / spot-UV).
// decorationMethod expected one of FOIL_STAMP/EMBOSS/DEBOSS/SPOT_UV — enforced
// in app code (enum spans both primary + accent methods).
model AccentDecoration {
  id                   String           @id @default(uuid())
  packagingComponentId String
  decorationMethod     DecorationMethod
  surchargePerUnit     Decimal          @default(0) @db.Decimal(10, 4)
  partnerFinishId      String? // optional soft FK to PartnerFinish for pricing linkage
  createdAt            DateTime         @default(now())

  packagingComponent PackagingComponent @relation(fields: [packagingComponentId], references: [id], onDelete: Cascade)

  @@index([packagingComponentId])
}

// Admin-curated valid (container category × decoration method) combos. Keyed by
// container category (not packagingTypeId) — category-level matches the spec
// matrix and stays cleaner.
model PackagingDecorationCompatibility {
  containerCategory ContainerCategory
  decorationMethod  DecorationMethod
  notes             String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@id([containerCategory, decorationMethod])
}

model PackagingComponent {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  tier PackagingTier // PRIMARY | SECONDARY | TERTIARY
  role ComponentRole // CONTAINER | CARTON | CLOSURE | SEAL | INSERT | LABEL | SHIPPER

  // What it is — admin-curated PackagingType (330ml can, 6-pack carton)
  packagingTypeId String
  packagingType   PackagingType @relation(fields: [packagingTypeId], references: [id])

  // Who makes it (selected at marketplace time) — FK to PartnerPackagingOffering (Slice C8)
  partnerOfferingId String?
  partnerOffering   PartnerPackagingOffering? @relation(fields: [partnerOfferingId], references: [id])

  // Which decoration variant (closure: plain vs custom; seal: foil vs shrink band)
  selectedVariantId String?
  selectedVariant   PackagingComponentVariant? @relation(fields: [selectedVariantId], references: [id])

  // The dieline this component uses (resolved from variant or default) — soft FK
  dielineId String?

  // The decoration method for THIS component (different from sibling components)
  decorationMethod DecorationMethod @default(NONE)

  // Design surface — its own artwork; nullable for stock variants — soft FK
  designVersionId String?

  // For multi-flavor multipacks
  unitsPerParent    Int                  @default(1) // 4 of THIS flavor in a 12-pack of 3 flavors
  parentComponentId String? // primaries link to their secondary carton
  parent            PackagingComponent?  @relation("ComponentHierarchy", fields: [parentComponentId], references: [id])
  children          PackagingComponent[] @relation("ComponentHierarchy")

  // Per-component flavor preset (variety pack support) — soft FK to FlavorPreset
  flavorPresetId String?

  // Editor sort
  displayOrder Int @default(0)

  // 3D Packaging Studio (docs/PACKAGING_COMPOSITION_MODEL.md §4). Per-instance
  // dimension overrides (else inherit PackagingType.defaultDimensions) + how this
  // component's children arrange inside it in the 3D scene (e.g. {rows,cols} for a
  // 6-pack of cans in a carton, or explicit child positions).
  widthMm     Float?
  heightMm    Float?
  depthMm     Float?
  childLayout Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Slice C8 — accent decorations (foil/emboss/deboss/spot-UV) layered on this component
  accentDecorations AccentDecoration[]

  @@index([productId])
  @@index([parentComponentId])
}

// Variants of a component — different decoration choices for the same slot.
model PackagingComponentVariant {
  id                String        @id @default(uuid())
  packagingTypeId   String
  componentRole     ComponentRole
  partnerOfferingId String // which partner offers this variant — soft FK

  name        String // "Black metal twist cap" | "Custom-printed shrink band"
  description String?

  isCustomizable    Boolean // does selecting this open a Studio surface?
  isDefaultIncluded Boolean @default(false) // is this the standard included variant?

  baseSurchargePerUnit Decimal @db.Decimal(10, 4) // cost added per unit beyond the default
  leadTimeDeltaDays    Int     @default(0)

  dielineId String? // unlocked if isCustomizable=true — soft FK

  // Compliance
  isFdaTamperEvident Boolean @default(false) // counts toward FDA 21 CFR 211.132

  status OfferingStatus

  createdAt DateTime @default(now())

  // Back-relation — components that selected this variant
  components PackagingComponent[]

  @@index([packagingTypeId])
}

// -----------------------------------------------------------------------------
// ACCESSORIES (Slice C7.b) — partner-bundled-only
// Per [[ilaunchify-accessories-are-partner-bundled-only]]: the listing partner
// IS the fulfillment partner. No platform-curated catalog, no cross-partner
// orchestration in V1/V1.5. An accessory exists only when a partner lists it,
// links it to specific offerings, and commits to bundling it at pack-out.
// -----------------------------------------------------------------------------

enum AccessoryCategory {
  SPOON
  RIBBON
  TAG // hangtag, neck tag
  INSERT // recipe card, brand insert
  CAP_COVER // decorative paper cover over jar lid
  TISSUE // branded tissue paper
  WAX_SEAL
  STICKER_PACK
  OTHER
}

model AccessoryOffering {
  id               String @id @default(uuid())
  partnerServiceId String // REQUIRED — listing partner is fulfillment partner. Soft FK (no relation per brief).

  name         String // "Laser-engraved wooden honey dipper"
  category     AccessoryCategory
  description  String
  imageFileKey String // R2 key

  // Explicit ties — partner picks which of their offerings it fits.
  applicablePartnerOfferingIds String[]

  // Array of tiers stored in a single JSONB column. Cockroach's Prisma connector
  // rejects the `Json[]` list type (P1012) — bare `Json` holding the array is the
  // schema-wide precedent (cf. PartnerPackagingOffering.pricingTiers).
  pricingTiers Json // [{quantity, pricePerUnit}]
  moq          Int  @default(1)
  leadTimeDays Int

  isCustomizable      Boolean // engraving text, color choice
  customizationFields Json // [{field:"engravingText", type:"text", max:30}]

  status OfferingStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relation — products that linked this accessory
  productLinks ProductAccessory[]

  @@index([partnerServiceId])
  @@index([status])
}

model ProductAccessory {
  productId           String
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  accessoryOfferingId String
  accessoryOffering   AccessoryOffering @relation(fields: [accessoryOfferingId], references: [id], onDelete: Cascade)

  customizationValues    Json? // {engravingText: "Pavel's Honey"}
  quantityPerProductUnit Int   @default(1)

  @@id([productId, accessoryOfferingId])
  @@index([accessoryOfferingId])
}

// -----------------------------------------------------------------------------
// CERTIFICATES — admin canonical types + partner instances + product links
// -----------------------------------------------------------------------------

// Admin-curated catalog of recognised certifications (NSF, USDA Organic, etc.).
// Each entry has a branded badge thumbnail for public display + verification notes.
// V1 seed: 12 starter types per spec §7.2.
model CertificateType {
  id                      String                       @id @default(cuid())
  name                    String
  slug                    String                       @unique
  thumbnailFileId         String? // admin-uploaded PNG badge (web UI: marketplace detail + chips), ~256x256
  badgeSvgFileId          String? // admin-uploaded VECTOR SVG badge — used in the Design Studio for print/production (vector required for production)
  description             String // shown on hover/tooltip publicly
  verificationNotes       String? // what admin looks for when verifying partner uploads
  status                  CertificateTypeStatus        @default(ACTIVE)
  // C1 — master-catalog applicability metadata (docs/builds/_certificates-master-catalog.json).
  // Slug arrays (not enums) so they ingest the locked catalog vocab verbatim.
  applicableLabelingTypes String[] // FOOD / BEVERAGE / SUPPLEMENT / COSMETIC / PET_PRODUCT / BABY_NUTRITION
  applicableCategorySlugs String[] // Layer-2 category slugs (the locked 13)
  applicableMarketSlugs   String[] // US / CA / EU / UK / * (all)
  scope                   CertScope? // applicability level (PRODUCT/FACILITY/COMPANY/…)
  claimCategories         String[] // organic / non-gmo / kosher / vegan / …
  issuingBodyUrl          String? // issuing body's standards/registry URL
  applicabilityNotes      String? // free-text admin guidance
  // Self-reference: this cert is an "alternative of" a more recognized one
  // (e.g. CCOF Organic → USDA Organic). Used by the picker to group equivalents.
  alternativeOfId         String?
  alternativeOf           CertificateType?             @relation("CertAlternatives", fields: [alternativeOfId], references: [id])
  alternatives            CertificateType[]            @relation("CertAlternatives")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  partnerInstances        PartnerCertificateInstance[]
  assetVariants           CertificateAssetVariant[]

  @@index([scope])
  @@index([alternativeOfId])
}

// C1 — partner-initiated request to add a NEW cert type to the master library.
// Admin reviews via /admin/certificate-requests (C2).
enum CertificateTypeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CertificateTypeRequest {
  id                      String                       @id @default(cuid())
  createdByPartnerId      String
  name                    String
  issuingBody             String?
  description             String?
  applicableLabelingTypes String[]
  applicableCategorySlugs String[]
  applicableMarketSlugs   String[]
  status                  CertificateTypeRequestStatus @default(PENDING)
  reviewedById            String? // admin User who reviewed
  reviewedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  createdByPartner        Partner                      @relation("PartnerCertTypeRequests", fields: [createdByPartnerId], references: [id])

  @@index([status])
  @@index([createdByPartnerId])
}

// C1 — sensitive-document access log. Every read of a partner cert PDF (signed
// URL) writes one row with a required reason (GDPR accountability; C5 wraps
// getSignedReadUrl to enforce it). Audit-style soft FKs (string ids).
enum DocumentAccessReason {
  VERIFICATION
  SUPPORT
  AUDIT
  PARTNER_DOWNLOAD
  LEGAL_HOLD
  ADMIN_REVIEW
}

model DocumentAccessLog {
  id                String               @id @default(cuid())
  actorUserId       String
  fileId            String // soft FK to PartnerFile / Asset (R2 object)
  accessReason      DocumentAccessReason
  productTemplateId String?
  accessedAt        DateTime             @default(now())

  @@index([fileId, accessedAt])
  @@index([actorUserId, accessedAt])
}

// C1 — cert applicability level. The roadmap's 5 (UNIVERSAL / LABELING_SPECIFIC /
// CATEGORY_SPECIFIC / FACILITY_LEVEL / COMPANY_LEVEL) plus PRODUCT_LEVEL, which
// the locked master catalog actually uses (catalog is source of truth).
enum CertScope {
  UNIVERSAL
  PRODUCT_LEVEL
  LABELING_SPECIFIC
  CATEGORY_SPECIFIC
  FACILITY_LEVEL
  COMPANY_LEVEL
}

// Partner's actual certification — they upload the PDF (private to admin),
// admin verifies in queue (task #129). Status auto-flips to EXPIRED on expiry.
// Only ACTIVE/VERIFIED instances appear in the product builder's certificate picker.
model PartnerCertificateInstance {
  id                 String                       @id @default(cuid())
  partnerId          String
  certificateTypeId  String
  pdfFileId          String // PartnerFile, private — never exposed publicly
  certificateNumber  String?
  issuingBody        String?
  issueDate          DateTime?
  expiryDate         DateTime
  status             PartnerCertInstanceStatus    @default(PENDING_REVIEW)
  reviewedById       String? // admin User
  reviewedAt         DateTime?
  rejectionReason    String?
  notes              String? // optional partner-supplied notes for admin
  // P10 — GDPR upload-consent capture
  consentAcceptedAt  DateTime? // when the partner ticked the upload-consent checkbox
  consentVersion     String? // which consent text version they accepted (e.g. "2026-06")
  // C4 — expiry tracking. Idempotency flags: timestamp set once the corresponding
  // expiry notice has been dispatched, so the cron never double-sends.
  notifiedAt60d      DateTime? // 60-day-out expiry notice sent
  notifiedAt30d      DateTime? // 30-day-out expiry notice sent
  notifiedAt7d       DateTime? // 7-day-out expiry notice sent
  // C4 — renewal chain. When this instance is superseded by a renewal, replacedById
  // points FORWARD to the NEW instance's id (replacedBy resolves to the newer row).
  replacedById       String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  partner            Partner                      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  certificateType    CertificateType              @relation(fields: [certificateTypeId], references: [id])
  productAssignments ProductCertificate[]
  replacedBy         PartnerCertificateInstance?  @relation("CertInstanceRenewal", fields: [replacedById], references: [id]) // the newer instance that replaced this one
  replaces           PartnerCertificateInstance[] @relation("CertInstanceRenewal") // instances this one supersedes

  @@index([partnerId, status])
  @@index([expiryDate])
  @@index([replacedById])
}

// Per-product certificate selections. Per-size scope: NULL appliesToPackagingSystemIds
// means cert applies to ALL of the product's PackagingSystems. Array form scopes
// to specific sizes (e.g., NSF only certified for the 16oz SKU).
model ProductCertificate {
  productTemplateId           String
  instanceId                  String
  appliesToPackagingSystemIds String[] // NULL/empty = all sizes
  productTemplate             ProductTemplate            @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  instance                    PartnerCertificateInstance @relation(fields: [instanceId], references: [id])

  @@id([productTemplateId, instanceId])
}

// -----------------------------------------------------------------------------
// PRODUCT REVIEW + NOTES — admin feedback + per-product partner ↔ admin thread
// -----------------------------------------------------------------------------

// Structured admin feedback items (NOT free-text comments — those are ProductNote).
// Each item is a checklist entry the partner must resolve before resubmit.
model ProductReviewItem {
  id                String          @id @default(cuid())
  productTemplateId String
  category          String // 'ingredients' | 'packaging' | 'media' | 'compliance' | 'other'
  description       String
  resolved          Boolean         @default(false)
  resolvedAt        DateTime?
  createdById       String // admin User
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([productTemplateId, resolved])
}

// Per-product comment thread between partner and admin. Use for messy human
// stuff (clarifications, photo requests, supplier-change heads-ups). Separate
// from ProductReviewItem (which is structured blocking checklist).
model ProductNote {
  id                String          @id @default(cuid())
  productTemplateId String
  authorId          String // User who wrote it
  authorType        NoteAuthor
  body              String
  attachmentFileId  String? // soft FK to PartnerFile
  editedAt          DateTime?
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([productTemplateId, createdAt])
}

// -----------------------------------------------------------------------------
// PRODUCT TEMPLATE ↔ PACKAGING (per-size bridge with pricing + per-product overrides)
// -----------------------------------------------------------------------------

model ProductTemplatePackaging {
  // Bridge between a product template and one of its size/packaging configurations.
  // Per-size pricing, MOQ, lead time, and surface-die-line overrides live here
  // (NOT on ProductTemplate itself — different sizes have different prices).
  productTemplateId String
  packagingSystemId String
  basePriceCents    Int // per unit at base MOQ
  moqOverride       Int? // overrides PackagingSystem.moq if set
  leadTimeDays      Int // absolute, not delta from system default
  pricingTiers      Json // [{ minQuantity, unitPriceCents }]
  surfaceOverrides  Json? // [{ surfaceId, overrideFileId }] per-product die-line overrides
  // V1 — product-plan additions 2026-06-01.
  // coPackerServiceId: which co-packer PartnerService performs the fill/assembly
  // for this product/size combo. Nullable — defaults to manufacturer-handled fill
  // until the orchestration engine decomposes into a separate co-packer leg.
  coPackerServiceId String?
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  packagingSystem   PackagingSystem @relation(fields: [packagingSystemId], references: [id])
  coPackerService   PartnerService? @relation("CoPackerAssignment", fields: [coPackerServiceId], references: [id])

  @@id([productTemplateId, packagingSystemId])
  @@index([coPackerServiceId])
}

// -----------------------------------------------------------------------------
// PRODUCT TEMPLATE PRICING TIERS — manufacturer-defined volume tiers
// (V1 product-plan additions 2026-06-01).
//
// Distinct from `ProductTemplatePackaging.pricingTiers` JSON (which is
// per-packaging-size sliding-scale price points). This typed model lives at
// the ProductTemplate level so the marketplace can show "starts at $X/unit
// for 1,000+" without joining through packaging. Per-tier lead time +
// floor protect the manufacturer from below-cost orders during promos.
// -----------------------------------------------------------------------------

model ProductTemplatePricingTier {
  id                String          @id @default(cuid())
  productTemplateId String
  // Which fulfillment mode these bands price. BULK_PRODUCTION = the volume bands
  // (MOQ-gated); ON_DEMAND = small-quantity / no-MOQ pricing. A product offering
  // BOTH carries rows for both modes. Additive — existing rows default to bulk.
  fulfillmentMode   FulfillmentMode @default(BULK_PRODUCTION)
  sortOrder         Int             @default(0)
  minQty            Int // inclusive lower bound
  maxQty            Int? // inclusive upper bound; NULL = "and up"
  perUnitCostCents  Int // current list per-unit price at this tier
  perUnitFloorCents Int // hard floor — promos/discounts cannot dip below
  leadTimeDays      Int? // optional override; falls through to packaging.leadTimeDays
  notes             String?
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([productTemplateId, fulfillmentMode, sortOrder])
  @@index([productTemplateId])
}

// -----------------------------------------------------------------------------
// FLAVOR PRESETS — one product, many curated flavor variations (NOT separate recipes)
// Per docs/MANUFACTURER_PRODUCT_BUILDER.md §5
// -----------------------------------------------------------------------------

model FlavorPreset {
  id                  String             @id @default(cuid())
  productTemplateId   String
  name                String // 'Chocolate', 'Vanilla', 'Strawberry'
  // Per-flavor FDA Statement of Identity (21 CFR 101.3) — e.g. "Chocolate
  // Flavored Whey Protein Powder". Unique per recipe; overrides the template's
  // default SoI; always distinct from the marketplace product name. Null falls
  // back to ProductTemplate.statementOfIdentity.
  statementOfIdentity String?
  swatchHex           String? // '#5C3317' for picker
  swatchImageFileId   String? // small jar/scoop photo for picker
  // Per-flavor die-line slot (PER_FLAVOR packing types; docs/HANDOFF-TO-CODE-
  // per-flavor-labels.md). null = this flavor uses the template/packaging die-line
  // shared by all flavors (the common case: same container, different label). Set
  // when a flavor's physical unit genuinely differs. Soft FK to PackagingDieline.
  dielineId           String?
  // The overlay — defines which slot picks apply for this flavor + flavor-only extras
  slotResolution      Json // [{ slotId, optionId | { customIngredientId, qty, unit } }]
  extras              Json? // [{ name, ingredientId, qty, unit }] flavor-only ingredients
  priceDeltaCents     Int                @default(0) // additive to per-size base price
  status              FlavorPresetStatus @default(ACTIVE)
  sortOrder           Int                @default(0)
  // V1 — per-flavor nutrient overrides (e.g., strawberry adds water content; shifts moisture)
  nutrientOverrides   Json? // [{ nutrient, value, reason }] — preset overrides win on conflict with ProductTemplate.nutrientOverrides
  productTemplate     ProductTemplate    @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  orderItemFlavors    OrderItemFlavor[] // variety-pack builder selections referencing this flavor
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([productTemplateId, status, sortOrder])
}

// =============================================================================
// Product Configurator & Constraints (docs/PRODUCT_CONFIGURATOR_CONSTRAINTS.md)
// Phase 1 substrate — additive, 2026-06-08. UI ships in later phases; the FLAVOR
// axis is canonical and bridges to FlavorPreset (honors "flavors are presets").
// =============================================================================

enum OptionAxisKey {
  FLAVOR
  SWEETENER
  STRENGTH
  CAFFEINE
  BOTTLE
  CLOSURE
  LABEL_FORMAT
  SUBSTRATE
  CUSTOM
}

enum OptionLayer {
  RECIPE
  PACKAGING
}

enum OptionValueStatus {
  ACTIVE
  INACTIVE
}

/// The ingredient operation a label-affecting option value applies to the base
/// recipe (docs/PRODUCT_CONFIGURATOR_CONSTRAINTS.md §12b). NONE = commercial /
/// visual only. SWAP/REMOVE act on the axis's boundSlotId; ADD injects.
enum OverlayOp {
  NONE
  SWAP
  ADD
  REMOVE
}

enum OptionRuleKind {
  EXCLUDE
  REQUIRE
}

enum FeeBasis {
  PER_UNIT
  PER_SKU_ONE_TIME
  PER_ORDER
}

enum StorageClass {
  AMBIENT
  CHILLED
  FROZEN
}

enum SpecSheetStatus {
  DRAFT
  ISSUED
  SUPERSEDED
}

enum ProductChangeType {
  LABEL_COPY
  FLAVOR_ADD
  RECIPE_CHANGE
  PACKAGING_CHANGE
  PRICE_CHANGE
}

enum ApproverRole {
  BRAND_OPS
  MANUFACTURER_QA
  LEGAL
  PRODUCTION_SCHEDULING
}

/// A configurable dimension the manufacturer exposes on a template. FLAVOR is
/// canonical (bridges to FlavorPreset); other axes are additional curated
/// dimensions. NEVER free-form — the manufacturer enumerates every value.
/// #1 permission matrix = editableByCreator.
model ProductOptionAxis {
  id                String               @id @default(cuid())
  productTemplateId String
  key               OptionAxisKey
  label             String // display, e.g. "Sweetener"
  layer             OptionLayer          @default(RECIPE)
  editableByCreator Boolean              @default(false) // locked unless true
  required          Boolean              @default(true)
  // Does choosing a value change the recipe → the FDA Facts label? When true,
  // each value carries a recipeOverlay and the nutrition engine recomputes the
  // label per resolved combination (e.g. Sweetener, Caffeine). When false, the
  // axis is commercial / visual only and the label is unchanged (e.g. roast
  // Strength when nutrition-equivalent, or any packaging-layer axis).
  affectsLabel      Boolean              @default(false)
  // SWAP/REMOVE axes are bound to one base recipe slot (TemplateIngredientSlot)
  // — each value fills or clears it. Null for ADD-only or commercial axes.
  boundSlotId       String?
  sortOrder         Int                  @default(0)
  isActive          Boolean              @default(true)
  productTemplate   ProductTemplate      @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  values            ProductOptionValue[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([productTemplateId, key])
  @@index([productTemplateId, isActive, sortOrder])
}

/// One allowed value on an axis + its compositional economics (#2 deltas).
/// Bridges to the real recipe/packaging row so we never duplicate that data.
model ProductOptionValue {
  id                 String            @id @default(cuid())
  axisId             String
  label              String // "Vanilla", "Stevia", "Cork Stopper"
  isDefault          Boolean           @default(false) // exactly one per axis (app-enforced)
  status             OptionValueStatus @default(ACTIVE)
  // #2 deltas — applied ON TOP of base SKU economics (see spec §9 formula)
  leadTimeDeltaDays  Int               @default(0)
  unitCostDeltaCents Int               @default(0)
  moqOverride        Int? // raises resolved-SKU MOQ to >= this
  priceDeltaCents    Int               @default(0) // optional creator-facing price delta
  // Bridges (set the one matching the axis key/layer):
  flavorPresetId     String? // key=FLAVOR    → FlavorPreset.id
  substrateId        String? // key=SUBSTRATE → Substrate.id
  packagingTypeId    String? // key=BOTTLE/CLOSURE → PackagingType.id
  // The ingredient operation this value applies when the axis affectsLabel
  // (docs §12b). NONE = commercial-only. The nutrition engine merges base +
  // flavor + selected option overlays per SKU → recomputes Facts + allergens.
  overlayOp          OverlayOp         @default(NONE)
  // Payload for the op: SWAP {toIngredientId} · ADD {addIngredientId,qty,unit} ·
  // REMOVE {} (slot comes from axis.boundSlotId) · NONE null.
  recipeOverlay      Json?
  sortOrder          Int               @default(0)
  axis               ProductOptionAxis @relation(fields: [axisId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([axisId, status, sortOrder])
}

/// #5 cross-option compatibility. EXCLUDE: whenValue ⇒ target unavailable.
/// REQUIRE: whenValue ⇒ target forced. Value ids reference ProductOptionValue
/// (app-resolved; no FK relation to keep it lightweight + cross-axis).
model ProductOptionRule {
  id                String          @id @default(cuid())
  productTemplateId String
  kind              OptionRuleKind
  whenValueId       String
  targetValueId     String
  message           String? // creator-facing popup copy
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([productTemplateId])
}

/// #3 one-time / per-unit / per-order fees. PER_SKU_ONE_TIME fees waive at or
/// above waivedAboveQty (e.g. QA batch testing waived above 12,500 units).
model ProductTemplateFee {
  id                String          @id @default(cuid())
  productTemplateId String
  label             String // "Tooling amortization", "QA batch testing"
  basis             FeeBasis
  amountCents       Int
  waivedAboveQty    Int? // PER_SKU_ONE_TIME only
  sortOrder         Int             @default(0)
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([productTemplateId])
}

/// Sample policy — the partner decides, per product, whether creators can order
/// pre-production samples and at what price. Two kinds (Pavel 2026-06-10):
///   UNBRANDED — the recipe in plain/generic packaging ("taste the formulation");
///               ships before the dieline exists, stamped NOT FOR RESALE.
///   BRANDED   — the product in the creator's packaging + artwork ("golden
///               sample" / packaging proof); gated on the dieline passing the
///               compliance check before it can be produced.
/// Pricing fits the flavor pool: a per-flavor unit price PLUS an optional flat
/// all-flavors sampler-set price. Samples are a distinct SAMPLE order type that
/// bypasses the production MOQ (sampleMoq instead). Partners may credit the
/// sample cost toward the creator's first production order (the conversion
/// lever). One row per enabled kind. Cast-guarded until the migration lands.
enum SampleKind {
  UNBRANDED // product only — recipe in plain/generic packaging
  BRANDED // product in the creator's packaging + artwork (gates on dieline)
}

model ProductSampleOption {
  id                String     @id @default(cuid())
  productTemplateId String
  kind              SampleKind
  enabled           Boolean    @default(true)

  // ---- Pricing (fits the flavor pool) ----
  perFlavorCents  Int? // price per flavor unit sampled
  samplerSetCents Int? // optional flat all-flavors sampler-set price

  // ---- Sample logistics (distinct from production) ----
  sampleMoq         Int  @default(1) // min units per sample order (NOT the production MOQ)
  maxUnitsPerFlavor Int? // cap per flavor per order; null = uncapped
  leadTimeDays      Int  @default(14)

  // ---- Credit-back (conversion lever) ----
  creditTowardFirstOrder Boolean @default(false)
  creditCapCents         Int? // max credit applied to the first production order; null = full

  // ---- Abuse control ----
  maxPerCreatorPerPeriod Int? // sample orders per creator per product per period; null = unlimited

  sortOrder       Int             @default(0)
  productTemplate ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@unique([productTemplateId, kind])
  @@index([productTemplateId])
}

/// #6 immutable, versioned product spec sheet snapshot, frozen at submit
/// (snapshot-for-legal-reproducibility). snapshot = locked core + axes + values
/// + fees + computed quote inputs.
model ProductSpecSheet {
  id                String          @id @default(cuid())
  productTemplateId String
  version           Int             @default(1)
  status            SpecSheetStatus @default(ISSUED)
  snapshot          Json
  generatedById     String // User
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([productTemplateId, version])
  @@index([productTemplateId, status])
}

/// #7 which change type re-triggers which approver. Platform defaults have a
/// null productTemplateId; per-template overrides set it. Complements the
/// order-level dispatch FSM (docs/MULTI_PARTNER_APPROVAL_WORKFLOW.md).
model ProductChangeApprovalRule {
  id                String            @id @default(cuid())
  productTemplateId String? // null = platform default
  changeType        ProductChangeType
  requiredApprover  ApproverRole
  sortOrder         Int               @default(0)
  productTemplate   ProductTemplate?  @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())

  @@index([productTemplateId, changeType])
}

// =============================================================================
// INGREDIENT SOURCING (#136) + USAGE TRACKING + DICTIONARIES (#143)
// Spec: docs/MANUFACTURER_PRODUCT_BUILDER.md §4a
// =============================================================================
//
// Three-tier sourcing model: USDA FDC (~10k high-quality Foundation/SR Legacy
// + ~30-50k filtered Branded Foods) + iLaunchify Curated Library (~1,000-1,200
// supplement-specific items, admin-curated) + Partner-Private (each partner's
// supplier SKUs with COA-derived nutrient panels).
//
// Sliding verification governance — SELF_ATTESTED partner-private ingredients
// are usable in published products immediately. Admin scales control via:
//   - Hard blocks (banned dictionary)
//   - Soft warns (controversial dictionary)
//   - Red flags in product approval queue when >5% of recipe weight
//   - Library promotion queue that absorbs cross-partner repeats over time

enum IngredientSource {
  USDA // imported from USDA FoodData Central (food/baby)
  LIBRARY // iLaunchify-curated item
  PARTNER_PRIVATE // partner-uploaded with COA, scoped to one partner via ownerPartnerId
  DSLD // NIH Dietary Supplement Label Database (supplements) — Phase 1
  INCI // INCI cosmetic ingredient dictionary (cosmetics) — Phase 2
  AAFCO // AAFCO feed-ingredient library (pet) — Phase 3
}

// How an external ingredient source is consulted (Pavel 2026-06-11). Admin-managed
// per source via IngredientSourceConfig; see docs/PRODUCT_DOMAINS_ARCHITECTURE.md §5.
enum IngredientSourceMode {
  MIRROR // DB copy only — imported/mirrored ahead of time (default)
  LIVE // call the external API at search time
  HYBRID // live discovery, snapshot the chosen row into the DB
}

// Admin configuration for each ingredient data source (one row per source). The
// search adapter reads this to decide MIRROR vs LIVE vs HYBRID, with auto-failover
// to the mirrored DB copy when a LIVE API is down. Managed in /admin/ingredient-sources.
model IngredientSourceConfig {
  source          IngredientSource     @id
  mode            IngredientSourceMode @default(MIRROR)
  failoverToDb    Boolean              @default(true) // LIVE/HYBRID → fall back to DB copy if the API is unreachable
  enabled         Boolean              @default(true)
  apiBaseUrl      String? // external endpoint, e.g. https://api.ods.od.nih.gov/dsld/v9/
  rateLimitPerMin Int                  @default(60)
  syncCron        String? // schedule for the mirror refresh job
  lastSyncedAt    DateTime?
  rowCount        Int                  @default(0) // mirrored ingredient rows currently in the DB
  labelingTypes   LabelingType[] // which product domains this source feeds
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

enum VerificationStatus {
  SELF_ATTESTED // default for new PARTNER_PRIVATE; usable in published products
  ADMIN_VERIFIED // admin reviewed COA/nutrient values
  LIBRARY_PROMOTED // promoted from PARTNER_PRIVATE to public LIBRARY (default for USDA + LIBRARY rows)
}

enum BioengineeredStatus {
  NONE // confirmed not bioengineered
  BIOENGINEERED // is a BE food per USDA BE Standard 2022
  DERIVED_FROM_BIOENGINEERED // ingredient derived from BE source
  NOT_APPLICABLE // not in scope (e.g., minerals, vitamins, salt)
}

// -----------------------------------------------------------------------------
// IngredientUsage — drives personalized search ranking in IngredientPicker
// per docs/MANUFACTURER_PRODUCT_BUILDER.md §4a.5a (Recipal-parity trick).
// Updated on every "save slot" / "save preset" action.
// -----------------------------------------------------------------------------

model IngredientUsage {
  id           String     @id @default(cuid())
  partnerId    String // who used this ingredient
  ingredientId String
  useCount     Int        @default(1)
  lastUsedAt   DateTime   @default(now())
  // Relations
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([partnerId, ingredientId])
  @@index([partnerId, lastUsedAt(sort: Desc)]) // primary sort key for personalized ranking
}

// -----------------------------------------------------------------------------
// BannedIngredient — hard-block dictionary
// Partner literally cannot save an ingredient whose name matches an active row.
// Seeded with ~30 entries: ephedra, sibutramine, undeclared stimulants,
// certain SARMs precursors, undeclared steroids, etc.
// Admin manages via /admin/library/banned-ingredients (V1.5+ UI; V1 = seed only).
// -----------------------------------------------------------------------------

model BannedIngredient {
  id            String   @id @default(cuid())
  // Matchers — at least one must be populated
  matchName     String? // case-insensitive exact match on Ingredient.name or internalName
  matchPattern  String? // optional regex (advanced)
  casNumber     String? // Chemical Abstracts Service number when known
  // Context
  reason        String // why this is banned (FDA action, safety concern, regulatory)
  reference     String? // URL to FDA notice / journal article / regulation
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, matchName])
  @@index([casNumber])
}

// -----------------------------------------------------------------------------
// ControversialIngredient — soft-warn dictionary
// Partner can save the ingredient but sees a warning at creation time AND
// admin gets a high-priority notification on use in any product.
// Seeded with ~40 entries: high-dose caffeine combinations, kratom, certain
// herbal extracts with uncertain safety profile, etc.
// -----------------------------------------------------------------------------

model ControversialIngredient {
  id             String   @id @default(cuid())
  matchName      String?
  matchPattern   String?
  casNumber      String?
  // Context
  concern        String // what the concern is (interaction, dosing, regulatory ambiguity)
  recommendation String? // suggested action (lower dose, alternative, COA required)
  reference      String?
  isActive       Boolean  @default(true)
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, matchName])
}

// =============================================================================
// LABEL DESIGN TEMPLATE — compatibility + tier + provenance enums (#147)
// Spec: docs/DESIGN_STUDIO.md §3
// Schema applies to DesignLibraryItem (which is the "LabelDesignTemplate" the
// spec refers to).
// =============================================================================

enum LabelTemplateSurface {
  FRONT
  BACK
  LID
  FULL_WRAP
  SLEEVE
  NECK
}

enum LabelTemplateTier {
  REGULAR // free with any partner plan
  PREMIUM // paid (one-time per use or via plan tier) — billing flow lands V1.5
  EXCLUSIVE // limited-license; max exclusiveSeats partners can claim
}

enum LabelTemplateCreator {
  ADMIN // hand-curated by iLaunchify ops
  DESIGNER // contractor-produced (the ~20 hand-curated V1 launch seed will be this)
  AI_AGENT // V2+ Trend Researcher + Template Generator pipeline
  PARTNER // V2+ partners contributing templates
}

enum LabelTemplateStatus {
  DRAFT
  PENDING_REVIEW // submitted (AI-generated or partner-submitted) awaiting human curator approval
  ACTIVE // available in Design Studio gallery
  DEPRECATED // hidden from gallery; existing creator Designs still valid
}

// =============================================================================
// NICHE TAXONOMY (V1 product-plan additions 2026-06-01)
// =============================================================================
// Typed catalog of audience-facing niches ("Sports Nutrition", "Pet",
// "Keto / Low-Carb") that drive marketplace filtering + /launch/[niche]
// landing pages. ProductTemplateNiche is a many-to-many junction; isPrimary
// flags the canonical niche for catalog display when a template tags
// multiple niches (most templates tag 1-2).
// =============================================================================

model Niche {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  name                  String
  description           String?
  displayOrder          Int                    @default(0)
  isActive              Boolean                @default(true)
  iconEmoji             String? // hero emoji + subnav glyph
  accentHex             String? // hex (e.g. #FF2E63) for niche-themed surfaces
  productTemplates      ProductTemplateNiche[]
  // 2026-06-02 V1.1 marketplace taxonomy — Layer 1 ↔ Layer 2 junction (Option A) + rules
  subcategories         NicheSubcategory[]
  rules                 NicheRule[]
  nicheAssignmentAudits NicheAssignmentAudit[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([isActive, displayOrder])
}

model ProductTemplateNiche {
  productTemplateId String
  nicheId           String
  isPrimary         Boolean         @default(false) // exactly one primary per template recommended (not enforced)
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  niche             Niche           @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([productTemplateId, nicheId])
  @@index([nicheId])
}

// =============================================================================
// 2026-06-02 V1.1 marketplace taxonomy — Layer 4 LifestyleTag, Niche ↔
// Subcategory junction (Option A — Layer 2 canonical), NicheRule auto-
// assignment engine, and NicheAssignmentAudit. See docs/MARKETPLACE_DESIGN.md
// §2 + memory note ilaunchify-marketplace-decisions-2026-06-01.md.
// =============================================================================

// LIFESTYLE TAGS — Layer 4 of the marketplace taxonomy
enum LifestyleTagGroup {
  LIFESTYLE // Keto, Paleo, Vegan, Vegetarian, Gluten-free, Dairy-free, Sugar-free, Low-carb, High-protein, Organic, Non-GMO, Plant-based, Whole30
  AUDIENCE // Kids, Adults, Seniors, Athletes, Pregnancy-safe, Pets
  TREND // Functional, Adaptogenic, Microbiome, Mood, Energy, Sleep, Immunity, Beauty-from-within, Sustainable packaging, Single-origin, Small-batch
}

model LifestyleTag {
  id               String                        @id @default(cuid())
  slug             String                        @unique
  name             String
  group            LifestyleTagGroup
  description      String?
  iconEmoji        String?
  accentHex        String?
  displayOrder     Int                           @default(0)
  isActive         Boolean                       @default(true)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  productTemplates ProductTemplateLifestyleTag[]

  @@index([group, displayOrder])
}

model ProductTemplateLifestyleTag {
  productTemplateId String
  lifestyleTagId    String
  source            NicheAssignmentSource @default(MANUFACTURER)
  createdAt         DateTime              @default(now())
  productTemplate   ProductTemplate       @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  lifestyleTag      LifestyleTag          @relation(fields: [lifestyleTagId], references: [id], onDelete: Cascade)

  @@id([productTemplateId, lifestyleTagId])
}

// NICHE × SUBCATEGORY junction — Layer 1 references Layer 2 leaves (Option A)
model NicheSubcategory {
  nicheId       String
  subcategoryId String
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())
  niche         Niche       @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([nicheId, subcategoryId])
  @@index([nicheId, displayOrder])
}

// NICHE AUTO-ASSIGNMENT RULES — the deterministic engine
enum NicheRuleConditionKind {
  LABELING_TYPE // labelingType matches one of the listed values
  CATEGORY // ProductTemplate.subcategory.categoryId in list
  SUBCATEGORY // ProductTemplate.subcategoryId in list
  CERT_ATTACHED // any ProductTemplateCertificate.instance.certificateType.slug in list
  LIFESTYLE_TAG // any tagged LifestyleTag.slug in list
}

enum NicheAssignmentSource {
  AUTO_RULE // assigned by NicheRule engine at submit
  MANUFACTURER // confirmed/added by manufacturer
  ADMIN // override by admin during review
}

model NicheRule {
  id          String   @id @default(cuid())
  slug        String   @unique
  nicheId     String
  description String
  isActive    Boolean  @default(true)
  isLocked    Boolean  @default(false) // true = manufacturer cannot deselect (e.g., Pet Wellness for PET_PRODUCT)
  weight      Int      @default(50) // higher = stronger suggestion; 0..100
  conditions  Json // [{kind: 'LABELING_TYPE', values: ['PET_PRODUCT']}, ...] — AND across array, OR within values
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  niche       Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([nicheId, isActive])
}

// AUDIT: every niche assignment writes one of these
model NicheAssignmentAudit {
  id                String                @id @default(cuid())
  productTemplateId String
  nicheId           String
  source            NicheAssignmentSource
  ruleId            String? // present when source=AUTO_RULE
  actorUserId       String? // present when source=MANUFACTURER or ADMIN
  applied           Boolean // true=assigned, false=removed
  createdAt         DateTime              @default(now())
  // Additive relations (2026-06-01 Slice 3) — drive the /admin/niches/audit
  // loader's orderBy/select/where. Cascade matches ProductTemplateNiche.
  productTemplate   ProductTemplate       @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  niche             Niche                 @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([productTemplateId, createdAt])
  @@index([nicheId])
}

// =============================================================================
// SUPPORT TICKETING (2026-06-01) — docs/SUPPORT_TICKETING_PLAN.md
// =============================================================================
// V1 internal ticketing system so creators + partners file structured support
// requests instead of email/Slack DMs. Admin triages from /admin/support
// inbox (5-card KPI strip + sortable table). Creators and partners file +
// view at /help on their respective apps. Shared @ilaunchify/support package
// brokers all four models so the three apps stay in sync.
//
// SLA tracking: slaBreachedAt is filled by an extension of the existing
// auto-cancel-dispatches cron when the per-priority (or per-category
// override) first-response window elapses without an admin reply.
//
// Activity log: TicketEvent rows render the per-ticket timeline; we ALSO
// write to AuditLog for platform-wide forensic queries.
//
// Entity link: entityType is a free-form string, allow-listed at the
// service layer (Order / OrderDispatch / Brand / Partner / PartnerService /
// ProductTemplate / Product / ProductionSubscription / CreatorProfile /
// OrderItem). New entity types added without a schema migration.
// =============================================================================

enum TicketStatus {
  NEW // just filed; needs triage
  TRIAGED // admin assigned + priority set
  IN_PROGRESS // admin actively working it
  WAITING_ON_REQUESTER // admin replied; awaiting requester response
  RESOLVED // admin marked resolved; not yet closed
  CLOSED // terminal; no further replies
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketRequesterRole {
  CREATOR
  PARTNER
}

enum TicketAuthorRole {
  CREATOR
  PARTNER
  ADMIN
}

enum TicketEventKind {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  REPLIED
  RESOLVED
  REOPENED
  MERGED
  SPLIT
  SLA_BREACHED
  INTERNAL_NOTE_ADDED
}

model Ticket {
  id              String              @id @default(cuid())
  // Who filed it
  requesterUserId String
  requesterRole   TicketRequesterRole
  // Resolution ownership (nullable until first triage)
  assigneeUserId  String?
  // What it's about
  categoryId      String
  subject         String              @db.String(180)
  body            String // markdown allowed
  // FSM position
  status          TicketStatus        @default(NEW)
  priority        TicketPriority      @default(MEDIUM)
  // Optional entity link (allow-listed at service layer)
  entityType      String?
  entityId        String?
  // SLA timestamps
  firstResponseAt DateTime? // first admin reply (not internal note)
  resolvedAt      DateTime?
  closedAt        DateTime?
  slaBreachedAt   DateTime? // cron sets when SLA window elapses
  // W2-SUP3.5 — effective SLA windows resolved AT CREATION from tier policy →
  // category override → priority default. The breach cron reads these directly
  // (no re-derivation), so a later tier/category change doesn't retro-move a
  // ticket's clock. Null = fall back to the priority default at read time.
  slaResponseMinutes Int? // minutes from createdAt to first admin reply
  slaResolveMinutes  Int? // minutes from createdAt to RESOLVED
  // Free-form admin scratchpad — visible only to admin
  internalNotes   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  // Relations
  requester       User                @relation("RequesterTickets", fields: [requesterUserId], references: [id])
  assignee        User?               @relation("AssigneeTickets", fields: [assigneeUserId], references: [id])
  category        TicketCategory      @relation(fields: [categoryId], references: [id])
  replies         TicketReply[]
  events          TicketEvent[]

  @@index([status, priority, createdAt]) // primary inbox sort
  @@index([assigneeUserId, status]) // "my queue"
  @@index([requesterUserId, createdAt]) // "my tickets"
  @@index([categoryId, status]) // category dashboards
  @@index([entityType, entityId]) // "tickets attached to this Order"
  @@index([slaBreachedAt]) // "SLA-breaching" KPI card
}

model TicketCategory {
  id                    String         @id @default(cuid())
  slug                  String         @unique // "order-issue" etc.
  name                  String // human label
  description           String?
  defaultPriority       TicketPriority @default(MEDIUM)
  defaultAssigneeUserId String? // optional auto-assign at create time
  slaResponseMinutes    Int? // overrides global priority default
  slaResolveMinutes     Int? // overrides global priority default
  isActive              Boolean        @default(true)
  sortOrder             Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  tickets               Ticket[]
  cannedReplies         SupportCannedReply[]

  @@index([isActive, sortOrder])
}

// W2-SUP — admin-curated canned/macro replies agents insert into the reply box.
// Optional category scope (null = global, shown for every ticket).
model SupportCannedReply {
  id          String          @id @default(cuid())
  title       String          @db.String(120) // short label shown in the picker
  body        String // markdown inserted into the reply
  categoryId  String? // optional scope; null = available everywhere
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdById String? // admin who created it (audit also records the actor)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([categoryId])
}

model TicketReply {
  id             String           @id @default(cuid())
  ticketId       String
  authorUserId   String
  authorRole     TicketAuthorRole
  body           String // markdown; sanitized server-side
  attachments    Json? // [{ key, name, mimeType, size }] — R2 keys
  isInternalNote Boolean          @default(false) // hidden from requester when true
  createdAt      DateTime         @default(now())
  ticket         Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author         User             @relation("TicketReplyAuthor", fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorUserId])
}

model TicketEvent {
  id          String          @id @default(cuid())
  ticketId    String
  kind        TicketEventKind
  payload     Json // { from, to, mergedFromTicketId, ... }
  actorUserId String? // null for SYSTEM events (cron-driven)
  createdAt   DateTime        @default(now())
  ticket      Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor       User?           @relation("TicketEventActor", fields: [actorUserId], references: [id])

  @@index([ticketId, createdAt])
}

// W2-SUP3.5 — admin-tunable support-tier policy (Pavel 2026-06-20).
// Singleton (id = "default"). Maps CREATOR subscription tier → response-SLA
// target + minimum-priority floor applied at ticket intake. Seeded from
// PLATFORM_SPEC §Tier 1 (Maker 48h / Builder 24h / Agency 4h). PARTNER tickets
// are deliberately NOT bound here — partner-tier meaning is undecided, so they
// stay info-only (their tier is surfaced as a badge, never auto-prioritized).
model SupportSettings {
  id                     String         @id @default("default")
  // Master switches — admin can disable either binding independently.
  slaTargetsEnabled      Boolean        @default(true)
  priorityFloorEnabled   Boolean        @default(true)
  // Creator tier → first-response SLA target (minutes).
  makerResponseMinutes   Int            @default(2880) // 48h
  builderResponseMinutes Int            @default(1440) // 24h
  agencyResponseMinutes  Int            @default(240) // 4h
  // Creator tier → minimum priority floor (intake never lands BELOW this).
  makerMinPriority       TicketPriority @default(LOW)
  builderMinPriority     TicketPriority @default(MEDIUM)
  agencyMinPriority      TicketPriority @default(HIGH)
  updatedAt              DateTime       @updatedAt
}

// ===========================================================================
// C7 — Asset Library (certificate / packaging / labeling symbol catalog)
// Asset file refs are PLAIN nullable String soft-FKs to Asset (svgFileId /
// pngFileId) — same pattern as CertificateType.thumbnailFileId. No @relation.
// ===========================================================================

enum AssetCatalogStatus {
  ACTIVE
  DEPRECATED
}

enum CertAssetVariantKind {
  COLOR
  BLACK_WHITE
  OUTLINE
  CONTEXTUAL // e.g. OU-D, "100% Organic" lockups
}

enum PackagingSymbolFamily {
  RESIN_CODE // SPI/RIC 1-7
  RECYCLING_MARK // How2Recycle, Green Dot, Mobius loop
  COMPOSTABILITY // BPI Compostable, OK Compost
  DISPOSAL // store drop-off, "do not litter"
  OTHER
}

enum LabelingSymbolFamily {
  ATTRIBUTION // "Distributed by", "Manufactured for"
  STORAGE // refrigerate after opening, keep frozen
  ALLERGEN // allergen icons
  DISCLOSURE // BE/bioengineered disclosure
  WARNING // Prop 65, choking hazard
  OTHER
}

enum SymbolRequirement {
  REQUIRED
  RECOMMENDED
  OPTIONAL
}

model CertificateAssetVariant {
  id                 String               @id @default(cuid())
  certificateTypeId  String
  kind               CertAssetVariantKind
  label              String // human label, e.g. "Color", "OU-D"
  svgFileId          String? // soft FK to Asset (vector — production)
  pngFileId          String? // soft FK to Asset (raster — UI preview)
  minWidthMm         Float? // smallest reproduction size
  maxWidthMm         Float?
  approvedColorSpec  String? // e.g. "PMS 348C / #00843D"
  requiredCoText     String? // text that must accompany the mark
  clearSpaceFactor   Float? // clear space = factor × mark height
  brandGuidelinesUrl String?
  notes              String?
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  certificateType    CertificateType      @relation(fields: [certificateTypeId], references: [id], onDelete: Cascade)

  @@index([certificateTypeId])
}

model PackagingSymbol {
  id                   String                   @id @default(cuid())
  slug                 String                   @unique
  name                 String
  description          String?
  family               PackagingSymbolFamily
  applicableSubstrates String[]
  applicableMaterials  String[]
  applicableMarkets    String[] // market slugs
  requirement          SymbolRequirement        @default(OPTIONAL)
  requiredWhen         String? // free-text rule, e.g. "Required in CA for rigid plastics"
  status               AssetCatalogStatus       @default(ACTIVE)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  variants             PackagingSymbolVariant[]

  @@index([family])
  @@index([status])
}

model PackagingSymbolVariant {
  id                 String          @id @default(cuid())
  packagingSymbolId  String
  label              String
  svgFileId          String?
  pngFileId          String?
  minWidthMm         Float?
  maxWidthMm         Float?
  approvedColorSpec  String?
  clearSpaceFactor   Float?
  brandGuidelinesUrl String?
  notes              String?
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  packagingSymbol    PackagingSymbol @relation(fields: [packagingSymbolId], references: [id], onDelete: Cascade)

  @@index([packagingSymbolId])
}

model LabelingSymbol {
  id                      String                  @id @default(cuid())
  slug                    String                  @unique
  name                    String
  description             String?
  family                  LabelingSymbolFamily
  applicableCategorySlugs String[]
  applicableMarkets       String[]
  requirement             SymbolRequirement       @default(OPTIONAL)
  requiredWhen            String?
  requiredCoText          String?
  status                  AssetCatalogStatus      @default(ACTIVE)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  variants                LabelingSymbolVariant[]

  @@index([family])
  @@index([status])
}

model LabelingSymbolVariant {
  id                 String         @id @default(cuid())
  labelingSymbolId   String
  label              String
  svgFileId          String?
  pngFileId          String?
  minWidthMm         Float?
  maxWidthMm         Float?
  approvedColorSpec  String?
  clearSpaceFactor   Float?
  brandGuidelinesUrl String?
  notes              String?
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  labelingSymbol     LabelingSymbol @relation(fields: [labelingSymbolId], references: [id], onDelete: Cascade)

  @@index([labelingSymbolId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Certificates C6 — consent-at-claim + partner document vault
// ─────────────────────────────────────────────────────────────────────────────

enum PartnerDocumentStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

// The load-bearing liability record — one row per cert badge a creator consents to place.
model LabelClaimConsent {
  id                           String    @id @default(cuid())
  userId                       String // creator User who consented (soft FK)
  productId                    String? // creator Product the design belongs to (soft FK)
  productTemplateId            String? // manufacturer template (soft FK)
  designVersion                String? // design snapshot/version id at consent time
  partnerCertificateInstanceId String? // the specific VERIFIED instance being claimed (soft FK)
  certificateTypeId            String? // cert type (soft FK)
  certName                     String // denormalized cert name for the record
  consentTextVersion           String // which consent wording was shown
  ipAddress                    String?
  userAgent                    String?
  metadata                     Json?
  revokedAt                    DateTime? // set if the creator later removes the badge / withdraws
  createdAt                    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([productId])
  @@index([partnerCertificateInstanceId])
}

// KYB / compliance document vault — real relation to Partner.
model PartnerDocument {
  id              String                @id @default(cuid())
  partnerId       String
  documentType    String // e.g. ARTICLES_OF_INCORPORATION, AUTHORIZED_SIGNER_ID, FFR, CGMP, MOCRA, CERTIFICATE_OF_INSURANCE
  fileId          String // PartnerFile id (soft FK)
  status          PartnerDocumentStatus @default(PENDING_REVIEW)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  expiryDate      DateTime?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  partner         Partner               @relation("PartnerDocuments", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([documentType])
}

// ── Track C — Compliance Templates (C1.a): Label Format Catalog ──────────────

enum LabelFormat {
  // FDA Nutrition Facts (food) — 21 CFR 101.9
  FDA_VERTICAL
  FDA_TABULAR
  FDA_LINEAR
  FDA_AS_PACKAGED_AS_PREPARED
  FDA_AGGREGATE
  FDA_INFANT
  FDA_CHILD
  FDA_100_GRAMS
  // FDA Supplement Facts — 21 CFR 101.36
  FDA_SUPPLEMENT
  // FDA Drug Facts — 21 CFR 201.66 (OTC)
  FDA_DRUG_FACTS
  // AAFCO Pet
  AAFCO_PET_FOOD
  AAFCO_PET_TREAT
  // Canadian (V1.1 schema-ready)
  CANADIAN_VERTICAL
  CANADIAN_LINEAR
  CANADIAN_HORIZONTAL
  CANADIAN_AGGREGATE
  CANADIAN_100_GRAMS
  // USDA / Old FDA legacy
  USDA_OLD_FDA_VERTICAL
  USDA_OLD_FDA_TABULAR
  USDA_OLD_FDA_LINEAR
}

enum PanelOrientation {
  VERTICAL
  HORIZONTAL
  TABULAR
  LINEAR
}

model LabelFormatRule {
  format              LabelFormat
  labelingType        LabelingType
  cfrCitation         String
  minSurfaceAreaSqIn  Decimal          @db.Decimal(8, 3)
  minLabelWidthMm     Decimal          @db.Decimal(8, 2)
  minLabelHeightMm    Decimal          @db.Decimal(8, 2)
  minFontSizePt       Decimal          @db.Decimal(5, 2)
  minHeaderFontSizePt Decimal          @db.Decimal(5, 2)
  supportsMultiColumn Boolean          @default(false)
  supportsAggregate   Boolean          @default(false)
  supportsDualColumn  Boolean          @default(false)
  panelOrientation    PanelOrientation
  preferenceScore     Int              @default(50)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@id([format, labelingType])
  @@index([labelingType])
}

// =============================================================================
// RATE LIMITING (2026-06-05) — docs/SECURITY_ARCHITECTURE.md Tier 0.3
// =============================================================================
// DB-backed fixed-window counters (no Redis in the stack by design). One row
// per (scope, principal, window); key embeds the window index so an upsert +
// increment is the whole algorithm. Rows are garbage after expiresAt —
// checkRateLimit() in @ilaunchify/auth deletes expired rows opportunistically.

model RateLimitBucket {
  /// "<scope>:<principal>:<windowIndex>" e.g. "signup:ip:203.0.113.7:489211"
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// =============================================================================
// WEBHOOK DEDUPE (2026-06-05) — docs/SECURITY_ARCHITECTURE.md Tier 1.4
// =============================================================================
// Global provider-event-id claim table. handleStripeEvent() claims the event
// id before dispatch (releases the claim if the handler throws, so provider
// retries can reprocess). Complements — does not replace — the per-domain
// idempotency checks inside each handler.

model ProcessedWebhookEvent {
  /// Provider event id (e.g. Stripe "evt_...").
  id          String   @id
  source      String // "stripe"
  type        String // provider event type, for forensics
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// =============================================================================
// MANDATORY PHRASES (2026-06-05) — admin-managed catalog of required label phrases
// =============================================================================
// Allergen "Contains:" lines, DSHEA disclaimer, iron warning, statement of
// identity, directions, etc. labelingTypes mirrors CertificateType's slug-array
// pattern (NOT the LabelingType enum) so it ingests the locked vocab verbatim.

enum MandatoryPhraseCategory {
  ALLERGEN
  DISCLAIMER
  WARNING
  IDENTITY
  DIRECTIONS
  OTHER
  CLAIM
  SUSTAINABILITY
  MARKETING
}

enum PhraseRequirement {
  MANDATORY
  RECOMMENDED
}

model MandatoryPhrase {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique // stable key, e.g. "dshea-disclaimer"
  title                  String // admin label, e.g. "DSHEA Disclaimer"
  body                   String // the actual phrase text (can be long — bare String, NOT @db.Text)
  category               MandatoryPhraseCategory
  requirement            PhraseRequirement       @default(MANDATORY)
  labelingTypes          String[] // FOOD / DIETARY_SUPPLEMENT / OTC / PET_PRODUCT / BEVERAGE / COSMETIC (slug-style strings, NOT the LabelingType enum)
  cfrCitation            String? // e.g. "21 CFR 101.93(b)"
  appliesWhen            String? // trigger condition free-text, e.g. "iron-containing product"
  isActive               Boolean                 @default(true)
  displayOrder           Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  // Phrase engine (2026-06-05) — back-relations
  rules                  PhraseRule[]
  productTemplatePhrases ProductTemplatePhrase[]
  assignmentAudits       PhraseAssignmentAudit[]

  @@index([isActive, displayOrder])
}

// =============================================================================
// PER-PRODUCT LABEL-PHRASE SUGGESTION ENGINE (2026-06-05)
// =============================================================================
// Mirrors the NicheRule / ProductTemplateNiche / NicheAssignmentAudit system.
// PhraseRule = deterministic engine that suggests MandatoryPhrase rows for a
// ProductTemplate based on AND-of-conditions (OR within each condition's
// values). ProductTemplatePhrase = the resolved per-product assignment.
// PhraseAssignmentAudit = one row per assign/remove for forensic + admin UI.
// =============================================================================

enum PhraseRuleConditionKind {
  LABELING_TYPE // ProductTemplate.labelingType in values
  PRODUCT_CATEGORY // Product.category enum in values
  MARKETPLACE_CATEGORY // ProductTemplate.subcategory.categoryId in values
  ALLERGEN_PRESENT // any recipe ingredient allergenFlag in values
  BIOENGINEERED // any ingredient bioengineeredStatus=BIOENGINEERED (values ignored / ['true'])
  INGREDIENT_MATCH // any recipe ingredient name/labelDeclarationName matches a value (substring, lowercased)
  PACKING_TYPE // ProductTemplateVariant.packingType in values
  NUTRIENT_SOURCE // ProductTemplate.nutrientSource in values
  PRODUCT_FACT // a key in ProductTemplate.phraseFacts is true (values = fact keys)
}

enum PhraseAssignmentSource {
  AUTO_RULE
  MANUFACTURER
  ADMIN
}

model PhraseRule {
  id                String          @id @default(uuid())
  slug              String          @unique
  mandatoryPhraseId String
  description       String
  isActive          Boolean         @default(true)
  isLocked          Boolean         @default(false) // true = mandatory, manufacturer cannot remove
  weight            Int             @default(50) // 0..100
  conditions        Json // [{kind, values:[...]}] — AND across array, OR within values
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  mandatoryPhrase   MandatoryPhrase @relation(fields: [mandatoryPhraseId], references: [id], onDelete: Cascade)

  @@index([mandatoryPhraseId, isActive])
}

model ProductTemplatePhrase {
  productTemplateId String
  mandatoryPhraseId String
  requirement       PhraseRequirement      @default(MANDATORY)
  source            PhraseAssignmentSource @default(AUTO_RULE)
  acknowledgedAt    DateTime? // manufacturer acknowledged a locked mandatory phrase
  createdAt         DateTime               @default(now())
  productTemplate   ProductTemplate        @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  mandatoryPhrase   MandatoryPhrase        @relation(fields: [mandatoryPhraseId], references: [id], onDelete: Cascade)

  @@id([productTemplateId, mandatoryPhraseId])
  @@index([mandatoryPhraseId])
}

model PhraseAssignmentAudit {
  id                String                 @id @default(uuid())
  productTemplateId String
  mandatoryPhraseId String
  source            PhraseAssignmentSource
  ruleId            String? // present when source=AUTO_RULE
  actorUserId       String? // present when source=MANUFACTURER or ADMIN
  applied           Boolean // true=assigned, false=removed
  createdAt         DateTime               @default(now())
  productTemplate   ProductTemplate        @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  mandatoryPhrase   MandatoryPhrase        @relation(fields: [mandatoryPhraseId], references: [id], onDelete: Cascade)

  @@index([productTemplateId, createdAt])
  @@index([mandatoryPhraseId])
}

// -----------------------------------------------------------------------------
// SPOT COLOR CATALOG (Slice C9) — standalone PANTONE/spot reference catalog used
// for prepress soft-proofing. cmykApprox / rgbApprox are on-screen approximations
// only, never production color. Reuses the existing PmsBook enum.
// Spec: docs/builds/_V1_DIELINE_NORMALIZATION.md ("SpotColor" model)
// -----------------------------------------------------------------------------

enum SpotColorCategory {
  STANDARD // regular PANTONE PLUS Solid C/U/M
  NEON
  METALLIC
  PASTEL
  WHITE_INK // for printing on transparent/dark substrates
  SPOT_VARNISH // selective varnish channel
  FOIL // foil channel
}

model SpotColor {
  id          String            @id @default(uuid())
  pmsNumber   String // "185"
  bookVersion PmsBook // C / U / M etc.
  fullSpec    String            @unique // "PMS 185 C"
  cmykApprox  Json // {c,m,y,k} closest CMYK — soft-proof only
  rgbApprox   String // hex, on-screen rendering only
  category    SpotColorCategory @default(STANDARD)
  createdAt   DateTime          @default(now())

  @@index([category])
  @@index([pmsNumber])
}

// -----------------------------------------------------------------------------
// iLAUNCHIFY ACADEMY (Phase A) — two public learning sites (Creator + Partner)
// sharing one CMS + one three-level model (Home → Course → Lesson). Additive
// only. CockroachDB-safe: uuid ids, bare String for unbounded text (no @db.Text).
// Spec: docs/ACADEMY_SPEC.md §9. AcademyModule is dormant/optional in V1.
// -----------------------------------------------------------------------------

enum AcademyAudience {
  CREATOR
  PARTNER
}

enum AcademyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AcademyStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum AcademyLessonType {
