// =============================================================================
// AI Packaging Generator (docs/AI_PACKAGING_GENERATOR.md §9/§13). Additive.
// Soft FKs by id (mirrors the PaymentMethodRef pattern) — no User relation edits.
// Storage tracked in KILOBYTES (Int) to avoid BigInt; metering engine works in
// bytes and converts on write. NEEDS: pnpm db:push + db:generate on Mac.
// =============================================================================

enum AiGenScope {
  ADMIN_TEMPLATE // admin authors a premium template (unmetered)
  CREATOR // Builder/Agency creator generates their own design (metered)
}

enum AiGenStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

/// One generation run (a 4-concept draft cycle, and/or a finalize).
model AiDesignGeneration {
  id                 String       @id @default(uuid())
  scope              AiGenScope
  status             AiGenStatus  @default(QUEUED)
  authorUserId       String // soft FK → User
  productTemplateId  String? // soft FK → ProductTemplate
  dielineId          String? // soft FK → PackagingDieline (the INPUT)
  brandId            String? // soft FK → Brand
  /// Assembled PlanGenerationInput slots (product/brand/style/elements/colors/domain).
  promptJson         Json
  provider           String? // e.g. "fal-flux-controlnet"
  model              String?
  /// R2 keys of the variation images.
  variationKeys      String[]
  draftMegapixels    Decimal?     @db.Decimal(8, 2)
  finalizeMegapixels Decimal?     @db.Decimal(8, 2)
  creditsSpent       Int          @default(0)
  /// evaluateCompliance() report at generation time (legal reproducibility).
  complianceJson     Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([authorUserId])
  @@index([productTemplateId])
  @@index([status])
}

/// Per-creator, per-billing-period usage of the two metered levers.
model AiGenerationUsage {
  id              String   @id @default(uuid())
  userId          String // soft FK → User
  periodKey       String // e.g. "2026-06"
  draftCyclesUsed Int      @default(0)
  finalizeMpUsed  Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt

  @@unique([userId, periodKey])
}

/// Grants / top-ups of generation allowance (ledger; mirrors SampleCredit).
model AiGenerationCredit {
  id               String   @id @default(uuid())
  userId           String // soft FK → User
  kind             String // "GRANT" | "TOPUP" | "ADJUST"
  draftCyclesDelta Int      @default(0)
  finalizeMpDelta  Decimal  @default(0) @db.Decimal(10, 2)
  note             String?
  createdAt        DateTime @default(now())

  @@index([userId])
}

/// Cumulative stored-template storage per creator (KILOBYTES). Not period-reset.
model GenerationStorageUsage {
  userId         String   @id // soft FK → User
  kilobytesUsed  Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// =============================================================================
// Theme Studio — runtime design-token overrides (Phase 3b, 2026-06-25)
// =============================================================================
// Flat name→value overrides of the platform CSS variables (theme.css holds the
// defaults). The set of rows IS the active published theme; the admin Theme
// Studio edits them and they inject into each app's :root at request time.
// Names are allowlisted in code (packages/db/src/theme-tokens.ts). Versioning /
// multi-theme / scopes come later (THEME_MANAGEMENT_ARCHITECTURE.md Phase 4).
model ThemeTokenOverride {
  id        String   @id @default(uuid())
  /// 'global' applies to every app; per-app scopes (marketing / creator /
  /// partner / admin) override the global value WITHIN that app. Allowlisted.
  scope     String   @default("global")
  /// 'light' (default surface) or 'dark' (data-surface="dark" surfaces).
  mode      String   @default("light")
  /// CSS custom-property name WITHOUT the leading --, e.g. "font-scale",
  /// "radius-scale", "bg-hero". Allowlist-validated before write.
  name      String
  /// Raw CSS value, e.g. "1.15", "#FFFFFF", "255 46 99".
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([name, scope, mode])
}

/// Theme Studio working draft — a single row holding the in-progress
/// (unpublished) token map. Admin edits save here; Preview mode injects it;
/// Publish promotes it into ThemeTokenOverride (live). Singleton (id "draft").
model ThemeDraft {
  /// = scope ('global' | 'marketing' | 'creator' | 'partner' | 'admin').
  id        String   @id
  /// { tokenName: value } map of the draft overrides.
  tokens    Json
  updatedAt DateTime @updatedAt
}

/// Theme Studio version history — one snapshot per publish (per scope), for
/// one-click rollback. Ring-buffered to the last ~20 per scope in code.
model ThemeVersion {
  id        String   @id @default(uuid())
  scope     String   @default("global")
  mode      String   @default("light")
  /// Full editable-token map { name: value } that was published.
  tokens    Json
  note      String?
  /// Soft FK → User id of the admin who published.
  createdBy String?
  createdAt DateTime @default(now())

  @@index([scope, mode, createdAt])
}

/// Theme Studio custom presets — an admin-saved "mood board" (full token map)
/// that can be re-applied to any scope/mode. Built-in presets live in code.
model ThemePreset {
  id        String   @id @default(uuid())
  name      String
  /// { tokenName: value } map.
  tokens    Json
  createdBy String?
  createdAt DateTime @default(now())
}

/// Theme Studio platform logos (Phase D). One row per (kind, variant) slot:
/// kind = 'full' | 'mark'; variant = 'light' | 'dark'. Files live in R2.
model PlatformBrandAsset {
  id         String   @id @default(uuid())
  kind       String
  variant    String
  storageKey String
  /// Stable public URL when R2_PUBLIC_BASE_URL is configured; else null (sign on read).
  publicUrl  String?
  mimeType   String
  sizeBytes  Int
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([kind, variant])
}
