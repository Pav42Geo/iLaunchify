// =============================================================================
// iLaunchify v2 Prisma Schema — V1 Initial Release
// =============================================================================
//
// Ported and reorganized from FOD-reference/prisma/schema.prisma, with V1
// additions per the architecture decision docs in docs/.
//
// Reading order: enums → identity → marketplace identity → brand & products →
// ingredients & recipes → compliance → templates & design → assets → orders →
// payments → carts → consumers → market & rule packs.
//
// V1 STATUS: this is the initial schema. It compiles cleanly and supports
// every feature in the 12-week roadmap. Models marked "(V1.5+)" are
// declared so foreign keys exist but their UIs are not built in V1.
//
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS — IDENTITY & ROLES
// =============================================================================

enum UserRole {
  ADMIN
  CREATOR
  PARTNER
}

// Admin sub-role (RBAC) — only meaningful when UserRole = ADMIN; null elsewhere.
// Roles are presets; the capability bundles live in @ilaunchify/auth
// (ROLE_CAPABILITIES). See docs/ADMIN_RBAC.md. Existing admins are backfilled to
// SUPER_ADMIN so behavior is unchanged on rollout.
enum AdminRole {
  SUPPORT_AGENT
  SUPPORT_LEAD
  BILLING_ADMIN
  SUPER_ADMIN
}

// Admin RBAC (docs/ADMIN_RBAC.md P5) — super-admin-editable role→capability
// matrix. A row = "this AdminRole holds this capability". SUPER_ADMIN is NOT
// stored (computed as all-capabilities, non-editable). Non-super roles start
// EMPTY — the super admin grants capabilities explicitly in Roles & Permissions.
model RoleCapability {
  id         String    @id @default(uuid())
  role       AdminRole
  capability String
  createdAt  DateTime  @default(now())

  @@unique([role, capability])
  @@index([role])
}

// Admin team invites (docs/ADMIN_RBAC.md) — a super admin invites a NEW person
// by email + role. We store only the SHA-256 hash of the invite token; the raw
// token lives only in the invite link. The invitee signs up through the normal
// auth providers (we never create accounts or set passwords); on first sign-in
// they accept the invite, which sets User.role=ADMIN + adminRole.
model AdminInvite {
  id           String            @id @default(uuid())
  email        String
  adminRole    AdminRole
  tokenHash    String            @unique
  status       AdminInviteStatus @default(PENDING)
  invitedById  String
  invitedBy    User              @relation("AdminInvitesSentBy", fields: [invitedById], references: [id])
  acceptedById String?
  acceptedBy   User?             @relation("AdminInvitesAcceptedBy", fields: [acceptedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())

  @@index([email])
  @@index([status])
}

enum AdminInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Integrations control center (docs/INTEGRATIONS.md) — rotation tracking only.
// NO SECRET VALUES are ever stored here; the registry catalog lives in code and
// secret values live in the host env. This row just records WHEN an admin last
// rotated a key + an optional cadence override, so the UI can flag "due/overdue".
// `key` matches the integration key in apps/admin .../integration-registry.ts.
model IntegrationMeta {
  id              String    @id @default(uuid())
  key             String    @unique
  lastRotatedAt   DateTime?
  rotateEveryDays Int? // override the registry's suggested cadence
  notes           String?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

// Support RBAC (docs/ADMIN_RBAC.md P3) — agent-proposed refund/goodwill credit
// that a Lead/Billing admin approves before any money moves. Plain FK columns
// (orderId/ticketId/userIds) keep it additive — no back-relations on Order/etc.
enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SupportRefundRequest {
  id            String              @id @default(uuid())
  orderId       String
  ticketId      String?
  requestedById String
  amountCents   Int
  reason        String
  status        RefundRequestStatus @default(PENDING)
  decisionNote  String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([ticketId])
  @@index([orderId])
}

enum StripeAccountStatus {
  NONE
  PENDING
  RESTRICTED
  ACTIVE
  REJECTED
  DEAUTHORIZED
}

// =============================================================================
// ENUMS — PARTNER & SERVICE
// =============================================================================

// Partner lifecycle FSM. The original 6 values are Phase-A legacy and remain
// supported for existing rows; new code uses the 8 V1 values added per
// docs/PARTNER_ONBOARDING.md §3 activation FSM:
//
//   LEAD → IDENTITY_PENDING_REVIEW → IDENTITY_VERIFIED → OPS_PENDING_REVIEW
//        → OPERATIONALLY_CONFIGURED → ACTIVE → (INTEGRATION_ENHANCED)
//        + side states PAUSED / SUSPENDED / TERMINATED
//
// Legacy mapping (for back-compat when reading Phase-A rows):
//   DRAFT       → LEAD
//   INVITED     → LEAD
//   IN_PROGRESS → LEAD
//   UNDER_REVIEW → IDENTITY_PENDING_REVIEW
//   ACTIVE      → ACTIVE (same)
//   SUSPENDED   → SUSPENDED (same)
enum PartnerStatus {
  // V1 (canonical from 2026-05-24 forward)
  LEAD
  IDENTITY_PENDING_REVIEW
  IDENTITY_VERIFIED
  OPS_PENDING_REVIEW
  OPERATIONALLY_CONFIGURED
  ACTIVE
  INTEGRATION_ENHANCED
  PAUSED
  SUSPENDED
  TERMINATED
  // Phase-A legacy values (deprecated; preserved for back-compat with existing rows)
  DRAFT
  INVITED
  IN_PROGRESS
  UNDER_REVIEW
}

enum ServiceType {
  MANUFACTURING
  COPACKING
  LABEL_PRINTING
  WAREHOUSE // 3PL / fulfillment partner — holds creator inventory after production delivery
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum DisclosureLevel {
  FULL // "Manufactured by Acme Foods, San Jose, CA"
  CITY_STATE // "Manufactured for [Creator] in San Jose, CA"
  ANONYMOUS // "Manufactured for [Creator] in the USA"
}

