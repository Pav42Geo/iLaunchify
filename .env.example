# iLaunchify v2 — Environment template
# Copy to .env.local for local dev. NEVER commit .env or .env.local.

# ─── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
# apps/creator (the authenticated creator app — dashboard, design studio, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# apps/marketing (the public marketing site — home, marketplace, pricing,
# how-it-works, contact-sales). The iLaunchify logo on /signup + /login in
# apps/creator points here so guests land on the public home page.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3010

# ─── Analytics ─────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (gtag.js). PUBLIC (rendered in the
# browser) → NEXT_PUBLIC_ prefix. Shared across all four apps via the
# @ilaunchify/ui <GoogleAnalytics> component. Leave blank to disable GA
# (component renders nothing). Marketing gates it behind cookie consent
# (Consent Mode v2); authenticated apps load it under the account agreement.
NEXT_PUBLIC_GA_ID=

# ─── Cross-app URLs (REQUIRED in production) ───────────────────────────
# The four apps deep-link to each other (marketingUrl()/creatorUrl()/
# partnerUrl() helpers + admin "view in app" + notification email links).
# Each falls back to a localhost port if unset — so in PRODUCTION these MUST
# be set or links/emails will point at localhost and silently break.
#
# Public (client-exposed) URLs used by app-urls helpers + admin nav:
NEXT_PUBLIC_CREATOR_URL=http://localhost:3000   # apps/creator (port 3000)
NEXT_PUBLIC_PARTNER_URL=http://localhost:3002   # apps/partner (port 3002)
# Server-side hosts used by @ilaunchify/notifications email templates +
# admin partner actions (the absolute URLs put in outbound emails):
CREATOR_LOGIN_HOST=http://localhost:3000
PARTNER_LOGIN_HOST=http://localhost:3002
ADMIN_LOGIN_HOST=http://localhost:3003

# ─── Database (CockroachDB) ────────────────────────────────────────────
# Local Docker compose default:
DATABASE_URL=postgresql://root@localhost:26257/ilaunchify?sslmode=disable
# Cockroach Cloud Serverless example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.cockroachlabs.cloud:26257/ilaunchify?sslmode=verify-full

# ─── Auth.js v5 ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=

# ⚠️  LOCAL DEV ONLY — NEVER set this in any deployed environment (staging,
# preview, prod). It enables /api/dev/login, which forges a session cookie for
# ANY existing user by email. With it unset (the default), that route hard-403s
# everywhere. Set to 'true' ONLY in your local .env.local. (H5 A0)
ENABLE_DEV_LOGIN=

# Google OAuth (optional, recommended)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic-link provider (Resend) — also all Notification Center sends
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
# Resend inbound webhook signing secret (whsec_… — dashboard → Webhooks;
# endpoint: <creator app>/api/webhooks/resend). Powers admin Deliverability.
RESEND_WEBHOOK_SECRET=
# Signs one-click unsubscribe tokens (any long random string, e.g.
# `openssl rand -hex 32`). Footers omit the unsubscribe link until set.
NOTIFICATION_UNSUBSCRIBE_SECRET=
# Signs one-click feedback tokens (docs/FEEDBACK_MODULE.md — the vote rides in
# the link). Emails omit the feedback block until set.
FEEDBACK_TOKEN_SECRET=

# Bot defense — Cloudflare Turnstile (docs/AUTH_ENTRANCE_SECURITY_2026-07.md §3/§4,
# H5 A4). On the public signup form + /login. TWO keys from the Turnstile dashboard:
#   • Site key = PUBLIC (rendered in the browser widget) → NEXT_PUBLIC_ prefix.
#   • Secret key = SERVER-ONLY (verifies the token server-side) → bare name, never NEXT_PUBLIC.
# Set both in .env.local for local dev AND in the host env for every deployed app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Compliance service (Python/FastAPI) ───────────────────────────────
COMPLIANCE_SERVICE_URL=http://localhost:8000

# ─── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect (manufacturer + print provider payouts)
STRIPE_CONNECT_CLIENT_ID=

# ─── Object storage (Cloudflare R2) ─────────────────────────────────────
# Account ID is shown in the Cloudflare dashboard URL after /accounts/.
# API tokens are created under R2 > Manage R2 API Tokens (give read+write+list
# scope on a single bucket). Bucket name is exactly the bucket you created.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ilaunchify-uploads
# Public base URL for R2 reads (custom domain or r2.dev hostname). REQUIRED for
# Design Studio image uploads + cert PNG badges on the marketplace (those store
# `${R2_PUBLIC_BASE_URL}/${key}` on the Asset). Without it, those public-image
# features fall back to/skip — other reads use short-lived signed URLs.
# (The legacy name R2_PUBLIC_URL is also accepted by the code for compatibility.)
R2_PUBLIC_BASE_URL=

# ─── Scheduled jobs (cron) ─────────────────────────────────────────────
# Shared secret protecting /api/cron/* routes. Vercel Cron passes this
# automatically via Authorization header. For external schedulers, send
# 'Authorization: Bearer $CRON_SECRET'.
CRON_SECRET=

# ─── Observability ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ilaunchify
# @ilaunchify/logger minimum level: debug | info | warn | error.
# Defaults to 'debug' in dev, 'info' in production.
LOG_LEVEL=
# Sentry (P6). Server-side error capture is DSN-GUARDED: leave SENTRY_DSN blank
# to disable entirely (no init, nothing sent) — the structured JSON request-error
# log still runs regardless. Set the DSN in production to turn Sentry on. The
# AUTH_TOKEN/ORG/PROJECT are only needed if/when source-map upload is added
# (withSentryConfig — a follow-up). One Sentry project; events are tagged by app.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Redis (queue + cache) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI (Mode 2 recipe parser — @ilaunchify/ai) ────────────────────────
# Anthropic API key for the partner product builder's AI recipe parser.
# Without it, parseRecipeFromText returns an error ("ANTHROPIC_API_KEY not
# configured"). Set in .env.local for dev and in production env.
ANTHROPIC_API_KEY=
