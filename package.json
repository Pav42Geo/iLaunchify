{
  "name": "ilaunchify",
  "version": "2.0.0",
  "private": true,
  "description": "iLaunchify v2 \u2014 two-sided marketplace for creators, manufacturers, and print providers in US-compliant supplements + food & beverage.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm check:invariants:strict",
    "check:colors": "node scripts/check-no-raw-tailwind-colors.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:invariants:strict": "node scripts/check-invariants.mjs --strict",
    "manifest": "node scripts/build-flow-manifest.mjs",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @ilaunchify/db generate",
    "db:push": "pnpm --filter @ilaunchify/db push",
    "db:migrate": "pnpm --filter @ilaunchify/db migrate",
    "db:studio": "pnpm --filter @ilaunchify/db studio",
    "db:seed": "pnpm --filter @ilaunchify/db seed",
    "compliance:dev": "cd services/compliance && uvicorn app.main:app --reload",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "prepare": "husky",
    "pp0:delta": "node scripts/pp0-delta-report.mjs",
    "copack:delta": "node scripts/copack-delta-report.mjs",
    "mode:delta": "node scripts/mode-band-delta-report.mjs",
    "c22:report": "node scripts/c22-route-report.mjs",
    "seed:mode-bands": "node scripts/seed-mode-bands.mjs",
    "ondemand:why": "pnpm --filter @ilaunchify/db exec dotenv -e ../../.env.local -- tsx ../orders/scripts/on-demand-why.ts",
    "inventory:race": "pnpm --filter @ilaunchify/db exec dotenv -e ../../.env.local -- tsx ../orders/scripts/verify-inventory-race.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "dotenv-cli": "^7.4.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "esbuild": "^0.28.1"
  }
}
