{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@ilaunchify/db": ["./packages/db/src"],
      "@ilaunchify/db/*": ["./packages/db/src/*"],
      "@ilaunchify/ui": ["./packages/ui/src"],
      "@ilaunchify/ui/*": ["./packages/ui/src/*"],
      "@ilaunchify/types": ["./packages/types/src"],
      "@ilaunchify/auth": ["./packages/auth/src"],
      "@ilaunchify/auth/*": ["./packages/auth/src/*"],
      "@ilaunchify/audit": ["./packages/audit/src"],
      "@ilaunchify/notifications": ["./packages/notifications/src"],
      "@ilaunchify/orders": ["./packages/orders/src"],
      "@ilaunchify/payments": ["./packages/payments/src"],
      "@ilaunchify/storage": ["./packages/storage/src"],
      "@ilaunchify/compliance-client": ["./packages/compliance-client/src"],
      "@ilaunchify/marketplace": ["./packages/marketplace/src"],
      "@ilaunchify/academy": ["./packages/academy/src"],
      "@ilaunchify/nutrition": ["./packages/nutrition/src"],
      "@ilaunchify/support": ["./packages/support/src"],
      "@ilaunchify/support/*": ["./packages/support/src/*"],
      "@ilaunchify/ai-design": ["./packages/ai-design/src"],
      "@ilaunchify/imagegen": ["./packages/imagegen/src"],
      "@ilaunchify/channels": ["./packages/channels/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".next", "dist", "FOD-reference", "**/.next/**"]
}
